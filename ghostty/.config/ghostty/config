
# Dynamic theme colors
background-blur=true
# Font
font-family = "JetBrains Mono Nerd Font"
font-style = Regular
font-size = 14

# Window
window-theme = ghostty

confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = true
shell-integration-features = no-cursor, ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

shell-integration = zsh

quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m
keybind = shift+enter=text:\x1b\r
# Let ctrl+shift+enter reach Claude Code (send now) instead of zooming splits
keybind = ctrl+shift+enter=unbind
# ctrl + ^ makes the font larger (ctrl + - makes it smaller already). On the
# Swiss layout ^ is a dead key that gives no character, so the default
# ctrl+= never matches: bound by the physical key instead (`equal` is where
# = sits on a US keyboard, the key left of backspace).
keybind = ctrl+equal=increase_font_size:1

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95
theme = noctalia

# Copy selection to the system clipboard too, not only the primary selection
copy-on-select = clipboard
right-click-action = paste

# Theme-specific settings (opacity, padding, shader): variants/<name>.conf,
# linked as ~/.config/ghostty/theme.conf by `dotfiles-theme <name>`. Loaded last, so it wins.
config-file = ?~/.config/ghostty/theme.conf
