#!/usr/bin/env bash
#
# Build the Hyprland plugins this config loads (plugins.lua) and install them
# into ~/.local/share/hyprland/plugins: the third-party ones from pinned
# commits, our own from plugin-local/<name> (a Makefile that takes BUILD=).
# hyprpm is not shipped by Arch's hyprland package, so this stands in for it.
#
# Plugins are compiled against Hyprland's internal headers: rerun this after
# every Hyprland update. plugins.lua only loads them while .built-for (the
# version.h they were compiled against) matches the installed Hyprland, so a
# stale build is skipped quietly instead of failing with a red notification.
# A plugin that failed to load stays mapped in the running compositor, so after
# such a failure the rebuilt one takes effect only once Hyprland restarts.
#
# Usage: hypr-plugins            build and install all, then reload Hyprland
set -euo pipefail

# name  repository  commit  library (review the diff before bumping a pin:
# plugins run inside the compositor). Pin a commit from the plugin's branch for
# the installed Hyprland version where it keeps one (hyprglass: hyprland-X.Y).
readonly PLUGINS=(
  "confined-floats https://github.com/mennemann/hyprland-confined-floats 861f1220a5a37c13284ce5d24a3cf6c046fe2d38 build/libconfined-floats.so"
  "hyprglass https://github.com/hyprnux/hyprglass dc00c628623e5e504b363e26dd489ee766d2fa12 hyprglass.so"
)
readonly SRC="${XDG_DATA_HOME:-$HOME/.local/share}/hyprland/plugin-src"
readonly OUT="${XDG_DATA_HOME:-$HOME/.local/share}/hyprland/plugins"
readonly PATCHES="${XDG_DATA_HOME:-$HOME/.local/share}/hyprland/plugin-patches"
readonly LOCAL="${XDG_DATA_HOME:-$HOME/.local/share}/hyprland/plugin-local"

# Replace atomically: Hyprland may have the old file mapped.
install_lib() {
  local lib="${1##*/}"
  install -m 755 "$1" "$OUT/.$lib.new"
  mv -f "$OUT/.$lib.new" "$OUT/$lib"
  echo "   installed $OUT/$lib"
}

for tool in git cmake pkg-config; do
  command -v "$tool" &>/dev/null || { echo "hypr-plugins: missing $tool" >&2; exit 1; }
done
pkg-config --exists hyprland || { echo "hypr-plugins: Hyprland headers not found (pkg-config hyprland)" >&2; exit 1; }

mkdir -p "$SRC" "$OUT"
echo "Hyprland $(pkg-config --modversion hyprland)"
for entry in "${PLUGINS[@]}"; do
  read -r name repo commit built <<<"$entry"
  dir="$SRC/$name"
  echo "── $name @ ${commit:0:12}"
  [[ -d "$dir/.git" ]] || git clone -q "$repo" "$dir"
  git -C "$dir" fetch -q origin
  # Start from the pin exactly, then apply our patches (plugin-patches/<name>).
  git -C "$dir" reset -q --hard
  git -C "$dir" -c advice.detachedHead=false checkout -q "$commit"
  for patch in "$PATCHES/$name"/*.patch; do
    [[ -e "$patch" ]] || continue
    git -C "$dir" apply "$patch"
    echo "   patched: ${patch##*/}"
  done
  if [[ -f "$dir/CMakeLists.txt" ]]; then
    # --fresh: pkg_check_modules caches the dependency versions that go into
    # the plugin's ABI hash, so a reused cache bakes in the old ones.
    cmake --fresh -S "$dir" -B "$dir/build" -DCMAKE_BUILD_TYPE=Release >/dev/null
    cmake --build "$dir/build" -j"$(nproc)"
  else
    # Plain Makefile; clean first, objects do not track Hyprland header changes.
    make -C "$dir" clean >/dev/null
    make -C "$dir" -j"$(nproc)"
  fi
  install_lib "$dir/$built"
done
for dir in "$LOCAL"/*/; do
  [[ -f "$dir/Makefile" ]] || continue
  name="${dir%/}"
  name="${name##*/}"
  echo "── $name (local)"
  # Built outside the source, which is the dotfiles repo; from nothing,
  # objects do not track Hyprland header changes.
  build="$SRC/$name.build"
  rm -rf "$build"
  make -C "$dir" BUILD="$build" -j"$(nproc)"
  install_lib "$build/$name.so"
done
# The same path plugins.lua compares against.
cp /usr/include/hyprland/src/version.h "$OUT/.built-for"

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  hyprctl reload >/dev/null && echo "Hyprland reloaded"
fi
