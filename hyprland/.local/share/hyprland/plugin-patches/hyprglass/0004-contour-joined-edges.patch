+void CGlassLayerSurface::restoreBackdropUnderJoinedLayer(PHLMONITOR monitor, const CBox& layerBox, int downscale,
+                                                         const SP<Render::IFramebuffer>& source) {
+    int         edge  = 0;
+    const auto* other = continuedLayer(monitor, layerBox, edge);
+    if (!other)
+        return;
+
+    // everything on the other layer's side of the seam, as far as this sample reaches
+    const CBox&  otherBox = other->m_sampledBox;
+    const double reach    = GlassRenderer::SAMPLE_PADDING_PX;
+    const CBox   region   = edge == Contour::EDGE_TOP ?
+        CBox{layerBox.x - reach, layerBox.y - reach, layerBox.w + 2.0 * reach, otherBox.y + otherBox.h - (layerBox.y - reach)} :
+        CBox{layerBox.x - reach, otherBox.y, layerBox.w + 2.0 * reach, layerBox.y + layerBox.h + reach - otherBox.y};
+    GlassRenderer::copySampleRegion(m_sampleFramebuffer, layerBox, downscale, other->m_sampleFramebuffer, otherBox, other->m_sampledDownscale, region,
+                                    source);
