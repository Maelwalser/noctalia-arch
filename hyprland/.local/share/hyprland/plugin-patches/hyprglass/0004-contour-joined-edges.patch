+    int         edge  = 0;
+    const auto* other = continuedLayer(monitor, layerBox, edge);
+    if (!other || layerBox.w <= 0.0 || layerBox.h <= 0.0)
+        return;
+
+    // the rows the two boxes share are the other layer's
+    const CBox& otherBox = other->m_sampledBox;
+    if (edge == Contour::EDGE_TOP) {
+        maskInfo.skipTopPx     = static_cast<float>(std::max(otherBox.y + otherBox.h - layerBox.y, 0.0));
