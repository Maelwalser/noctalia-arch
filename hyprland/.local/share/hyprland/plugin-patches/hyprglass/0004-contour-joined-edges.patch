+bool CGlassLayerSurface::openFrost(Render::CRenderContext& ctx, PHLMONITOR monitor, const SP<Render::IFramebuffer>& target,
+                                   const SResolveContext& resolveContext, GlassRenderer::SFrostInput& frostInput) {
+    const auto layerSurface = m_layerSurface.lock();
+    if (!layerSurface || !monitor)
+        return false;
+
+    const auto& state   = *g_pGlobalState;
+    const auto  frostIt = state.layerNamespaceOpenFrost.find(layerSurface->m_namespace);
+    const auto  openIt  = state.layerNamespaceMaskOpen.find(layerSurface->m_namespace);
+    const float setting = frostIt != state.layerNamespaceOpenFrost.end() ? std::min(frostIt->second, Frost::BLUR_MAX) : 0.0f;
+    const int   edges   = openIt != state.layerNamespaceMaskOpen.end() ? openIt->second : 0;
+    if (setting <= 0.0f || (edges & (Contour::EDGE_TOP | Contour::EDGE_BOTTOM)) == 0) {
+        m_frost.reset();
+        return false;
+    }
+
+    // the copy is the sample at half its size: the radius is in its pixels
+    const float blurStrength = resolvePresetFloat(resolveContext, &SPresetValues::blurStrength, &SOverridableConfig::blurStrength);
+    const int   downscale    = blurStrength >= GlassRenderer::BLUR_DOWNSCALE_THRESHOLD ? GlassRenderer::BLUR_DOWNSCALE_MAX : 1;
+    const float radius       = setting * 12.0f / (2.0f * downscale);
+    if (m_frost.needsBuild(m_sampleFramebuffer, radius)) {
+        float frostRadius     = radius;
+        int   frostIterations = Frost::BLUR_ITERATIONS;
+        if (resolveContext.config.blurFold && **resolveContext.config.blurFold) {
+            const GlassRenderer::SFoldedBlur folded = GlassRenderer::foldBlurPasses(frostRadius, frostIterations);
+            frostRadius     = folded.radius;
+            frostIterations = folded.iterations;
+        }
+        if (GlassRenderer::buildFrostCopy(ctx, m_sampleFramebuffer, m_frost.copy(), m_frost.temporary(), frostRadius, frostIterations, target)) {
+            m_frost.built(radius);
+            Diagnostics::recordFrostRebuild(monitor->m_id);
+        }
+    }
+    if (m_frost.needsBuild(m_sampleFramebuffer, radius))
+        return false;
+
+    const float scale     = monitor->m_scale > 0.0f ? monitor->m_scale : 1.0f;
+    const auto  featherIt = state.layerNamespaceOpenFeather.find(layerSurface->m_namespace);
+    // at least a pixel: 0 would frost right up to the edge
+    const float ramp      = std::max((featherIt != state.layerNamespaceOpenFeather.end() ? featherIt->second : OPEN_FEATHER_DEFAULT) * scale, 1.0f);
+    frostInput = {m_frost.copy(), 1.0f, (edges & Contour::EDGE_TOP) ? ramp : 0.0f, (edges & Contour::EDGE_BOTTOM) ? ramp : 0.0f};
+    return true;
+}
