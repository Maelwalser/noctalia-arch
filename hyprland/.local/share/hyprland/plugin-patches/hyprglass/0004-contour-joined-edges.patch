+CGlassLayerSurface* CGlassLayerSurface::continuedLayer(PHLMONITOR monitor, const CBox& layerBox, int& edge) const {
+    edge = 0;
+    const auto layerSurface = m_layerSurface.lock();
+    if (!layerSurface || !monitor)
+        return nullptr;
+
+    const auto& state  = *g_pGlobalState;
+    const auto  openIt = state.layerNamespaceMaskOpen.find(layerSurface->m_namespace);
+    if (openIt == state.layerNamespaceMaskOpen.end())
+        return nullptr;
+
+    const double tolerance = 3.0 * (monitor->m_scale > 0.0f ? monitor->m_scale : 1.0f);
+    for (const auto& [raw, other] : state.layerSurfaces) {
+        // its sample has to be the plain backdrop of its whole box
+        if (!other || other.get() == this || !other->m_hasCachedSample || other->m_cachedFromSnapshot || other->m_cachedRegionSampleBox ||
+            !other->m_sampleFramebuffer || !other->m_sampleFramebuffer->getTexture())
+            continue;
+        const auto otherSurface = other->getLayerSurface();
+        if (!otherSurface || !otherSurface->mapped() || otherSurface->m_monitor != layerSurface->m_monitor)
+            continue;
+        const auto joinIt = state.layerNamespaceMaskJoin.find(otherSurface->m_namespace);
+        if (joinIt == state.layerNamespaceMaskJoin.end() || joinIt->second != layerSurface->m_namespace)
+            continue;
+
+        const CBox& otherBox = other->m_sampledBox;
+        if ((openIt->second & Contour::EDGE_TOP) && std::abs(otherBox.y + otherBox.h - layerBox.y) <= tolerance)
+            edge = Contour::EDGE_TOP;
+        else if ((openIt->second & Contour::EDGE_BOTTOM) && std::abs(otherBox.y - (layerBox.y + layerBox.h)) <= tolerance)
+            edge = Contour::EDGE_BOTTOM;
+        else
+            continue;
+        return other.get();
+    }
+    return nullptr;
