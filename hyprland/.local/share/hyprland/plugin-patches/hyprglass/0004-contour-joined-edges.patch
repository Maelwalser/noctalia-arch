+    // only what both samples hold
+    const double x0 = std::max({region.x, static_cast<double>(map.srcX0), static_cast<double>(otherMap.srcX0)});
+    const double y0 = std::max({region.y, static_cast<double>(map.srcY0), static_cast<double>(otherMap.srcY0)});
+    const double x1 = std::min({region.x + region.w, static_cast<double>(map.srcX1), static_cast<double>(otherMap.srcX1)});
+    const double y1 = std::min({region.y + region.h, static_cast<double>(map.srcY1), static_cast<double>(otherMap.srcY1)});
+    if (x1 <= x0 || y1 <= y0)
+        return;
+
+    const CBox shared{x0, y0, x1 - x0, y1 - y0};
+    const CBox from = otherMap.toSample(shared);
+    const CBox to   = map.toSample(shared);
