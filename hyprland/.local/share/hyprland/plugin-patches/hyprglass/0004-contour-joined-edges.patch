+void copySampleRegion(const SP<Render::IFramebuffer>& sample, const CBox& box, int downscale, const SP<Render::IFramebuffer>& otherSample,
+                      const CBox& otherBox, int otherDownscale, const CBox& region, const SP<Render::IFramebuffer>& sourceFramebuffer) {
+    if (!sample || !otherSample || !sourceFramebuffer || sample == otherSample || !otherSample->isAllocated())
