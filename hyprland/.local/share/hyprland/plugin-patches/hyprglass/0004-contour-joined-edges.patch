+        const size_t end  = std::min(value.find_first_of(" ,", start), value.size());
+        const auto   word = value.substr(start, end - start);
+        if (word == "top")         edges |= Contour::EDGE_TOP;
+        else if (word == "bottom") edges |= Contour::EDGE_BOTTOM;
+        else if (word == "left")   edges |= Contour::EDGE_LEFT;
+        else if (word == "right")  edges |= Contour::EDGE_RIGHT;
+        else return std::nullopt;
+        at = end;
+    }
