     // the foreign framebuffer into this decoration's persistent background cache.
-    if (RenderGuards::isForeignRender(ctx))
+    // (A modifier alone is not that here: see isForeignTarget().)
+    if (RenderGuards::isForeignTarget(ctx))
         return;
 
     auto& shaderManager = g_pGlobalState->shaderManager;
@@ -506,7 +507,24 @@ void CGlassDecoration::renderPass(Render::CRenderContext& ctx, PHLMONITOR monito
     if (monitor)
         Diagnostics::recordWindowGlassDraw(monitor->m_id);
 
-    const CBox windowBox = *optBox;
+    // A view that draws the windows somewhere else and smaller (a zoomed-out
+    // view of the workspaces) says so through the renderer's modifier, which
+    // every Hyprland element is drawn through. The glass samples and draws in
+    // framebuffer pixels of its own, so it follows by hand: the pane lies
+    // where the window is drawn, not where the window is.
+    CBox  windowBox      = *optBox;
+    const bool modified  = ctx.m_data.renderModif.enabled && !ctx.m_data.renderModif.modifs.empty();
+    if (modified) {
+        ctx.m_data.renderModif.applyToBox(windowBox);
+        windowBox.round();
+        if (windowBox.w < 1.0 || windowBox.h < 1.0)
+            return;
+    }
+    // What lies behind the pane changes with the place it is drawn at, and
+    // nothing the cache watches (geometry, scene generation) knows of that.
+    const bool redrawnElsewhere = modified != m_lastDrawModified || (modified && windowBox != m_lastDrawBox);
+    m_lastDrawModified          = modified;
+    m_lastDrawBox               = windowBox;
 
     // Every non-discarded frame needs this regardless of cache hit/miss: a
     // cache-hit frame has no sampleBackground()/blurBackground() call for it
@@ -522,6 +540,9 @@ void CGlassDecoration::renderPass(Render::CRenderContext& ctx, PHLMONITOR monito
     // Hyprland renders internal-fullscreen windows unrounded (dontRound), we need to
     // match, or the glass would show rounded gaps at the screen corners
     const bool fsUnrounded = Fullscreen::controller()->getFullscreenModes(window).internal == Fullscreen::FSMODE_FULLSCREEN;
+    // Not scaled with a render modifier: Hyprland draws the window's border
+    // and clips its surface with the full radius there too, and a pane with
+    // a smaller one shows its corners outside the border's curve.
     float cornerRadius  = fsUnrounded ? 0.0f : window->presentation().rounding() * monitorScale;
     float roundingPower = window->presentation().roundingPower();
 
@@ -541,7 +562,10 @@ void CGlassDecoration::renderPass(Render::CRenderContext& ctx, PHLMONITOR monito
     // more translucent — revealing more glass — and shouldn't wash out the
     // glass pane itself. Rebuild the fade-only alpha from its components.
