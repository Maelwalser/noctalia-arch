--- a/src/RenderGuards.hpp
+++ b/src/RenderGuards.hpp
@@ -18,15 +18,25 @@ namespace RenderGuards {
 // currentFB) into an isolated buffer, so only m_renderingCapture identifies it;
 // glassing it would write our per-window caches and the x-ray snapshot from
 // content the live frame must not inherit.
-[[nodiscard]] inline bool isForeignRender(Render::CRenderContext& ctx) {
+// isForeignTarget() is the part of it that holds for a modifier too: a view
+// that draws the windows of the monitor's own frame smaller and elsewhere (a
+// zoomed-out view of the workspaces) renders into the frame itself, and its
+// windows keep their glass (CGlassDecoration::renderPass() follows the modifier).
+[[nodiscard]] inline bool isForeignTarget(Render::CRenderContext& ctx) {
     if (ctx.m_renderingCapture)
         return true;
 
     const auto& renderData = ctx.m_data;
 
-    if (renderData.mainFB && renderData.currentFB != renderData.mainFB)
+    return renderData.mainFB && renderData.currentFB != renderData.mainFB;
+}
+
+[[nodiscard]] inline bool isForeignRender(Render::CRenderContext& ctx) {
+    if (isForeignTarget(ctx))
         return true;
 
+    const auto& renderData = ctx.m_data;
+
     return renderData.renderModif.enabled && !renderData.renderModif.modifs.empty();
 }
 
