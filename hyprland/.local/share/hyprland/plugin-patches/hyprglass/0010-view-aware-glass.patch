+// Under a render modifier (a view that draws the windows somewhere else and
+// smaller) the pane is not where the window is: damage at the window's own box
+// redraws a part of the monitor the pane is not in, at the window's full size,
+// and misses the pane. The monitor is damaged where the pane was last drawn.
+bool CGlassDecoration::damageWhereDrawn(float padding) const {
+    if (!m_lastDrawModified)
+        return false;
+
+    // The box is where a render modifier last put the pane. It holds only
+    // while the workspace is still drawn that way (a zoomed view forces its
+    // rows to render); a window not drawn since keeps the flag.
+    const auto window  = m_window.lock();
+    const auto monitor = window ? window->m_monitor.lock() : nullptr;
+    if (!monitor || !window->m_workspace || !window->m_workspace->m_forceRendering)
+        return false;
+
+    monitor->addDamage(m_lastDrawBox.copy().expand(padding));
+    return true;
+}
+
 void CGlassDecoration::damageFocusLight() {
+    if (damageWhereDrawn(0.0f))
+        return;
     damageGlassBox(m_window.lock());
 }
 
 void CGlassDecoration::damageFrost() {
+    if (damageWhereDrawn(0.0f))
+        return;
     damageGlassBox(m_window.lock());
 }
 
