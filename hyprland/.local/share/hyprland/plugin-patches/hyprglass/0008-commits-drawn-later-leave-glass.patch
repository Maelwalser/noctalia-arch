diff --git a/src/GlassDecoration.cpp b/src/GlassDecoration.cpp
index c0b1675..f904502 100644
--- a/src/GlassDecoration.cpp
+++ b/src/GlassDecoration.cpp
@@ -760,10 +760,23 @@ void CGlassDecoration::damageEntire() {
     // other windows) in the sampling margin too. Without this, the scissored
     // render pass leaves stale previous-frame content in the padding area,
     // causing noise artifacts.
-    const auto box = WindowGeometry::computePaddedGlobalBox(window, GlassRenderer::SAMPLE_PADDING_PX);
+    auto box = WindowGeometry::computePaddedGlobalBox(window, GlassRenderer::SAMPLE_PADDING_PX);
     if (!box)
         return;
 
+    // A window that lies wholly on its monitor samples that monitor only:
+    // the margin past the edge is the next monitor's, which would draw a
+    // frame for each of these. One that spans two is drawn on both.
+    const auto monitor = window->m_monitor.lock();
+    const auto ownBox  = WindowGeometry::computePaddedGlobalBox(window, 0.0f);
+    if (monitor && ownBox) {
+        const CBox monitorBox{monitor->m_position, monitor->m_size};
+        if (ownBox->intersection(monitorBox) == *ownBox)
+            box = box->intersection(monitorBox);
+    }
+    if (box->empty())
+        return;
+
     g_pHyprRenderer->damageBox(*box);
 }
 
