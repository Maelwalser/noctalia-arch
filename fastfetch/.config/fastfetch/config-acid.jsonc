{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // ACID//HUD emblem, rendered by `hud-build` (Ghostty draws it via the
    // kitty graphics protocol). logo.txt is the old text logo.
    "logo": {
        "source": "~/.local/share/hud/fastfetch-logo.png",
        "type": "kitty-direct",
        "width": 22,
        "height": 10,
        "padding": {
            "top": 2,
            "right": 4,
            "left": 2
        }
    },
    "display": {
        "separator": "  ▸ ",
        "color": {
            "keys": "magenta",
            "title": "white",
            "output": "white"
        },
        "constants": [
            "▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▱▱▱▱▱▱▱▱▱▱▱▱▱▱"
        ]
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "magenta",
                "at": "90",
                "host": "white"
            },
            "format": "{#keys}{user-name}//{host-name}{#}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m{$1}\u001b[0m"
        },
        {
            "type": "os",
            "key": "▍OS  "
        },
        {
            "type": "kernel",
            "key": "▍KRN "
        },
        {
            "type": "uptime",
            "key": "▍UP  "
        },
        {
            "type": "packages",
            "key": "▍PKG ",
            "format": "{pacman}"
        },
        {
            "type": "shell",
            "key": "▍SH  "
        },
        {
            "type": "wm",
            "key": "▍WM  ",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "de",
            "key": "▍DE  "
        },
        {
            "type": "terminal",
            "key": "▍TRM "
        },
        {
            "type": "terminalfont",
            "key": "▍FNT ",
            // fastfetch reads the size from Ghostty's main config (14) and
            // does not follow its config-file include, where ACID//HUD sets
            // 12 (ghostty/variants/acid.conf): keep the two in step.
            "format": "{name} (12pt)"
        },
        {
            "type": "command",
            "key": "▍EDT ",
            "shell": "/bin/sh",
            "text": "echo \"${EDITOR:-not set}\""
        },
        {
            "type": "custom",
            "format": "\u001b[90m{$1}\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "▍CPU ",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "▍iGPU",
            "format": "{name}",
            "hideType": "discrete"
        },
        {
            "type": "gpu",
            "key": "▍dGPU",
            "format": "{name}",
            "hideType": "integrated"
        },
        {
            "type": "memory",
            "key": "▍MEM "
        },
        {
            "type": "disk",
            "key": "▍DSK ",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 4,
            "symbol": "circle"
        }
    ]
}
