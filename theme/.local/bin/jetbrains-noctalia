#!/usr/bin/env python3
"""Pack the rendered Noctalia theme into a JetBrains theme plugin.

A JetBrains IDE (Android Studio here) only takes a UI theme from a plugin: a
jar holding a plugin.xml, the theme's JSON and its editor colour scheme.
Noctalia renders the last two from templates/jetbrains.theme.json and
templates/jetbrains-scheme.xml into ~/.local/share/noctalia-jetbrains; this
zips them into a jar and puts it into the plugin folder of every installed
IDE version. Noctalia runs it on every palette change; it is safe to run by
hand. Pick the theme once under Settings > Appearance > Theme: Noctalia. A
palette change shows after the IDE is restarted.
"""
import os
import sys
import zipfile
from pathlib import Path

HOME = Path.home()
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
SOURCE = DATA / "noctalia-jetbrains"
THEME = SOURCE / "noctalia.theme.json"
SCHEME = SOURCE / "noctalia.xml"
PLUGIN = "noctalia-theme"
# <vendor dir>/<product><version>: where each IDE keeps its user plugins.
IDE_GLOBS = ("Google/AndroidStudio*", "JetBrains/*")
PLUGIN_XML = """<idea-plugin>
  <id>local.noctalia.theme</id>
  <name>Noctalia Theme</name>
  <version>1.0.0</version>
  <vendor>dotfiles</vendor>
  <description>The desktop palette as an IDE theme. Generated by jetbrains-noctalia; changes are overwritten.</description>
  <idea-version since-build="252"/>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNamespace="com.intellij">
    <themeProvider id="local.noctalia.theme" path="/noctalia.theme.json"/>
  </extensions>
</idea-plugin>
"""


def build(jar: Path) -> None:
    jar.parent.mkdir(parents=True, exist_ok=True)
    tmp = jar.with_suffix(".jar.tmp")
    with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("META-INF/plugin.xml", PLUGIN_XML)
        z.write(THEME, "noctalia.theme.json")
        z.write(SCHEME, "noctalia.xml")
    tmp.replace(jar)


def main() -> int:
    if not (THEME.is_file() and SCHEME.is_file()):
        # Noctalia runs this after each of the two templates; the first run of
        # a fresh setup comes before the second file exists.
        print(f"jetbrains-noctalia: waiting for {THEME.name} and {SCHEME.name} in {SOURCE}")
        return 0
    ides = [d for glob in IDE_GLOBS for d in DATA.glob(glob) if d.is_dir()]
    if not ides:
        print("jetbrains-noctalia: no JetBrains IDE data folder found; nothing to do")
        return 0
    for ide in ides:
        build(ide / PLUGIN / "lib" / f"{PLUGIN}.jar")
        print(f"jetbrains-noctalia: {ide.name}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
