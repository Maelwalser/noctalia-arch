#!/usr/bin/env bash
#
# Switch the whole desktop between the dotfiles themes:
#   acid     ACID//HUD: acid-on-black HUD, animated overlay, HUD bar and lockscreen
#   classic  the look from before ACID//HUD (v4 bar, round corners, eyes palette)
#
# Usage:
#   dotfiles-theme              print the active theme
#   dotfiles-theme <name>       switch to <name> and reload what is running
#   dotfiles-theme --list       list the themes
#
# The choice lives in ${XDG_STATE_HOME:-~/.local/state}/dotfiles/theme. Hyprland,
# zsh, fastfetch, Neovim and the Claude Code status line read it directly;
# Claude Code's settings.json gets its theme keys rewritten. Apps without
# conditionals get a `theme.*` link to the committed variant (Noctalia,
# Ghostty, tmux, sioyek, eza, GTK4, Vivaldi). Obsidian gets the ACID HUD theme linked
# into every vault and selected in appearance.json. Noctalia's GUI state
# (palette, wallpapers, lockscreen layout) beats its config, so each theme
# keeps its own copy of that state.
set -euo pipefail

readonly THEMES=(acid classic)
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
readonly CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly NOCTALIA_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/settings.toml"
# This script is stowed into ~/.local/bin; the repo is three levels above it.
DOTFILES="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)"
readonly DOTFILES

current() {
  local t
  t="$(cat "$STATE_DIR/theme" 2>/dev/null || true)"
  [[ "$t" == classic ]] && echo classic || echo acid
}

# The theme the desktop is in, or "unknown" before the first switch on a
# machine that already has per-theme snapshots (nothing safe to save then).
recorded() {
  if [[ -f "$STATE_DIR/theme" ]] || ! compgen -G "$STATE_DIR/noctalia-*.toml" >/dev/null; then
    current
  else
    echo unknown
  fi
}

usage() {
  sed -n '3,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# link <path> <target>: point <path> at <target>. A real file in the way is
# kept as <path>.bak-<timestamp> rather than overwritten. A missing target only
# warns, so one broken app never stops the rest of the switch.
link() {
  local path="$1" target="$2"
  [[ -e "$target" ]] || { echo "  ⚠ missing $target"; return 0; }
  mkdir -p "$(dirname "$path")"
  if [[ -e "$path" && ! -L "$path" ]]; then
    mv "$path" "$path.bak-$(date +%Y%m%d%H%M%S)"
    echo "  moved the existing $path aside (.bak-*)"
  fi
  ln -sfn "$target" "$path"
}

# noctalia_state <save|restore> <theme>: copy the theme-specific tables of
# Noctalia's state file to/from $STATE_DIR/noctalia-<theme>.toml. Restoring a
# theme that has no copy yet drops those tables, so the theme's config applies.
noctalia_state() {
  python3 -I - "$1" "$NOCTALIA_STATE" "$STATE_DIR/noctalia-$2.toml" <<'PY'
import re, sys
from pathlib import Path

mode, state, snap = sys.argv[1], Path(sys.argv[2]), Path(sys.argv[3])
THEMED = ("theme", "wallpaper", "lockscreen_widgets", "desktop_widgets")

def blocks(text):
    """Split into (table name or None for the preamble, text) runs."""
    out, name, cur = [], None, []
    for line in text.splitlines(keepends=True):
        # Table names only (no spaces or commas), so a lone `["x"]` line inside
        # a multi-line array is not mistaken for a header.
        m = re.match(r'\s*\[\[?\s*([A-Za-z0-9_.@"-]+)\s*\]\]?\s*$', line)
        if m:
            out.append((name, "".join(cur)))
            name, cur = m.group(1), []
        cur.append(line)
    out.append((name, "".join(cur)))
    return out

def themed(name):
    return name is not None and any(name == t or name.startswith(t + ".") for t in THEMED)

parts = blocks(state.read_text()) if state.exists() else []
if mode == "save":
    snap.write_text("".join(t for n, t in parts if themed(n)))
else:
    kept = "".join(t for n, t in parts if not themed(n))
    extra = snap.read_text() if snap.exists() else ""
    if kept and not kept.endswith("\n"):
        kept += "\n"
    tmp = state.with_suffix(".toml.tmp")
    tmp.write_text(kept + extra)
    tmp.replace(state)
PY
}

# claude_settings <theme>: set the theme-specific keys of Claude Code's user
# settings (not in the repo: it holds machine-local permissions and hooks), and
# leave every other key alone. Claude Code watches the file, so running
# sessions pick up the palette at once.
claude_settings() {
  local settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
  [[ -f "$settings" ]] || { echo "  ⚠ no $settings; skipping Claude Code"; return 0; }
  python3 -I - "$1" "$settings" <<'PY'
import json, sys
from pathlib import Path

theme, path = sys.argv[1], Path(sys.argv[2])
s = json.loads(path.read_text())

if theme == "acid":
    s["theme"] = "custom:acid-hud"
    s["spinnerVerbs"] = {"mode": "replace", "verbs": [
        "Jacking in", "Decrypting", "Uplinking", "Tracing signal", "Rerouting",
        "Overclocking", "Scanning grid", "Syncing link", "Patching", "Spooling",
        "Parsing telemetry", "Calibrating", "Handshaking", "Triangulating",
        "Bootstrapping", "Transmitting", "Compiling", "Defragging"]}
else:
    # Classic is Claude Code's own look: no keys means its defaults.
    s.pop("theme", None)
    s.pop("spinnerVerbs", None)

tmp = path.with_suffix(".json.tmp")
tmp.write_text(json.dumps(s, indent=2, ensure_ascii=False) + "\n")
tmp.replace(path)
PY
}

# obsidian_settings <theme>: link the ACID HUD theme into every vault listed
# in Obsidian's vault registry and select it in the vault's appearance.json
# (theme + the acid accent; a user-set accent beats the theme's). The look the
# vault had before is saved once per vault in $STATE_DIR/obsidian/ and put back
# by `classic`. A running Obsidian reloads so the change shows at once.
obsidian_settings() {
  local theme="$1" registry="$CONFIG/obsidian/obsidian.json" vault
  [[ -f "$registry" ]] || { echo "  ⚠ no $registry; skipping Obsidian"; return 0; }
  mkdir -p "$STATE_DIR/obsidian"
  while IFS= read -r vault; do
    [[ -d "$vault/.obsidian" ]] || continue
    # Obsidian skips a symlinked theme folder when it lists themes, so the
    # folder is real and only the two files inside it are links.
    mkdir -p "$vault/.obsidian/themes/ACID HUD"
    link "$vault/.obsidian/themes/ACID HUD/theme.css" "$DOTFILES/obsidian/themes/ACID HUD/theme.css"
    link "$vault/.obsidian/themes/ACID HUD/manifest.json" "$DOTFILES/obsidian/themes/ACID HUD/manifest.json"
    python3 -I - "$theme" "$vault/.obsidian/appearance.json" "$STATE_DIR/obsidian" <<'PY'
import hashlib, json, sys
from pathlib import Path

theme, path, state = sys.argv[1], Path(sys.argv[2]), Path(sys.argv[3])
snap = state / (hashlib.sha1(str(path.parent.parent).encode()).hexdigest()[:16] + ".json")
KEYS = ("cssTheme", "accentColor")
s = json.loads(path.read_text()) if path.exists() else {}

if theme == "acid":
    # Whatever the vault had before ACID HUD is its classic look.
    if s.get("cssTheme") != "ACID HUD" and not snap.exists():
        snap.write_text(json.dumps({k: s[k] for k in KEYS if k in s}) + "\n")
    s["cssTheme"] = "ACID HUD"
    s["accentColor"] = "#ef5fc6"
else:
    saved = json.loads(snap.read_text()) if snap.exists() else {}
    for k in KEYS:
        s.pop(k, None)
    s.update(saved)
    if s.get("cssTheme") == "ACID HUD":
        s.pop("cssTheme")

tmp = path.with_suffix(".json.tmp")
tmp.write_text(json.dumps(s, indent=2, ensure_ascii=False) + "\n")
tmp.replace(path)
PY
  done < <(python3 -I -c '
import json, sys
for v in json.load(open(sys.argv[1])).get("vaults", {}).values():
    print(v["path"])' "$registry")
  # The CLI talks to the running app; it fails fast when Obsidian is closed.
  if pgrep -x obsidian &>/dev/null; then
    obsidian reload &>/dev/null || echo "  ⚠ obsidian reload failed; restart Obsidian"
  fi
}

wait_noctalia() {
  local i
  for i in $(seq 50); do
    noctalia msg color-scheme-get &>/dev/null && return 0
    sleep 0.2
  done
  return 1
}

switch_noctalia() {
  local from="$1" to="$2" running=0
  # Stop first: Noctalia rewrites its state on exit and may hot-reload the new
  # theme.toml against the old state while still running.
  if pgrep -x noctalia &>/dev/null; then
    running=1
    pkill -x noctalia
    for _ in $(seq 50); do pgrep -x noctalia &>/dev/null || break; sleep 0.1; done
    if pgrep -x noctalia &>/dev/null; then
      pkill -KILL -x noctalia || true
      sleep 0.3
    fi
  fi
  link "$CONFIG/noctalia/theme.toml" "$DOTFILES/noctalia/.config/noctalia/themes/$to.toml"
  # The ACID//HUD lock layout of this machine's own monitors (written by
  # `hud-build --lock-sync`) would win over any theme.toml: park it outside
  # Noctalia's *.toml while another theme is active.
  local hud_lock="$CONFIG/noctalia/zz-hud-lock.toml"
  if [[ "$to" == acid ]]; then
    [[ ! -f "$hud_lock.parked" ]] || mv "$hud_lock.parked" "$hud_lock"
  elif [[ -f "$hud_lock" ]]; then
    mv "$hud_lock" "$hud_lock.parked"
  fi
  # Re-applying the active theme keeps its state; switching parks the old one.
  # A failure here must not leave the shell down, so it only warns.
  if [[ "$from" != "$to" ]]; then
    mkdir -p "$(dirname "$NOCTALIA_STATE")"
    [[ "$from" == unknown || ! -f "$NOCTALIA_STATE" ]] || noctalia_state save "$from" \
      || echo "  ⚠ could not save Noctalia state for $from"
    noctalia_state restore "$to" || echo "  ⚠ could not restore Noctalia state for $to"
  fi
  if (( running )); then
    setsid -f noctalia &>/dev/null
    if wait_noctalia; then
      noctalia msg templates-apply &>/dev/null || echo "  ⚠ noctalia: templates-apply failed"
    else
      echo "  ⚠ noctalia did not come back; start it with: noctalia -d"
    fi
  fi
}

apply() {
  local from="$1" to="$2"
  mkdir -p "$STATE_DIR"

  echo "Theme: $to"
  link "$CONFIG/ghostty/theme.conf" "$DOTFILES/ghostty/.config/ghostty/variants/$to.conf"
  link "$CONFIG/tmux/theme.conf" "$DOTFILES/tmux/.config/tmux/variants/$to.conf"
  link "$CONFIG/sioyek/prefs_user.config" "$DOTFILES/sioyek/.config/sioyek/variants/$to.config"
  # GTK4 apps read it when they start (gtk.css imports it after the palette).
  link "$CONFIG/gtk-4.0/theme.css" "$DOTFILES/gtk/.config/gtk-4.0/variants/$to.css"
  # GTK3 the same way: mostly the portal's file chooser and the passphrase prompt.
  link "$CONFIG/gtk-3.0/theme.css" "$DOTFILES/gtk/.config/gtk-3.0/variants/$to.css"
  # eza reads its theme file on every run; classic is eza's own defaults. Only
  # a link is removed, so a theme.yml the user wrote themselves is kept.
  if [[ "$to" == acid ]]; then
    link "$CONFIG/eza/theme.yml" "$DOTFILES/eza/.config/eza/variants/acid.yml"
  elif [[ -L "$CONFIG/eza/theme.yml" ]]; then
    rm -f "$CONFIG/eza/theme.yml"
  fi
  # Vivaldi loads every *.css in its css-mods folder (the repo's vivaldi/).
  if [[ "$to" == acid ]]; then
    link "$DOTFILES/vivaldi/theme.css" "$DOTFILES/vivaldi/variants/acid.vcss"
  else
    rm -f "$DOTFILES/vivaldi/theme.css"
  fi

  claude_settings "$to" || echo "  ⚠ could not update Claude Code settings"
  obsidian_settings "$to" || echo "  ⚠ could not update Obsidian"

  switch_noctalia "$from" "$to"

  if [[ "$to" == acid ]]; then
    [[ -d "$HOME/.local/share/hud/overlay" ]] \
      || echo "  ⚠ ACID//HUD assets missing: run hud-build (needs ~/Pictures/ricing)"
    if command -v qs &>/dev/null; then
      hud-overlay start &>/dev/null || echo "  ⚠ hud-overlay failed to start"
    fi
  elif command -v hud-overlay &>/dev/null; then
    hud-overlay stop &>/dev/null || true
  fi

  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl reload &>/dev/null || echo "  ⚠ hyprctl reload failed"
  fi
  if tmux list-sessions &>/dev/null; then
    tmux source-file "$HOME/.tmux.conf" || echo "  ⚠ tmux reload failed"
  fi
  # Ghostty re-reads its config on SIGUSR2.
  pkill -USR2 -x ghostty 2>/dev/null || true

  # Recorded last, so a switch that died half-way is redone (with the state
  # swap) on the next run instead of being skipped as "already active".
  printf '%s\n' "$to" >"$STATE_DIR/theme"

  echo "Applied. New shells and Neovim pick it up on start; restart Vivaldi and sioyek."
}

main() {
  case "${1:-}" in
    "") current ;;
    -h|--help) usage ;;
    --list) printf '%s\n' "${THEMES[@]}" ;;
    *)
      local t
      for t in "${THEMES[@]}"; do
        if [[ "$1" == "$t" ]]; then
          apply "$(recorded)" "$1"
          return
        fi
      done
      echo "Unknown theme: $1 (themes: ${THEMES[*]})" >&2
      exit 2
      ;;
  esac
}

main "$@"
