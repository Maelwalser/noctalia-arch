# Nothing in this package is linked into $HOME. The VimFields JS mod is
# installed into Vivaldi's resources dir by vivaldi/install.sh, and Vivaldi
# loads main.css straight from this folder (its css-mods folder).
custom\.js
install\.sh
main\.css
# Theme variants: `dotfiles-theme` links the active one as theme.css in this
# folder (Vivaldi's css-mods folder), not into $HOME.
variants
theme\.css
# Unpacked browser extensions, loaded via vivaldi://extensions, not stowed.
extensions
