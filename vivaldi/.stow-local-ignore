# Keep the VimFields JS mod out of stow — it is installed into Vivaldi's
# resources dir by vivaldi/install.sh, not symlinked into $HOME. Only main.css
# is stow-managed (Vivaldi loads it from its css-mods folder).
custom\.js
install\.sh
# Theme variants: `dotfiles-theme` links the active one as theme.css in this
# folder (Vivaldi's css-mods folder), not into $HOME.
variants
theme\.css
# Unpacked browser extensions, loaded via vivaldi://extensions, not stowed.
extensions
