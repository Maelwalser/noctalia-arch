/* vim: set ft=css: */
/*
================================================================================
  ACID//HUD theme for Vivaldi: liquid glass over a HUD backdrop.

  `dotfiles-theme acid` links this file as vivaldi/theme.css (Vivaldi loads
  every *.css in this css-mods folder); the .vcss extension keeps Vivaldi from
  loading it under the classic theme. main.css (fonts, field height) is shared
  by both themes and loads first.

  Vivaldi's window is opaque to the compositor, so hyprglass cannot light it
  the way it does the terminal (hypr/plugins.lua). The glass here is CSS: the
  same recipe as the Noctalia bar, toasts and desktop panes, translucent
  panes with backdrop blur, a 1 px rim, a top highlight and a soft shadow,
  over a near-black body with the wallpaper's scanlines and a faint acid
  horizon under the bar.

  Palette from noctalia/.config/noctalia/palettes/acid-hud.json; keep in sync
  by hand. Radii follow the desktop: 18 px panes (toasts, window corners,
  Noctalia corner_radius_scale), 12 px capsules (bar capsules, fields, tabs).
  Vivaldi sets its theme variables inline on #browser, so overrides need
  !important.

  This profile hides the address, status and bookmark bars (the URL field
  floats in on F8 / Ctrl+L) and shows the panel with F4; the rules for the
  docked bars are still here so the theme holds up if they come back.
================================================================================
*/

/* ── Tokens ─────────────────────────────────────────────────────────────── */

#browser {
  /* Vivaldi theme variables (the GUI theme underneath is the stock Dark). */
  --colorAccentBg: #ef5fc6 !important;
  --colorAccentBgDark: #c247a0 !important;
  --colorAccentBgDarker: #a03a84 !important;
  --colorAccentBgFaded: #d953b2 !important;
  --colorAccentBgAlpha: rgba(239, 95, 198, 0.9) !important;
  --colorAccentBgAlphaHeavy: rgba(239, 95, 198, 0.65) !important;
  --colorAccentBgAlphaBlur: rgba(239, 95, 198, 0.75) !important;
  --colorAccentBorder: #c247a0 !important;
  --colorAccentFg: #0b0712 !important;
  --colorAccentFgAlpha: rgba(10, 10, 12, 0.9) !important;
  --colorAccentFgFaded: #2e2340 !important;
  --colorHighlightBg: #ef5fc6 !important;
  --colorHighlightBgAlpha: rgba(239, 95, 198, 0.9) !important;
  --colorHighlightBgDark: #c247a0 !important;
  --colorHighlightBgFaded: #ff8fdc !important;
  --colorHighlightFg: #0b0712 !important;
  --colorHighlightFgAlpha: rgba(10, 10, 12, 0.9) !important;
  --colorFocusBg: #ef5fc6 !important;
  --colorBg: #0b0712 !important;
  --colorBgDark: #060309 !important;
  --colorBgDarker: #050207 !important;
  --colorBgLight: #1a1226 !important;
  --colorBgLighter: #241a33 !important;
  --colorBgLightIntense: #1f1629 !important;
  --colorBgIntense: #120c1a !important;
  --colorBgIntenser: #0e0915 !important;
  --colorBgFaded: #1f1629 !important;
  --colorBgAlpha: rgba(10, 10, 12, 0.9) !important;
  --colorBgAlphaHeavy: rgba(10, 10, 12, 0.65) !important;
  --colorBgAlphaHeavier: rgba(10, 10, 12, 0.5) !important;
  --colorBgAlphaBlur: rgba(10, 10, 12, 0.75) !important;
  --colorTabBar: transparent !important;
  --colorFg: #efe7f4 !important;
  --colorFgIntense: #ffffff !important;
  --colorFgFaded: #cfc2da !important;
  --colorFgFadedMore: #b7a8c9 !important;
  --colorFgFadedMost: #8f86a0 !important;
  --colorBorder: #4a3a62 !important;
  --colorBorderSubtle: #2a1f3b !important;
  --colorBorderIntense: #5a4a74 !important;
  --radius: 12px !important;
  --radiusHalf: 6px !important;
  --radiusCap: 18px !important;
  --radiusWindow: 18px !important;
  --backgroundBlur: blur(16px) saturate(1.3) !important;

  /* Glass recipe. The capsule fill and rim are the bar's (capsule_fill 0.07,
     capsule_border #ffffff26); the pane body is the toast fill with enough
     depth to keep text readable over a bright page. */
  --hud-acid: #ef5fc6;
  --hud-acid-dim: rgba(239, 95, 198, 0.18);
  --hud-acid-ring: rgba(239, 95, 198, 0.55);
  --hud-acid-glow: rgba(239, 95, 198, 0.18);
  --hud-glass: rgba(255, 255, 255, 0.07);
  --hud-glass-hover: rgba(255, 255, 255, 0.11);
  --hud-glass-lit: rgba(255, 255, 255, 0.14);
  --hud-rim: rgba(255, 255, 255, 0.15);
  --hud-rim-lit: rgba(255, 255, 255, 0.26);
  --hud-sheen: rgba(255, 255, 255, 0.18);
  --hud-hairline: rgba(255, 255, 255, 0.08);
  --hud-pane: rgba(10, 10, 12, 0.66);
  --hud-pane-deep: rgba(12, 12, 16, 0.84);
  --hud-pane-blur: blur(18px) saturate(1.3);
  --hud-pane-edge: inset 0 0 0 1px var(--hud-rim), inset 0 1px 0 var(--hud-sheen), inset 0 -1px 0 rgba(0, 0, 0, 0.35);
  --hud-shadow: 0 18px 48px rgba(0, 0, 0, 0.55);
  --hud-ease: 150ms ease;
}

/* ── Backdrop and frame ─────────────────────────────────────────────────── */

/* The body behind everything: near black, the wallpaper's scanlines and the
   acid horizon glow just under the bar. A 6 px bezel (Vivaldi's own auto-hide
   frame width) lets it show round the page pane; Hyprland rounds the outer
   corners at 18 px, the page pane rounds at 12 px, concentric at this inset. */
#browser {
  background-color: #0b0712 !important;
  background-image:
    radial-gradient(60% 70px at 50% -10px, rgba(239, 95, 198, 0.12), transparent 70%),
    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.022) 0 1px, transparent 1px 3px),
    linear-gradient(180deg, #15101d, #0b0712 55%) !important;
  background-origin: border-box !important;
  background-position: 0 0 !important;
  background-size: auto !important;
  background-repeat: no-repeat, repeat, no-repeat !important;
  border: 6px solid transparent !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}

#browser.fullscreen {
  border: 0 !important;
}

/* The page stack is clipped to the pane; the link preview is its sibling, so
   it stays outside the clip. */
#browser:not(.fullscreen) #webview-container {
  background-color: #0b0712 !important;
}

#browser:not(.fullscreen) #webpage-stack {
  border-radius: 12px !important;
  overflow: clip;
  box-shadow: 0 0 0 1px var(--hud-hairline) !important;
}

/* ── Tab bar: the rail ──────────────────────────────────────────────────── */

#browser #header,
#browser .tabbar-wrapper,
#browser #tabs-tabbar-container,
#browser #tabs-container,
#browser #tabs-subcontainer {
  background: transparent !important;
  box-shadow: none !important;
  border: 0 !important;
}

/* Tabs are glass capsules (the bar's capsule radius); a 4 px gap between them
   comes from the wrapper so Vivaldi's absolute tab layout is untouched. */
#browser .tab-wrapper {
  padding: 0 2px;
}

#browser #tabs-container .tab,
#browser #tabs-subcontainer .tab {
  height: 30px !important;
  border: 1px solid rgba(255, 255, 255, 0.1) !important;
  border-radius: 12px !important;
  background: var(--hud-glass) !important;
  color: var(--colorFg) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
  transition: background-color var(--hud-ease), box-shadow var(--hud-ease), border-color var(--hud-ease), color var(--hud-ease);
}

#browser #tabs-container .tab-wrapper:hover .tab:not(.active),
#browser #tabs-subcontainer .tab-wrapper:hover .tab:not(.active) {
  background: var(--hud-glass-hover) !important;
  border-color: rgba(255, 255, 255, 0.18) !important;
}

#browser #tabs-container .tab-wrapper:focus-visible .tab,
#browser #tabs-subcontainer .tab-wrapper:focus-visible .tab {
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 0 0 2px var(--hud-acid) !important;
}

/* The active tab is lit glass with an acid LED along its lower edge, the
   bar's active-workspace accent. */
#browser #tabs-container .tab.active,
#browser #tabs-subcontainer .tab.active {
  background: var(--hud-glass-lit) !important;
  color: var(--hud-acid) !important;
  border-color: var(--hud-rim-lit) !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.3),
    inset 0 -2px 0 var(--hud-acid),
    0 6px 16px rgba(0, 0, 0, 0.4) !important;
}

/* Vivaldi's little curves joining the active tab to the toolbar would hang
   off a capsule. */
#browser .tab.active::before,
#browser .tab.active::after {
  display: none !important;
}

#browser .tab .close {
  border-radius: 6px !important;
  transition: background-color var(--hud-ease), color var(--hud-ease);
}

#browser .tab .close:hover {
  background: var(--hud-acid-dim) !important;
  color: var(--hud-acid) !important;
}

#browser .tab-group-indicator {
  border-radius: 2px !important;
}

/* The menu, new-tab and window buttons are ghosts that light up as capsules. */
#browser button.vivaldi,
#browser .window-buttongroup button {
  background: transparent !important;
  border-radius: 10px !important;
  transition: background-color var(--hud-ease), box-shadow var(--hud-ease);
}

#browser button.vivaldi:hover,
#browser .window-buttongroup button:hover {
  background: var(--hud-glass-hover) !important;
  box-shadow: inset 0 0 0 1px var(--hud-rim), inset 0 1px 0 var(--hud-sheen) !important;
}

#browser .window-buttongroup button.window-close:hover {
  background: rgba(255, 59, 48, 0.28) !important;
  box-shadow: inset 0 0 0 1px rgba(255, 59, 48, 0.45), inset 0 1px 0 var(--hud-sheen) !important;
}

/* ── Toolbar buttons ────────────────────────────────────────────────────── */

#browser .button-toolbar:not(.toolbar-spacer, .toolbar-spacer-flexible, .toolbar-spacer-panel, .toolbar-divider) > .ToolbarButton-Button {
  border-radius: 10px !important;
  transition: background-color var(--hud-ease), box-shadow var(--hud-ease), color var(--hud-ease);
}

#browser .button-toolbar:not(.toolbar-spacer, .toolbar-spacer-flexible, .toolbar-spacer-panel, .toolbar-divider) > .ToolbarButton-Button:hover {
  background-color: var(--hud-glass-hover) !important;
  box-shadow: inset 0 0 0 1px var(--hud-rim), inset 0 1px 0 var(--hud-sheen) !important;
}

#browser .button-toolbar:not(.toolbar-spacer, .toolbar-spacer-flexible, .toolbar-spacer-panel, .toolbar-divider) > .ToolbarButton-Button:active,
#browser .button-toolbar.active:not(.toolbar-spacer, .toolbar-spacer-flexible, .toolbar-spacer-panel, .toolbar-divider) > .ToolbarButton-Button,
#browser .ToolbarButton-Button[aria-pressed="true"] {
  background-color: var(--hud-acid-dim) !important;
  color: var(--hud-acid) !important;
  box-shadow: inset 0 0 0 1px rgba(239, 95, 198, 0.4), inset 0 1px 0 var(--hud-sheen) !important;
}

#browser .toolbar-divider .ToolbarButton-Button {
  opacity: 0.35;
}

/* ── Address and search fields ──────────────────────────────────────────── */

#browser .UrlBar-AddressField,
#browser .UrlBar-SearchField,
#browser .SearchField {
  background: var(--hud-glass) !important;
  border: 1px solid var(--hud-rim) !important;
  border-radius: 12px !important;
  color: var(--colorFg) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08) !important;
  transition: box-shadow var(--hud-ease), border-color var(--hud-ease);
}

/* The URL field floating in over the page (address bar hidden, F8 / Ctrl+L):
   a full pill at main.css's 36 px, the bar rail's radius. */
#browser .UrlBar-AddressField.urlfield-anchor {
  position: absolute;
  isolation: isolate;
  background: transparent !important;
  border: 0 !important;
  border-radius: 18px !important;
  padding: 0 8px !important;
  box-shadow: var(--hud-pane-edge), var(--hud-shadow) !important;
}

/* The fill and blur live on a layer under the field, not on the field: an
   element with backdrop-filter is a backdrop root, and the suggestion
   dropdown inside it could then only blur the field, not the page. */
#browser .UrlBar-AddressField.urlfield-anchor::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  background: var(--hud-pane-deep);
  backdrop-filter: var(--hud-pane-blur);
}

#browser .UrlBar-AddressField:focus-within,
#browser .UrlBar-SearchField:focus-within,
#browser .SearchField:focus-within {
  outline: none !important;
  border-color: var(--hud-acid-ring) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 0 18px var(--hud-acid-glow) !important;
}

#browser .UrlBar-AddressField.urlfield-anchor:focus-within {
  box-shadow: var(--hud-pane-edge), 0 0 0 1px var(--hud-acid-ring), 0 0 22px var(--hud-acid-glow), var(--hud-shadow) !important;
}

#browser .UrlBar-UrlField,
#browser .SearchField input {
  background: transparent !important;
  color: var(--colorFg) !important;
}

/* Chip inputs (settings keyboard shortcuts, search engine lists): Vivaldi
   fills the chips with the highlight colour but never sets their text
   colour, so acid chips came out with white text. Glass keycaps instead; the
   chip being edited takes the acid fill with dark text. */
#browser .multiinput {
  background: var(--hud-glass) !important;
  border: 1px solid var(--hud-rim) !important;
  border-radius: 12px !important;
}

#browser .multiinput .multiinput-item {
  background: rgba(255, 255, 255, 0.12) !important;
  color: var(--colorFg) !important;
  fill: var(--colorFg) !important;
  border-radius: 8px !important;
  box-shadow: inset 0 0 0 1px var(--hud-rim), inset 0 1px 0 var(--hud-sheen), inset 0 -1px 0 rgba(0, 0, 0, 0.35) !important;
}

#browser .multiinput .multiinput-item:focus {
  background: var(--hud-acid) !important;
  color: var(--colorAccentFg) !important;
  fill: var(--colorAccentFg) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 0 14px var(--hud-acid-glow) !important;
}

#browser .multiinput .multiinput-item[disabled] {
  background: rgba(255, 255, 255, 0.04) !important;
  color: var(--colorFgFadedMore) !important;
  box-shadow: inset 0 0 0 1px var(--hud-hairline) !important;
}

/* URL suggestions: a pane hanging off the field. */
#browser .OmniDropdown {
  margin-top: 6px;
  background: var(--hud-pane-deep) !important;
  backdrop-filter: var(--hud-pane-blur);
  border: 1px solid var(--hud-rim) !important;
  border-radius: 18px !important;
  color: var(--colorFg) !important;
  box-shadow: inset 0 1px 0 var(--hud-sheen), var(--hud-shadow) !important;
  overflow: hidden;
}

/* ── Auto-hide panes and the panel ──────────────────────────────────────── */

/* Toolbars that slide in from an edge are glass panes, like the toasts. */
#browser .auto-hide-wrapper {
  isolation: isolate;
  background: transparent !important;
  border-radius: 18px !important;
  box-shadow: var(--hud-pane-edge), var(--hud-shadow) !important;
}

/* A parked pane sits only 12 px off-screen, so its shadow would show. */
#browser .auto-hide-wrapper:not(.show) {
  box-shadow: none !important;
}

/* Fill and blur on a layer under the pane (see the URL field), so popups
   inside the panel still blur the page. Vivaldi uses ::before itself. */
#browser .auto-hide-wrapper::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  background: var(--hud-pane);
  backdrop-filter: var(--hud-pane-blur);
  pointer-events: none;
}

#browser .auto-hide-wrapper #panels-container,
#browser .auto-hide-wrapper #panels,
#browser .auto-hide-wrapper .mainbar,
#browser .auto-hide-wrapper .bookmark-bar,
#browser .auto-hide-wrapper .toolbar-statusbar,
#browser .auto-hide-wrapper #tabs-tabbar-container,
#browser .mainbar,
#browser .bookmark-bar,
#browser footer#footer,
#browser #switch,
#browser .panel-group,
#browser .panel,
#browser .panel-collapse-guard {
  background: transparent !important;
  border-color: transparent !important;
  box-shadow: none !important;
}

/* Docked panel strip (F4) and its floating panel content over the page. */
#browser .inner #panels-container {
  background: transparent !important;
  border: 0 !important;
}

#browser #panels-container.left .panel-group {
  border-left: 1px solid var(--hud-hairline) !important;
}

#browser #panels-container.right .panel-group {
  border-right: 1px solid var(--hud-hairline) !important;
}

#browser .inner #panels-container.overlay .panel-group {
  position: relative;
  isolation: isolate;
  background: transparent !important;
  box-shadow: var(--hud-pane-edge), var(--hud-shadow) !important;
}

#browser .inner #panels-container.overlay .panel-group::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  background: var(--hud-pane);
  backdrop-filter: var(--hud-pane-blur);
  pointer-events: none;
}

#browser .inner #panels-container.overlay.left .panel-group {
  border-radius: 0 18px 18px 0 !important;
}

#browser .inner #panels-container.overlay.right .panel-group {
  border-radius: 18px 0 0 18px !important;
}

/* Link preview (bottom left of the page): a small capsule. */
#browser .StatusInfo {
  background: transparent !important;
}

#browser .StatusInfo-Content {
  background: var(--hud-pane-deep) !important;
  backdrop-filter: blur(16px);
  border: 1px solid var(--hud-rim) !important;
  border-radius: 10px !important;
  padding: 4px 10px !important;
  color: var(--colorFg) !important;
  box-shadow: inset 0 1px 0 var(--hud-sheen) !important;
}

/* ── Popups, dialogs, tooltips ──────────────────────────────────────────── */

#browser .button-popup,
#browser .extension-popup,
#browser #modal-bg .modal-wrapper,
#browser .quick-command-container .quick-commands,
#browser .find-in-page,
#browser .HintTooltip__content,
#browser .workspace-popup,
#browser .SearchField .menu,
#browser .tabstack-popup,
#browser .TabButtonPopup,
#browser .addressfield-popup {
  background: var(--hud-pane-deep) !important;
  backdrop-filter: var(--hud-pane-blur);
  border: 1px solid var(--hud-rim) !important;
  border-radius: 14px !important;
  color: var(--colorFg) !important;
  box-shadow: inset 0 1px 0 var(--hud-sheen), var(--hud-shadow) !important;
}

#browser #modal-bg .modal-wrapper,
#browser .quick-command-container .quick-commands {
  border-radius: 18px !important;
}

/* Tab hover preview: thumbnail and caption on one pane. */
#browser .tooltip .tooltip-item {
  background: var(--hud-pane-deep) !important;
  backdrop-filter: var(--hud-pane-blur);
  border: 1px solid var(--hud-rim) !important;
  border-radius: 14px !important;
  box-shadow: inset 0 1px 0 var(--hud-sheen), var(--hud-shadow) !important;
  overflow: hidden;
}

#browser .tooltip .thumbnail-image {
  border-radius: 13px 13px 0 0 !important;
}

/* Vivaldi's pointer arrows under popups would float off the glass. */
#browser .button-popup:before,
#browser .extension-popup:before,
#browser .extension-popup:after,
#browser .HintTooltip__content:after {
  display: none !important;
}

#browser .dialog-content,
#browser .dialog-header,
#browser .dialog-footer {
  background: transparent !important;
}

/* ── Start page ─────────────────────────────────────────────────────────── */

/* The start page is Vivaldi's own UI, not a web page: it takes the tokens
   above, and here the same glass as the rest. Its backdrop is the body's
   (scanlines, horizon) with Vivaldi's wallpaper image switched off, the
   speed dials and dashboard widgets are panes, the navigation is a rail. */
#browser .startpage {
  background-color: #0b0712 !important;
  background-image:
    radial-gradient(70% 240px at 50% 0, rgba(239, 95, 198, 0.10), transparent 70%),
    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.022) 0 1px, transparent 1px 3px) !important;
  background-size: auto !important;
  background-repeat: no-repeat, repeat !important;
}

#browser .startpage .startpage-navigation {
  background: transparent !important;
  box-shadow: inset 0 -1px 0 var(--hud-hairline) !important;
}

#browser .startpage .startpage-navigation-group button {
  border-radius: 12px !important;
  transition: background-color var(--hud-ease), color var(--hud-ease);
}

#browser .startpage .startpage-navigation-group button:hover {
  background: var(--hud-glass-hover) !important;
}

#browser .startpage .startpage-navigation-group button.active {
  background: var(--hud-acid-dim) !important;
  color: var(--hud-acid) !important;
  box-shadow: inset 0 0 0 1px var(--hud-acid-ring) !important;
}

#browser .startpage .SpeedDial--Thumbnail,
#browser .startpage .SpeedDial--Icon .favicon,
#browser .startpage .dashboard-widget {
  background-color: var(--hud-pane) !important;
  backdrop-filter: var(--hud-pane-blur);
  border-radius: 12px !important;
  box-shadow: var(--hud-pane-edge), 0 8px 24px rgba(0, 0, 0, 0.4) !important;
  transition: box-shadow var(--hud-ease);
}

#browser .startpage .SpeedDial:hover .SpeedDial--Thumbnail,
#browser .startpage .SpeedDial:focus-visible .SpeedDial--Thumbnail,
#browser .startpage .SpeedDial--Icon:hover .favicon,
#browser .startpage .SpeedDial--Icon:focus-visible .favicon {
  box-shadow: inset 0 0 0 1px var(--hud-acid-ring), 0 0 18px var(--hud-acid-glow), 0 8px 24px rgba(0, 0, 0, 0.4) !important;
}

#browser .startpage .SpeedDialView-SearchField {
  background: var(--hud-glass) !important;
  border: 1px solid var(--hud-rim) !important;
  border-radius: 12px !important;
}
