#!/usr/bin/env -S python3 -I
"""Build the ACID//HUD theme assets from the vector packs in ~/Pictures/ricing.

The packs are licensed stock art and the dotfiles repo is public, so nothing
derived from them is committed: this script regenerates everything locally.

  hud-build              crop elements (if stale), tint, lockscreen, wallpapers, extras
  hud-build --tint-only  re-tint / re-render from the current palette (palette hook)
  hud-build --force      re-crop every element even if it is up to date
  hud-build --lock-layout  print the lockscreen widget TOML for noctalia's themes/acid.toml
  hud-build --lock-sync    give a connected monitor the theme has not seen its lock art and
                           layout, and the bar its scale (monitor hotplug, Hyprland autostart)
  hud-build --shaders    compile the overlay's shaders only (quickshell/hud/shaders)
  hud-build --plymouth   render the boot splash theme only (installed by hud-boot)

Outputs (all under ~/.local/share/hud unless noted):
  elements/<name>.png        white-on-transparent masks, tinted at runtime by the overlay
  tinted/<name>-<role>.png   palette-coloured copies for consumers that cannot tint
  lock/                      lockscreen art: static-<output>.png, reticle-<output>.png, backdrop.png
  overlay/, bar/             Quickshell overlay layers, Noctalia bar plugin frames
  fastfetch-logo.png, nvim-header.txt, nvim-header-large.txt
  plymouth/acid-hud/         the boot splash theme (--plymouth only)
  ~/Pictures/Wallpapers/hud/hud-<w>x<h>.png
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import glob
import json
import math
import os
import random
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HOME = Path.home()
SRC = HOME / ".local/share/hud-src"
OUT = HOME / ".local/share/hud"
CACHE = HOME / ".cache/hud"
SHADERS = HOME / ".config/quickshell/hud/shaders"
QSB = shutil.which("qsb") or "/usr/lib/qt6/bin/qsb"  # qt6-shadertools, not on PATH
PACKS = HOME / "Pictures/ricing"
WALLPAPERS = HOME / "Pictures/Wallpapers/hud"
COLORS_JSON = HOME / ".config/hud/colors.json"
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")
NOCTALIA_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "noctalia"

# Used until Noctalia has rendered ~/.config/hud/colors.json once.
DEFAULT_COLORS = {
    "primary": "#ef5fc6",
    "on_primary": "#140a1c",
    "secondary": "#ff8fdc",
    "tertiary": "#ffa35e",  # the amber highlight: used sparingly
    "surface": "#0b0712",
    "surface_variant": "#1a1226",
    "on_surface": "#efe7f4",
    "on_surface_variant": "#b7a8c9",
    "outline": "#4a3a62",
    "error": "#ff4d5e",
}

# Elements other programs need as pre-coloured PNGs: name -> (roles, longest edge).
TINTED = {
    "tri-blade": (("primary", "on_surface"), 256),
    "hazard-2": (("primary", "outline"), 512),
    "hazard-1": (("primary",), 512),
    "barcode": (("on_surface", "outline"), 384),
    "slashes-3": (("primary",), 128),
    "chevrons-up": (("primary",), 128),
    "est-2100": (("on_surface_variant",), 384),
    "bracket-cross": (("primary",), 256),
    "caution": (("primary",), 768),
    "frame-scope": (("outline",), 1024),
}

# Quickshell overlay layers: name -> (element, role, longest edge). Pre-tinted
# rather than recoloured with a GPU effect so the always-on overlay stays cheap.
OVERLAY = {
    "ring-outer": ("ring-03", "outline", 1024),
    "ring-acid": ("ring-07", "primary", 1024),
    "ring-ticks": ("ring-ticks", "outline", 1024),
    "tick-strip": ("tick-strip", "outline", 768),
    "claw": ("y2k-claw", "primary", 128),
}
# Overlay layers whose bottom fraction fades to transparent.
OVERLAY_FADE: dict[str, float] = {}

# Physical resolutions the wallpaper is rendered at (eDP-1 and the ultrawides).
WALLPAPER_SIZES = ((1920, 1200), (5120, 2160), (3840, 2160))

MONO_FONT = "Departure-Mono-Regular"

# "<USER>//HUD" tags on the wallpaper and lockscreen: the login name, so the
# public repo carries no name and every machine shows its own.
USER_TAG = (os.environ.get("USER") or "user").upper()


@contextlib.contextmanager
def staged(dst: Path):
    """Yield a temp path next to dst and rename it over dst on success.

    Readers (Noctalia, the overlay, the bar plugin) can poll these files at any
    moment, and the up-to-date checks trust mtimes, so a half-written or failed
    output must never appear under the final name.
    """
    tmp = dst.with_name(f".{dst.stem}.tmp{dst.suffix}")  # keep the suffix: magick infers the format
    try:
        yield tmp
        os.replace(tmp, dst)
    finally:
        tmp.unlink(missing_ok=True)


def run(*cmd: str | os.PathLike) -> None:
    """Run a command, surfacing stderr on failure instead of swallowing it."""
    res = subprocess.run([str(c) for c in cmd], capture_output=True, text=True)
    if res.returncode != 0:
        raise RuntimeError(f"{cmd[0]} failed ({res.returncode}): {res.stderr.strip()[:800]}")


def require_tools() -> None:
    missing = [t for t in ("gs", "pdftocairo", "magick") if shutil.which(t) is None]
    if missing:
        sys.exit(f"hud-build: missing tools: {', '.join(missing)} "
                 "(pacman -S ghostscript poppler imagemagick)")


def load_manifest() -> dict:
    with open(SRC / "elements.toml", "rb") as f:
        return tomllib.load(f)


def load_colors() -> dict[str, str]:
    colors = dict(DEFAULT_COLORS)
    try:
        loaded = json.loads(COLORS_JSON.read_text())
    except FileNotFoundError:
        return colors
    except json.JSONDecodeError as e:
        print(f"hud-build: ignoring malformed {COLORS_JSON}: {e}", file=sys.stderr)
        return colors
    # Values end up as magick arguments: accept plain #rrggbb only.
    for role, value in loaded.items() if isinstance(loaded, dict) else ():
        if isinstance(value, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", value):
            colors[role] = value
        else:
            print(f"hud-build: ignoring invalid colour {role}={value!r}", file=sys.stderr)
    return colors


def sheet_pdf(sheet_id: str, sheet: dict) -> Path:
    """EPS -> PDF once; pdftocairo can then crop any region at any DPI."""
    eps = sorted(glob.glob(str(PACKS / sheet["dir"] / "*.eps")))
    if not eps:
        raise FileNotFoundError(f"no .eps in {PACKS / sheet['dir']}")
    pdf = CACHE / f"{sheet_id}.pdf"
    if not pdf.exists() or pdf.stat().st_mtime < os.path.getmtime(eps[0]):
        CACHE.mkdir(parents=True, exist_ok=True)
        with staged(pdf) as tmp:
            run("gs", "-q", "-dNOPAUSE", "-dBATCH", "-dSAFER", "-sDEVICE=pdfwrite",
                "-dEPSCrop", f"-sOutputFile={tmp}", eps[0])
    return pdf


def alpha_grid(png: Path, n: int):
    """Alpha channel resized to fit n x n, as (w, h, bytes)."""
    raw = subprocess.run(["magick", str(png), "-alpha", "extract", "-resize", f"{n}x{n}",
                          "-depth", "8", "pgm:-"], capture_output=True, check=True).stdout
    # P5 header: magic, width, height, maxval, each separated by whitespace.
    parts, pos = [], 0
    while len(parts) < 4:
        while raw[pos:pos + 1].isspace():
            pos += 1
        start = pos
        while not raw[pos:pos + 1].isspace():
            pos += 1
        parts.append(raw[start:pos])
    w, h = int(parts[1]), int(parts[2])
    return w, h, raw[pos + 1:pos + 1 + w * h]


def circle_through(p1, p2, p3):
    (ax, ay), (bx, by), (cx, cy) = p1, p2, p3
    d = 2 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by))
    if abs(d) < 1e-9:
        return None
    a2, b2, c2 = ax * ax + ay * ay, bx * bx + by * by, cx * cx + cy * cy
    ux = (a2 * (by - cy) + b2 * (cy - ay) + c2 * (ay - by)) / d
    uy = (a2 * (cx - bx) + b2 * (ax - cx) + c2 * (bx - ax)) / d
    return ux, uy, math.hypot(ax - ux, ay - uy)


def fit_circle(points):
    """Algebraic (Kasa) least-squares fit: x^2+y^2+Dx+Ey+F=0."""
    sxx = sxy = syy = sx = sy = sxz = syz = sz = 0.0
    n = len(points)
    for x, y in points:
        z = x * x + y * y
        sxx += x * x; syy += y * y; sxy += x * y
        sx += x; sy += y; sxz += x * z; syz += y * z; sz += z
    m = [[sxx, sxy, sx], [sxy, syy, sy], [sx, sy, n]]
    v = [-sxz, -syz, -sz]
    # Gaussian elimination on the 3x3 normal equations.
    for i in range(3):
        piv = max(range(i, 3), key=lambda r: abs(m[r][i]))
        m[i], m[piv] = m[piv], m[i]
        v[i], v[piv] = v[piv], v[i]
        for r in range(i + 1, 3):
            f = m[r][i] / m[i][i]
            for c in range(i, 3):
                m[r][c] -= f * m[i][c]
            v[r] -= f * v[i]
    sol = [0.0] * 3
    for i in (2, 1, 0):
        sol[i] = (v[i] - sum(m[i][c] * sol[c] for c in range(i + 1, 3))) / m[i][i]
    d, e, f = sol
    cx, cy = -d / 2, -e / 2
    return cx, cy, math.sqrt(max(cx * cx + cy * cy - f, 0))


def ring_center(png: Path, n: int = 400):
    w, h, a = alpha_grid(png, n)
    on = lambda x, y: a[y * w + x] > 127
    edges = [(x, y) for y in range(1, h - 1) for x in range(1, w - 1)
             if on(x, y) and not (on(x - 1, y) and on(x + 1, y) and on(x, y - 1) and on(x, y + 1))]
    if len(edges) < 3:
        raise RuntimeError(f"{png.name}: no visible edges to fit; use center = \"bbox\" instead")
    rng = random.Random(2100)  # deterministic: rebuilds must not jitter
    sample = rng.sample(edges, min(len(edges), 1500))
    best, best_n = None, 0
    lo, hi = 0.28 * max(w, h), 0.56 * max(w, h)
    for _ in range(1500):
        c = circle_through(*rng.sample(sample, 3))
        if not c or not lo <= c[2] <= hi:
            continue
        cx, cy, r = c
        k = sum(1 for x, y in sample if abs(math.hypot(x - cx, y - cy) - r) < 1.2)
        if k > best_n:
            best, best_n = c, k
    if best is None:
        raise RuntimeError(f"{png.name}: no circle found; use center = \"bbox\" instead")
    cx, cy, r = best
    inliers = [(x, y) for x, y in edges if abs(math.hypot(x - cx, y - cy) - r) < 2.0]
    cx, cy, r = fit_circle(inliers)
    # +0.5: edges are pixel indices, the fit wants pixel centres.
    return (cx + 0.5) / w, (cy + 0.5) / h, r / max(w, h), len(inliers) / max(1, len(edges))


def recenter(png: Path, mode: str) -> None:
    """Pad png to a square canvas whose centre is the element's centre."""
    w, h = (int(v) for v in subprocess.run(["magick", "identify", "-format", "%w %h", str(png)],
                                            capture_output=True, text=True, check=True).stdout.split())
    if mode == "circle":
        fx, fy, _, support = ring_center(png)
        # Below ~15 % of the edges on the circle the fit is not trustworthy
        # (spirals, tunnels): rotating such a fit would visibly wobble.
        if support < 0.15:
            raise RuntimeError(f"{png.name}: circle fit too weak ({support:.0%} of edges); "
                               "use center = \"bbox\" instead")
        cx, cy = fx * w, fy * h
    elif mode == "bbox":
        trim = subprocess.run(["magick", str(png), "-alpha", "extract", "-threshold", "10%",
                               "-format", "%@", "info:"], capture_output=True, text=True,
                              check=True).stdout  # WxH+X+Y of the visible pixels
        bw, bh, bx, by = (int(v) for v in trim.replace("x", "+").split("+"))
        if bw == 0 or bh == 0:
            raise RuntimeError(f"{png.name}: element is empty, nothing to centre")
        cx, cy = bx + bw / 2, by + bh / 2
    else:
        raise ValueError(f"unknown center mode {mode!r}")
    half = math.ceil(max(cx, w - cx, cy, h - cy))
    # Negative -extent offsets pad the top/left, moving the content right/down.
    run("magick", png, "-background", "none", "-gravity", "NorthWest",
        "-extent", f"{2 * half}x{2 * half}-{round(half - cx)}-{round(half - cy)}", png)


def extract(name: str, el: dict, sheet: dict, pdf: Path, tmp: Path) -> Path:
    x, y, w, h = el["box"]
    dpi = el["size"] / max(w, h) * 72
    k = dpi / 72
    raw = tmp / name
    run("pdftocairo", "-png", "-singlefile", "-r", f"{dpi:.3f}",
        "-x", round(x * k), "-y", round(y * k), "-W", round(w * k), "-H", round(h * k),
        pdf, raw)
    out = OUT / "elements" / f"{name}.png"
    lo, hi = el.get("level", sheet["level"]).split(",")
    negate = ["-negate"] if sheet["mode"] == "dark" else []
    # Erased regions are painted in the sheet's background tone before alpha is
    # derived, so they drop out exactly like the background does.
    erase = ["-fill", "white" if negate else "black", "-stroke", "none"]
    for ex, ey, ew, eh in el.get("erase", []):
        x0, y0 = round((ex - x) * k), round((ey - y) * k)
        erase += ["-draw", f"rectangle {x0},{y0} {x0 + round(ew * k)},{y0 + round(eh * k)}"]
    # Brightest channel -> alpha (works for white, cyan and green line art alike),
    # then a solid white fill so every consumer can recolour it freely.
    # -draw re-enables alpha, which -separate would then fold into the max.
    with staged(out) as tmp_out:
        run("magick", f"{raw}.png", "-alpha", "off", *erase, "-alpha", "off", *negate,
            "-separate", "-evaluate-sequence", "Max", "-level", f"{lo},{hi}",
            "(", "+clone", "-fill", "white", "-colorize", "100", ")", "+swap",
            "-compose", "CopyOpacity", "-composite", "-define", "png:color-type=6", tmp_out)
        if "center" in el:
            recenter(tmp_out, el["center"])
    return out


def build_elements(manifest: dict, force: bool) -> None:
    (OUT / "elements").mkdir(parents=True, exist_ok=True)
    manifest_mtime = (SRC / "elements.toml").stat().st_mtime
    sheets = manifest["sheets"]
    pdfs: dict[str, Path] = {}
    built = 0
    with tempfile.TemporaryDirectory(prefix="hud-") as td:
        for name, el in manifest["elements"].items():
            out = OUT / "elements" / f"{name}.png"
            if not force and out.exists() and out.stat().st_mtime >= manifest_mtime:
                continue
            sid = el["sheet"]
            if sid not in pdfs:
                pdfs[sid] = sheet_pdf(sid, sheets[sid])
            extract(name, el, sheets[sid], pdfs[sid], Path(td))
            built += 1
    print(f"elements: {built} built, {len(manifest['elements']) - built} up to date")


def tint(src: Path, color: str, size: int, dst: Path) -> None:
    with staged(dst) as tmp:
        run("magick", src, "-resize", f"{size}x{size}>", "-fill", color, "-colorize", "100", tmp)


def build_tinted(colors: dict[str, str]) -> None:
    (OUT / "tinted").mkdir(parents=True, exist_ok=True)
    for name, (roles, size) in TINTED.items():
        for role in roles:
            tint(OUT / "elements" / f"{name}.png", colors[role], size,
                 OUT / "tinted" / f"{name}-{role}.png")
    print(f"tinted: {sum(len(r) for r, _ in TINTED.values())} files")


def bump_overlay_version(colors: dict[str, str]) -> None:
    """Rewrite the stamp the Quickshell overlay watches: it reloads its images
    (the overlay layers and the lock art) when this changes."""
    (OUT / "overlay" / "version").write_text(f"{os.getpid()}-{len(OVERLAY)}-{colors['primary']}\n")


def build_overlay(colors: dict[str, str]) -> None:
    d = OUT / "overlay"
    d.mkdir(parents=True, exist_ok=True)
    for name, (element, role, size) in OVERLAY.items():
        tint(OUT / "elements" / f"{element}.png", colors[role], size, d / f"{name}.png")
        if name in OVERLAY_FADE:
            # Alpha ramp: opaque down to (1 - fade) of the height, then to zero.
            start = 1 - OVERLAY_FADE[name]
            with staged(d / f"{name}.png") as tmp:
                run("magick", d / f"{name}.png",
                    "(", "+clone", "-alpha", "extract",
                    "(", "+clone", "-fx", f"j/h < {start} ? 1 : (1 - (j/h - {start}) / {1 - start})^1.5", ")",
                    "-compose", "Multiply", "-composite", ")",
                    "-alpha", "off", "-compose", "CopyOpacity", "-composite", tmp)
    with staged(d / "ring-face.png") as tmp:
        clock_face(1024, colors["on_surface_variant"], tmp)
    # Oscilloscope traces: seamless tiles the overlay scrolls end to end.
    with staged(d / "wave.png") as tmp:
        scope_trace(colors["primary"], braid=True, dst=tmp)
    with staged(d / "wave-drift.png") as tmp:
        scope_trace(colors["on_surface_variant"], braid=False, dst=tmp)
    # The overlay watches this stamp (not colors.json, which lands before the
    # re-tint finishes) and cache-busts its images when it changes.
    bump_overlay_version(colors)
    print(f"overlay: {len(OVERLAY)} layers")


def floor_grid(w: int, d: int, ax: int, cell: float, stroke: float, dst: Path) -> None:
    """Render a perspective floor grid, white on transparent, to dst (w x d px).

    The camera sits one unit above a gently rippling plane, looking at the
    horizon (dst's top edge) with the vanishing point at x = ax; depth 1 lands
    on the bottom edge. `cell` is the grid pitch in plane units, so the nearest
    cells are about cell * d px wide. Rows and columns thin out with depth
    (every 2nd, then 4th, ...) so they never pack tighter than `gap` px: the grid
    reaches the horizon across the full width without turning to mush.
    """
    gap, near = 22.0, 0.8
    f = float(d)
    reach = max(ax, w - ax) + 40

    def lift(x: float, z: float) -> float:
        # Low swells across the plane, like the warped floor in the packs.
        # Damped with depth so far rows never fold over each other.
        return 0.07 * math.exp(-z / 7) * (math.sin(0.8 * x + 0.5 * z)
                                          + 0.6 * math.sin(1.7 * x - 0.9 * z + 1.3))

    def pt(x: float, z: float) -> str:
        return f"{ax + f * x / z:.1f},{f * (1 - lift(x, z)) / z:.1f}"

    lines, fading = [], []
    z, step = near, cell
    while f / z > 2:  # rows until they sit within 2 px of the horizon
        if f * step / (z * z) < gap:
            step *= 2
            continue
        half = reach / f * z
        lines.append(" ".join(pt(-half + 2 * half * i / 160, z) for i in range(161)))
        z += step
    kmax = int(2 * w / gap)
    for k in range(-kmax, kmax + 1):
        # Column k ends where columns of its level (multiples of k's lowest set
        # bit) get closer than gap; column 0 runs to the vanishing point.
        level = (k & -k) if k else 1 << 16
        zend = min(f * cell * level / gap, 4000.0)
        x = k * cell
        if abs(f * x / zend) > reach:  # off-screen for its whole length
            continue
        # Full strength to half its length (in log depth), then fading out in
        # steps, so thinned-out columns dissolve instead of ending in a cut.
        for a, b, alpha in ((0.0, 0.5, 1.0), (0.5, 0.65, 0.7), (0.65, 0.8, 0.45), (0.8, 1.0, 0.2)):
            zs = [near * (zend / near) ** (a + (b - a) * i / 40) for i in range(41)]
            fading.append((alpha, " ".join(pt(x, zz) for zz in zs)))
    dst.parent.mkdir(parents=True, exist_ok=True)
    mvg = dst.with_suffix(".mvg")
    mvg.write_text(f"stroke white\nstroke-width {stroke:.2f}\nfill none\n"
                   + "".join(f"polyline {ln}\n" for ln in lines)
                   + "".join(f"push graphic-context\nstroke-opacity {a}\npolyline {ln}\n"
                             "pop graphic-context\n" for a, ln in fading))
    try:
        with staged(dst) as tmp:
            run("magick", "-size", f"{w}x{d}", "xc:none", "-draw", f"@{mvg}", tmp)
    finally:
        mvg.unlink(missing_ok=True)


def ridge_mask(ax: float) -> str:
    """-fx alpha for the horizon ridge: a mountain profile over a band (i/w, j/h).

    Peaks left and right of the clock axis, a valley under the overlay's ring
    (it rises out of the gap), and nothing at the frame labels. Inside the
    profile the alpha is brightest at the crest, a rim that keeps the dot
    cloud reading as a silhouette, and settles lower toward the horizon.
    """
    x = "i/w"
    peaks = " + ".join(f"{a}*exp(-(({x}-{c})/{wd})^2)" for a, c, wd in (
        (0.62, 0.13, 0.06), (0.48, 0.22, 0.045), (0.30, 0.31, 0.05),
        (0.40, 0.56, 0.05), (0.88, 0.71, 0.055), (0.55, 0.81, 0.04), (0.35, 0.89, 0.04)))
    rough = f"0.05*sin({x}*91) + 0.03*sin({x}*233 + 1.3)"
    valley = f"(1 - 0.9*exp(-(({x}-{ax:.3f})/0.075)^2))"
    edge = f"pow(max(0, min(1, min(({x}-0.045)/0.08, (0.955-{x})/0.08))), 0.8)"
    top = f"(1 - min(1, 0.16 + {peaks} + {rough}) * {valley} * {edge})"
    d = f"(j/h - {top})"
    return f"{d} < 0 ? 0 : min(1, {d}/0.035) * (0.38 + 0.62*exp(-{d}/0.09))"


# ── Scene ─────────────────────────────────────────────────────────────────────
# magick argument builders shared by the wallpaper and the lockscreen, which
# render the same world (sky, ridge, acid horizon, floor grid).

def alpha_fx(expr: str, opacity: float, size: str, res: str = "512x256") -> list[str]:
    # Multiplies the current image's alpha by an -fx mask (i/w, j/h in
    # 0..1). The mask is evaluated on a small canvas (res) and scaled
    # up, since a per-pixel -fx over a 5K layer takes seconds.
    return ["(", "+clone", "-alpha", "extract",
            "(", "+clone", "-resize", f"{res}!", "-fx", expr, "-resize", f"{size}!", ")",
            "-compose", "Multiply", "-composite", "-evaluate", "multiply", str(opacity), ")",
            "-compose", "CopyOpacity", "-composite", "-compose", "Over"]


def glow(cw: int, ch: int, color: str, cx: float, cy: float, rx: float, ry: float,
         opacity: float, angle: float = 0) -> list[str]:
    # A soft elliptical light, optionally tilted (a light leak across the sky).
    k = 8  # blurred at 1/8 scale: a full-size blur this wide is slow on 5K
    return ["(", "-size", f"{cw}x{ch}", f"xc:{color}",
            "(", "-size", f"{cw // k}x{ch // k}", "xc:black", "-fill", "white",
            "-draw", f"translate {cx / k:.1f},{cy / k:.1f} rotate {angle} "
                     f"ellipse 0,0 {rx / k:.1f},{ry / k:.1f} 0,360",
            "-blur", f"0x{min(rx, ry) / k / 1.5:.1f}", "-resize", f"{cw}x{ch}!",
            "-evaluate", "multiply", str(opacity), ")",
            "-alpha", "off", "-compose", "CopyOpacity", "-composite", "-compose", "Over",
            ")", "-geometry", "+0+0", "-composite"]


def hline(cw: int, y: int, thick: int, blur: int, color: str, center: float,
          reach: float, opacity: float) -> list[str]:
    # A horizontal line whose alpha falls off away from `center` (0..1 of the width).
    lh = thick + 6 * blur + 2
    top = (lh - thick) // 2
    return ["(", "-size", f"{cw}x{lh}", "xc:none", "-fill", color,
            "-draw", f"rectangle 0,{top} {cw},{top + thick - 1}",
            *(["-channel", "RGBA", "-blur", f"0x{blur}", "+channel"] if blur else []),
            *alpha_fx(f"max(0, 1 - abs(i/w - {center:.3f}) / {reach})^1.6", opacity, f"{cw}x{lh}"),
            ")", "-geometry", f"+0+{y - lh // 2}", "-composite"]


def lattice(cw: int, ch: int, step: int, arm: int, thick: int, color: str,
            opacity: float) -> list[str]:
    c = step // 2
    return ["(", "-size", f"{step}x{step}", "xc:none", "-fill", color,
            "-draw", f"rectangle {c - arm},{c} {c + arm},{c + thick - 1}",
            "-draw", f"rectangle {c},{c - arm} {c + thick - 1},{c + arm}",
            "-write", "mpr:plus", "+delete", ")",
            # Tile into one full-width row first: magick's tile: is per
            # tile, so a small tile over a 5K canvas is very slow.
            "(", "-size", f"{cw}x{step}", "tile:mpr:plus", "-write", "mpr:row", "+delete", ")",
            "(", "-size", f"{cw}x{ch}", "tile:mpr:row",
            *alpha_fx("(1 - j/h)^1.4 * (0.35 + 0.65 * j/h)", opacity, f"{cw}x{ch}"),
            ")", "-geometry", "+0+0", "-composite"]


def scanlines(cw: int, ch: int, pitch: int, opacity: float) -> list[str]:
    return ["(", "-size", f"{cw}x{pitch}", "xc:none", "-fill", f"rgba(0,0,0,{opacity})",
            "-draw", f"rectangle 0,0 {cw},0", "-write", "mpr:scan", "+delete", ")",
            "(", "-size", f"{cw}x{ch}", "tile:mpr:scan", ")",
            "-geometry", "+0+0", "-composite"]


def scene_cmd(colors: dict[str, str], w: int, h: int, hy: int, ax: int, grid: Path) -> list[str]:
    """The ACID//HUD world as a magick command (no output file): sky, halftone
    mesh, "+" lattice, floor grid, dot-cloud ridge and the acid horizon, all
    lit around the axis ax. hy is the horizon row; grid caches the floor."""
    el = OUT / "elements"
    s = h / 1200  # design units: a 1200 px tall canvas

    def px(v: float) -> int:
        return round(v * s)

    cmd = [
        "magick",
        # Sky darkens upward from a lit horizon; the floor darkens toward the viewer.
        "(", "-size", f"{w}x{hy}", f"gradient:{colors['surface']}-{colors['surface_variant']}", ")",
        "(", "-size", f"{w}x{h - hy}", f"gradient:{colors['surface_variant']}-{colors['surface']}", ")",
        "-append",
        # Film grain: low-amplitude gaussian noise, greyscale.
        "(", "-size", f"{w}x{h}", "xc:gray50", "+noise", "Gaussian",
        "-colorspace", "gray", "-evaluate", "multiply", "0.05", ")",
        "-compose", "Plus", "-composite", "-compose", "Over",
    ]
    # Light. The liquid-glass panes over this scene blur and bend what is
    # under them, so the world needs soft, large, luminous shapes (a black
    # sky refracts into a grey box): a wide neutral haze and a layered acid
    # bloom on the horizon, a cool haze high in the right of the sky, a
    # floor glow at the lower left, and two tilted light leaks across the sky.
    cmd += glow(w, h, colors["on_surface"], ax, hy, w * 0.55, px(260), 0.07)
    cmd += glow(w, h, colors["primary"], ax, hy, w * 0.42, px(170), 0.18)
    cmd += glow(w, h, colors["primary"], ax, hy, w * 0.18, px(70), 0.22)
    cmd += glow(w, h, colors["on_surface"], w * 0.82, px(230), w * 0.20, px(150), 0.07)
    cmd += glow(w, h, colors["primary"], w * 0.16, h - px(170), w * 0.24, px(170), 0.16)
    cmd += glow(w, h, colors["on_surface"], w * 0.16, h - px(170), w * 0.16, px(120), 0.05)
    cmd += glow(w, h, colors["on_surface"], w * 0.38, px(330), w * 0.48, px(34), 0.05, -16)
    cmd += glow(w, h, colors["primary"], w * 0.64, px(250), w * 0.36, px(26), 0.07, -16)
    # Sky texture: the halftone mesh, barely there, thinning out toward the
    # horizon and around the overlay's clock ring (about 0.82 down the sky).
    cmd += ["(", str(el / "mesh-plane.png"), "-resize", f"{w}x{hy}^", "-gravity", "center",
            "-extent", f"{w}x{hy}", "+repage", "-gravity", "NorthWest",
            "-fill", colors["outline"], "-colorize", "100",
            *alpha_fx(f"(1 - j/h)^0.6 * (1 - 0.9*exp(-(((i/w - {ax / w:.3f}) * {w / hy:.3f})^2"
                      " + (j/h - 0.82)^2) / 0.12))", 0.6, f"{w}x{hy}"),
            ")", "-geometry", "+0+0", "-composite"]
    # Tactical lattice: "+" marks across the sky, fading out toward the horizon.
    cmd += lattice(w, hy, px(60), px(4), max(1, px(1)), colors["outline"], 0.55)
    # Floor: a procedural grid in outline that recedes toward the horizon,
    # then a neon pass in acid (bloom + sharp) in the band nearest the
    # horizon, so the far lines read as lit right under the ridge.
    floor_grid(w, h - hy, ax, 0.16, max(1.0, 1.6 * s), grid)
    cmd += ["(", str(grid), "-fill", colors["outline"], "-colorize", "100",
            *alpha_fx("0.45 + 0.55 * j/h", 1.0, f"{w}x{h - hy}"),
            ")", "-geometry", f"+0+{hy}", "-composite"]
    for blur, opacity in ((px(3), 0.35), (0, 0.30)):
        cmd += ["(", str(grid), "-fill", colors["primary"], "-colorize", "100",
                *(["-channel", "RGBA", "-blur", f"0x{blur}", "+channel"] if blur else []),
                *alpha_fx("exp(-((j/h-0.01)/0.09)^2) * exp(-((i/w-%.3f)/0.9)^2)" % (ax / w),
                          opacity, f"{w}x{h - hy}"),
                ")", "-geometry", f"+0+{hy}", "-composite"]
    # Horizon ridge: dot-cloud terrain cut to a mountain profile. A neutral
    # pass, then acid on the dots nearest the bloom, lit like the floor.
    rh = px(265)
    terrain = ["(", str(el / "terrain.png"), "-resize", f"{w}x",
               "-crop", f"{w}x{rh}+0+{round(w * 9 / 16 * 0.10)}", "+repage"]
    ridge = ridge_mask(ax / w)
    cmd += [*terrain, "-fill", colors["outline"], "-colorize", "100",
            *alpha_fx(ridge, 0.85, f"{w}x{rh}", "1024x256"),
            ")", "-geometry", f"+0+{hy - rh}", "-composite"]
    cmd += [*terrain, "-fill", colors["primary"], "-colorize", "100",
            *alpha_fx(f"({ridge}) * exp(-((i/w - {ax / w:.3f})/0.2)^2) * (j/h)^2.5",
                      0.75, f"{w}x{rh}", "1024x256"),
            ")", "-geometry", f"+0+{hy - rh}", "-composite"]
    # Horizon line: hairline plus bloom, brightest on the clock axis.
    cmd += hline(w, hy, max(1, px(1.5)), 0, colors["primary"], ax / w, 0.55, 0.9)
    cmd += hline(w, hy, px(6), px(10), colors["primary"], ax / w, 0.35, 0.5)
    return cmd


def build_wallpapers(colors: dict[str, str]) -> None:
    WALLPAPERS.mkdir(parents=True, exist_ok=True)
    el = OUT / "elements"
    for w, h in WALLPAPER_SIZES:
        s = h / 1200  # design units: a 1200 px tall canvas

        def px(v: float) -> int:
            return round(v * s)

        def layer(name: str, color: str, size: int | str, x: int, y: int, opacity: float,
                  rotate: float = 0, fade_up: bool = False) -> list[str]:
            geometry = size if isinstance(size, str) else f"{size}x{size}"
            # fade_up: alpha ramps from 45% at the top edge to full at the bottom,
            # so a floor plane recedes into the horizon yet still meets it.
            fade = ["(", "+clone", "-alpha", "extract", "(", "+clone", "-sparse-color",
                    "Barycentric", "0,0 gray45 %[fx:0],%[fx:h] white", ")",
                    "-compose", "Multiply", "-composite", ")",
                    "-compose", "CopyOpacity", "-composite", "-compose", "Over"] if fade_up else []
            return ["(", str(el / f"{name}.png"), "-resize", geometry,
                    "-fill", color, "-colorize", "100",
                    *(["-background", "none", "-rotate", str(rotate)] if rotate else []),
                    *fade,
                    "-channel", "A", "-evaluate", "multiply", str(opacity), "+channel",
                    ")", "-geometry", f"+{x}+{y}", "-composite"]

        # mt clears the floating Noctalia bar (~36 logical px incl. margin).
        m, t = px(28), max(1, px(1.5))
        mt = m + px(52)
        hy = px(655)  # horizon
        # The overlay's hero clock is centred (Layout.qml), so the horizon
        # bloom sits right under it like a sun on the grid.
        ax = round(w / 2)

        cmd = scene_cmd(colors, w, h, hy, ax, CACHE / f"floor-{w}x{h}.png")
        # Altimeter rulers on both frame edges, from under the header to the horizon.
        r0, r1, step = mt + px(110), hy - px(40), px(12)
        ticks = []
        for k, y in enumerate(range(r0, r1, step)):
            n = px(12) if k % 5 == 0 else px(5)
            ticks += [f"line {m},{y} {m + n},{y}", f"line {w - m},{y} {w - m - n},{y}"]
        cmd += ["-stroke", colors["outline"], "-strokewidth", str(max(1, px(1))),
                "-draw", " ".join(ticks), "-stroke", "none"]
        # Horizon read-outs where the line meets the frame.
        cmd += ["-font", MONO_FONT, "-pointsize", str(px(11)), "-fill", colors["on_surface_variant"],
                "-annotate", f"+{m + px(30)}+{hy - px(10)}", "HZN +000.0",
                "-annotate", f"+{w - m - px(30) - text_width('ALT 0x7F', MONO_FONT, px(11))}"
                             f"+{hy - px(10)}", "ALT 0x7F",
                # Vertical spine label down the right edge, reading top to bottom.
                "-fill", colors["on_surface_variant"],
                "-annotate", f"90x90+{w - m - px(24)}+{mt + px(120)}",
                "ACID//HUD  -  VECTOR FIELD 21-00  -  RENDER GRID ONLINE"]
        # Scanlines and vignette last, so they sit over every layer above.
        cmd += scanlines(w, h, max(2, px(3)), 0.22)
        cmd += ["(", "-size", f"{w}x{h}", "-define", "gradient:extent=farthest",
                "radial-gradient:rgba(0,0,0,0)-rgba(0,0,0,0.42)", ")", "-geometry", "+0+0", "-composite"]
        # Thin inset frame with acid corner ticks: only the sides are drawn, the
        # top and bottom hairlines read as stray lines under the bar and along
        # the screen edge.
        cmd += ["-fill", "none", "-stroke", colors["outline"], "-strokewidth", str(t),
                "-draw", f"line {m},{mt} {m},{h - m} line {w - m},{mt} {w - m},{h - m}",
                "-stroke", "none"]
        tick = px(36)
        for cx, cy, dx, dy in ((m, mt, 1, 1), (w - m, mt, -1, 1), (m, h - m, 1, -1), (w - m, h - m, -1, -1)):
            cmd += ["-fill", colors["primary"],
                    "-draw", f"rectangle {min(cx, cx + dx * tick)},{min(cy, cy + dy * px(3))} "
                             f"{max(cx, cx + dx * tick)},{max(cy, cy + dy * px(3))}",
                    "-draw", f"rectangle {min(cx, cx + dx * px(3))},{min(cy, cy + dy * tick)} "
                             f"{max(cx, cx + dx * px(3))},{max(cy, cy + dy * tick)}"]
        cmd += ["-font", MONO_FONT, "-pointsize", str(px(15)), "-fill", colors["on_surface_variant"],
                "-annotate", f"+{m + px(30)}+{mt + px(40)}", f"SYS://{USER_TAG}-HUD  ·  NODE 0x2100",
                "-fill", colors["outline"],
                "-annotate", f"+{m + px(30)}+{mt + px(64)}", "GRID 21-00-7F  //  LINK STABLE",
                # Same face, size and baseline as the left header, right-aligned to
                # mirror its inset.
                "-font", MONO_FONT, "-pointsize", str(px(15)), "-fill", colors["primary"],
                "-annotate", f"+{w - m - px(30) - text_width(f'{USER_TAG}//HUD', MONO_FONT, px(15))}"
                             f"+{mt + px(40)}", f"{USER_TAG}//HUD"]
        with staged(WALLPAPERS / f"hud-{w}x{h}.png") as tmp:
            run(*cmd, "-depth", "8", tmp)
    print(f"wallpapers: {len(WALLPAPER_SIZES)} in {WALLPAPERS}")


def text_width(text: str, font: str, size: int) -> int:
    """Advance width of a single-line string in px, as magick would draw it."""
    res = subprocess.run(["magick", "-font", font, "-pointsize", str(size), "label:" + text,
                          "-format", "%w", "info:"], capture_output=True, text=True, check=True)
    return int(res.stdout.strip())


# Longer than the acid theme's wallpaper transition_duration (900 ms).
WALLPAPER_SETTLE = 1.5


def reload_wallpapers() -> None:
    """Noctalia caches wallpapers by path, so re-setting the same file is a no-op.
    Bounce each output that shows a HUD wallpaper through another file and back,
    letting the first switch finish: an immediate switch back is coalesced into
    a no-op and the stale image stays."""
    if subprocess.run(["pgrep", "-x", "noctalia"], capture_output=True).returncode != 0:
        return
    try:
        monitors = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True,
                                             text=True, check=True).stdout)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError) as e:
        print(f"hud-build: cannot list outputs, wallpaper not reloaded: {e}", file=sys.stderr)
        return
    for mon in monitors:
        name = mon["name"]
        current = subprocess.run(["noctalia", "msg", "wallpaper-get", name],
                                 capture_output=True, text=True).stdout.strip()
        if not current.startswith(str(WALLPAPERS)):
            continue
        other = next((str(p) for p in sorted(WALLPAPERS.glob("hud-*.png")) if str(p) != current), None)
        if other is None:
            continue
        try:
            run("noctalia", "msg", "wallpaper-set", name, other)
            time.sleep(WALLPAPER_SETTLE)
        finally:
            # Always restore the original, even if the bounce failed half-way.
            run("noctalia", "msg", "wallpaper-set", name, current)
    print("wallpapers: reloaded in noctalia")


# Block characters that predate the Unicode 16 octants, keyed by the cell's
# bit pattern (bit n is octant n+1: top-left 1, top-right 2, ... bottom-right
# 128). Every other pattern is BLOCK OCTANT-* from U+1CD00 up, in pattern order.
OCTANT_LEGACY = {
    0x00: " ", 0xFF: "\u2588",
    0x0F: "\u2580", 0xF0: "\u2584", 0x55: "\u258C", 0xAA: "\u2590",
    0x05: "\u2598", 0x0A: "\u259D", 0x50: "\u2596", 0xA0: "\u2597",
    0xA5: "\u259A", 0x5A: "\u259E", 0x5F: "\u259B", 0xAF: "\u259C", 0xF5: "\u2599", 0xFA: "\u259F",
    0x01: "\U0001CEA8", 0x02: "\U0001CEAB", 0x40: "\U0001CEA3", 0x80: "\U0001CEA0",
    0x03: "\U0001FB82", 0xC0: "\u2582", 0x3F: "\U0001FB85", 0xFC: "\u2586",
    0x14: "\U0001FBE6", 0x28: "\U0001FBE7",
}


def octant_table() -> list[str]:
    table, next_cp = [], 0x1CD00
    for bits in range(256):
        char = OCTANT_LEGACY.get(bits)
        if char is None:
            char, next_cp = chr(next_cp), next_cp + 1
        table.append(char)
    if next_cp != 0x1CDE6:
        raise RuntimeError("octant table does not line up with U+1CD00..U+1CDE5")
    return table


def octant_art(mask: Path, cols: int) -> str:
    """Render an alpha mask as Unicode 16 octant characters (2x4 pixels per cell).

    Same technique as the Claude Code logo patch (claude-logo), so the two
    match. Only terminals that draw Symbols for Legacy Computing themselves
    (Ghostty) show these; fonts rarely carry them.
    """
    width = cols * 2
    with tempfile.TemporaryDirectory(prefix="hud-oct-") as td:
        pgm = Path(td) / "m.pgm"
        run("magick", mask, "-alpha", "extract", "-trim", "+repage", "-resize", f"{width}x",
            "-threshold", "45%", "-compress", "none", pgm)
        tokens = pgm.read_text().split()
    # P2 header: magic, width, height, maxval, then pixel values.
    height, maxval = int(tokens[2]), int(tokens[3])
    px = [int(v) > maxval // 2 for v in tokens[4:]]
    # Pad the height to whole cells with the art centred.
    rows = -(-height // 4) * 4
    top = (rows - height) // 2

    def on(x: int, y: int) -> bool:
        y -= top
        return 0 <= y < height and px[y * width + x]

    table = octant_table()
    lines = []
    for cy in range(0, rows, 4):
        line = []
        for cx in range(0, width, 2):
            bits = 0
            for r in range(4):
                for c in range(2):
                    bits |= on(cx + c, cy + r) << (r * 2 + c)
            line.append(table[bits])
        lines.append("".join(line))  # equal widths keep centred dashboards aligned
    return "\n".join(lines)


# ── Lockscreen ────────────────────────────────────────────────────────────────
# One layout drives both the static art (rendered here into one pixel-exact PNG
# per output) and the live Noctalia widgets on top of it (`--lock-layout` prints
# their TOML for noctalia's themes/acid.toml), so the two can never drift apart.
#
# Coordinates are design units: u = output height / 800, x is measured from the
# horizontal centre, y from the top edge.
# Keys are noctalia output selectors: a connector name, or a whole token of the
# monitor's description (model or serial). External monitors must be keyed by
# identity, not connector: the dock's DP-2 carries either the Dell or the BenQ,
# and when a widget's output changes size noctalia scales cx/cy proportionally
# (box sizes stay put), which pulls the side graphs off the static panels.
# Every monitor that locks needs an entry here; an unlisted one only gets
# noctalia's default login box. `hyprctl monitors` shows the description.
# Geometry and scale must match hyprland/.config/hypr/monitors.lua: the static
# layer and the reticle animation are rendered at physical size, so a low scale
# leaves them upscaled (soft) on that output.
LOCK_OUTPUTS = {  # logical width, height and scale of each output that locks
    "eDP-1": (1280, 800, 1.5),       # laptop panel
    "U4025QW": (2560, 1080, 2.0),    # Dell U4025QW ultrawide, on DP-2 or DP-4
    "ZOWIE": (1920, 1080, 1.0),      # BenQ ZOWIE XL, on DP-2
}
# Monitors missing from LOCK_OUTPUTS are added per machine by `--lock-sync`
# when they are first connected: their geometry is recorded in LOCK_AUTO and
# the whole layout (the outputs above plus those) is written to LOCK_LOCAL.
# Noctalia merges its config files by name and the last one wins an array
# (widget_order), hence the zz- prefix: it has to come after theme.toml.
# Neither file belongs in the repo: they describe this machine's monitors.
LOCK_AUTO = STATE / "hud/lock-outputs.json"
LOCK_LOCAL = NOCTALIA_CONFIG / "zz-hud-lock.toml"
# The core composition fits the narrowest output (16:10, ±640 u); wider ones
# show more of the scene, and the edge chrome follows the frame.
LOCK_FRAME = 19                  # frame inset
LOCK_HORIZON = 455               # horizon row of the scene
LOCK_TAG_Y = 112                 # "SYS//LOCKED" plate
LOCK_CLOCK = (0, 226, 560, 280)  # hero clock box: x, y, w, h (the box scales the text)
LOCK_SECONDS = (224, 266, 64, 34)
LOCK_RULER_Y = 336               # tick rail under the clock
LOCK_DATE_Y = 358
# The date row is two clock widgets flanking a static acid separator at x=0,
# right under the ruler's arrow, so the pivot of the row always sits on the
# centre line (one centred "date · week" string put the dot 20 u off it, the
# date being longer than the week). A 16 u clock box sets Departure Mono at
# 8 u per glyph: 8-char date, 3-char week, two blanks on each side of the dot.
LOCK_DATE_X = (-52, 32)          # centres of the date and the week text
LOCK_RETICLE = 26                # rotating acid reticle beside the plate
LOCK_RETICLE_X = -134
LOCK_BANK_X = 455                # telemetry card columns at ±x
LOCK_BANK_Y = 205                # top of the first card
# Card width, height, vertical gap. Noctalia's graph is a fixed ~180x100 block
# scaled to fit its box, so the cards are about that shape to fill with it.
LOCK_CARD = (170, 120, 12)
LOCK_LOGIN = (0, 676, 480, 72)   # login box: x, y, w, h (password field only: noctalia's minimum is 70 tall)
# Telemetry cards, top to bottom per bank: (side, caption, stat, stat2). Desktop
# sysmon widgets cannot show disk stats, and gpu_usage polls the RTX 3050
# through NVML, which wakes it from runtime suspend every few seconds.
LOCK_STATS = (
    (-1, "CPU LOAD", "cpu_usage", None),
    (-1, "CPU CLOCK", "cpu_freq", None),
    (-1, "MEMORY", "ram_pct", None),
    (1, "CORE TEMP", "cpu_temp", None),
    (1, "LINK RX/TX", "net_rx", "net_tx"),
    (1, "SWAP", "swap_pct", None),
)


def lock_cards():
    """(index, side, caption, stat, stat2, x0, y0, x1, y1) per telemetry card, in u."""
    cw, ch, gap = LOCK_CARD
    rows = {-1: 0, 1: 0}
    for i, (side, caption, stat, stat2) in enumerate(LOCK_STATS):
        row = rows[side]
        rows[side] += 1
        y0 = LOCK_BANK_Y + row * (ch + gap)
        x0 = side * LOCK_BANK_X - cw / 2
        yield i + 1, side, caption, stat, stat2, x0, y0, x0 + cw, y0 + ch


def scope_trace(color: str, braid: bool, dst: Path, w: int = 1024, h: int = 128) -> None:
    """A horizontally tileable trace: every component completes a whole number
    of cycles across the width, so copies placed end to end join without a seam.

    braid: a bold carrier whose amplitude breathes once per tile, trailed by
    a faint phase-shifted echo. Otherwise a slow carrier with a light harmonic.
    """
    tau, mid = 2 * math.pi, h / 2

    def strand(fn) -> str:
        pts = " ".join(f"{x},{mid + fn(x / w):.2f}" for x in range(-4, w + 5, 2))
        return f"polyline {pts}"

    if braid:
        amp = lambda t: h * 0.38 * (0.8 + 0.2 * math.cos(tau * t))
        layers = [(color + "66", 4, strand(lambda t: 0.7 * amp(t) * math.sin(tau * (4 * t - 0.18)))),
                  (color, 7, strand(lambda t: amp(t) * math.sin(tau * 4 * t)))]
    else:
        layers = [(color, 4, strand(lambda t: h * 0.3 * math.sin(tau * 2 * t)
                                    + h * 0.05 * math.sin(tau * 11 * t)))]
    draw = []
    for col, width, path in layers:
        draw += ["-stroke", col, "-strokewidth", str(width), "-draw", path]
    run("magick", "-size", f"{w}x{h}", "xc:none", "-fill", "none", *draw, dst)


def clock_face(px: int, color: str, dst: Path) -> None:
    """The overlay clock's face, drawn procedurally so it is exactly concentric
    (the stock rings are hand-drawn and lopsided by a few percent):
    a minute track with 60 ticks (major every 5), four equal arcs on the
    diagonals, and a fine inner circle. RingStack.qml's seconds needle rides
    the tick track, at FACE_TRACK of the canvas."""
    c = px / 2
    draws = []
    for i in range(60):
        major = i % 5 == 0
        a = math.radians(i * 6)
        r1 = px * (0.405 if major else 0.43)
        r2 = px * 0.46
        draws += ["-strokewidth", f"{px * (0.009 if major else 0.004):.2f}", "-draw",
                  f"line {c + r1 * math.sin(a):.2f},{c - r1 * math.cos(a):.2f} "
                  f"{c + r2 * math.sin(a):.2f},{c - r2 * math.cos(a):.2f}"]
    ra = px * 0.36
    arcs = []
    for mid in (45, 135, 225, 315):
        # magick arc angles: degrees clockwise from +x.
        arcs += ["-draw", f"arc {c - ra:.2f},{c - ra:.2f} {c + ra:.2f},{c + ra:.2f} "
                          f"{mid - 90 - 28} {mid - 90 + 28}"]
    run("magick", "-size", f"{px}x{px}", "xc:none", "-stroke", color, "-fill", "none", *draws,
        "-strokewidth", f"{px * 0.012:.2f}", *arcs,
        "-strokewidth", f"{px * 0.003:.2f}",
        "-draw", f"circle {c},{c} {c + px * 0.33},{c}",
        "-draw", f"circle {c},{c} {c + px * 0.475},{c}", dst)


def reticle_box(w: int, h: int, scale: float) -> tuple[int, int, int]:
    """The reticle's box on an output in physical px: left, top, size. Whole
    pixels and an even size, so Noctalia draws the GIF texel for texel (a
    half-pixel box is resampled and goes soft)."""
    k = h / 800 * scale
    size = 2 * round(LOCK_RETICLE * k / 2)
    left = round(w * scale / 2 + LOCK_RETICLE_X * k - size / 2)
    top = round(LOCK_TAG_Y * k - size / 2)
    return left, top, size


def bake_reticle(ring: Path, scene: Path, left: int, top: int, size: int, dst: Path) -> None:
    """The reticle's frames, side by side in one PNG strip: the acid ring as
    a stepper (8° every 0.4 s, 18 s per turn; the overlay's LockWidgets.qml
    shows one frame at a time, RETICLE_FRAMES there). Each frame is composited
    over the static scene's own pixels at the box, so the overlay can draw it
    opaque. `ring` is oversized, so the rotation is smoothed when each frame
    is finished at `size`. (A strip, not a GIF: Qt's GIF player crashed the
    overlay with an endless recursion while stepping frames.)"""
    frames = 45
    frame_args: list[str] = []
    for i in range(frames):
        frame_args += ["(", "mpr:scene", "(", str(ring), "-distort", "SRT", f"{i * 8:.3f}",
                       "-filter", "Lanczos", "-resize", f"{size}x{size}!", ")",
                       "-compose", "Over", "-composite", ")"]
    with staged(dst) as tmp:
        run("magick", "(", str(scene), "-crop", f"{size}x{size}+{left}+{top}", "+repage",
            "-write", "mpr:scene", "+delete", ")", *frame_args, "+append", "-depth", "8", tmp)


def build_shaders() -> None:
    """Qt shader packs of the overlay's GLSL (UnlockFold.qml loads overlay/<name>.qsb)."""
    d = OUT / "overlay"
    d.mkdir(parents=True, exist_ok=True)
    if not Path(QSB).exists():
        print("shaders: qsb not found (pacman -S qt6-shadertools), skipped")
        return
    sources = sorted(SHADERS.glob("*.frag")) + sorted(SHADERS.glob("*.vert"))
    for src in sources:
        with staged(d / f"{src.name}.qsb") as tmp:
            run(QSB, "--glsl", "300es,100es,150,120,330", "-o", tmp, src)
    print(f"shaders: {len(sources)} compiled")


def is_virtual(name: str) -> bool:
    """Headless outputs (claude-shot's CLAUDE*, `hyprctl output create`): they
    are not monitors anyone locks (hyprland/.config/hypr/workspaces.lua)."""
    return name.startswith(("CLAUDE", "HEADLESS-"))


def connected_outputs() -> list[dict]:
    """The connected monitors: connector, description, model, the logical
    width, height and scale as LOCK_OUTPUTS states them, and the panel's own
    mode in device pixels (`native`: unscaled and unrotated)."""
    try:
        monitors = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True,
                                             text=True, check=True).stdout)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError) as e:
        print(f"hud-build: cannot list outputs: {e}", file=sys.stderr)
        return []
    outputs = []
    for mon in monitors:
        if is_virtual(mon["name"]):
            continue
        scale = round(float(mon.get("scale", 1)), 3)
        w, h = mon["width"], mon["height"]
        if int(mon.get("transform", 0)) % 2:  # rotated by 90 or 270 degrees
            w, h = h, w
        outputs.append({"name": mon["name"], "description": mon.get("description", ""),
                        "model": mon.get("model", ""), "geometry": (round(w / scale), round(h / scale), scale),
                        "native": (mon["width"], mon["height"])})
    return outputs


def lock_key(mon: dict) -> str:
    """The LOCK_OUTPUTS key that selects this monitor, as Noctalia matches an
    output selector (the connector, or a whole word of the description). For a
    monitor not listed there: the longest word of its model, which names the
    same monitor on any connector, else the connector."""
    words = mon["description"].split()
    for key in LOCK_OUTPUTS:
        if key == mon["name"] or key in words:
            return key
    # Only words that are safe in a file name and a TOML key.
    words = [t for t in mon["model"].split() if re.fullmatch(r"[A-Za-z0-9_-]+", t)]
    return max(words, key=len) if words else mon["name"]


def load_lock_auto() -> dict[str, tuple[int, int, float]]:
    try:
        return {k: (int(w), int(h), float(sc)) for k, (w, h, sc) in json.loads(LOCK_AUTO.read_text()).items()
                if k not in LOCK_OUTPUTS}
    except (OSError, ValueError, TypeError):
        return {}


def lock_outputs() -> dict[str, tuple[int, int, float]]:
    """Every output with a lock layout: LOCK_OUTPUTS and this machine's own."""
    return {**LOCK_OUTPUTS, **load_lock_auto()}


def render_lock_output(colors: dict[str, str], name: str, w: int, h: int, scale: float) -> None:
    d = OUT / "lock"
    d.mkdir(parents=True, exist_ok=True)
    static = d / f"static-{name}.png"
    render_lock_static(colors, w, h, scale, static, lock_backdrop_image(name))
    # The reticle rides on this output's scene, at 4x for the rotation.
    left, top, size = reticle_box(w, h, scale)
    with tempfile.TemporaryDirectory(prefix="hud-lock-") as td:
        ring = Path(td) / f"ring-{name}.png"
        tint(OUT / "elements" / "ring-07.png", colors["primary"], size * 4, ring)
        bake_reticle(ring, static, left, top, size, d / f"reticle-{name}.png")


def build_lock(colors: dict[str, str]) -> None:
    d = OUT / "lock"
    for name, (w, h, scale) in lock_outputs().items():
        render_lock_output(colors, name, w, h, scale)
    render_lock_backdrop(colors, d / "backdrop.png")
    # Layers of the previous ring-instrument layout.
    for stale in ("dial.gif", "ring-acid.gif", "reticle.gif", "reticle.webp"):
        (d / stale).unlink(missing_ok=True)
    for stale in d.glob("reticle-*.gif"):  # the GIF steppers the strips replaced
        stale.unlink()
    LOCK_BACKDROP_STAMP.write_text(lock_backdrop_key())
    print(f"lock: {len(lock_outputs())} reticle strips, scenes, backdrop")


def drop_lock_tables(path: Path) -> None:
    """Remove the [lockscreen_widgets...] tables from a Noctalia state file.
    Noctalia copies the lock layout into its state, which then beats the
    config, so a new layout only applies once that copy is gone."""
    try:
        text = path.read_text()
    except OSError:
        return
    # A table header: bare or quoted key parts (a quoted one may hold spaces),
    # nothing else on the line but a comment. Anything else belongs to the
    # table above it.
    part = r'(?:[A-Za-z0-9_-]+|"[^"]*")'
    header = re.compile(rf'\s*\[\[?\s*({part}(?:\s*\.\s*{part})*)\s*\]\]?\s*(?:#.*)?$')
    kept, dropping = [], False
    for line in text.splitlines(keepends=True):
        m = header.match(line)
        if m:
            dropping = m.group(1) == "lockscreen_widgets" or m.group(1).startswith("lockscreen_widgets.")
        if not dropping:
            kept.append(line)
    result = "".join(kept)
    try:
        tomllib.loads(result)
    except tomllib.TOMLDecodeError as e:
        # Better the old layout than a state file Noctalia cannot read.
        print(f"hud-build: {path} not rewritten, the result would not parse: {e}", file=sys.stderr)
        return
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(result)
    shutil.copymode(path, tmp)
    tmp.replace(path)


def noctalia_running() -> bool:
    return subprocess.run(["pgrep", "-x", "noctalia"], capture_output=True).returncode == 0


def session_locked() -> bool:
    """Whether Noctalia holds the session lock. No answer from a running
    Noctalia counts as locked: this guards a restart that would take the lock
    surface down."""
    if not noctalia_running():
        return False
    try:
        status = subprocess.run(["noctalia", "msg", "status"], capture_output=True, text=True, timeout=5)
        return json.loads(status.stdout)["locked"] is not False
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError):
        return True


def apply_lock_layout(layout: str | None) -> bool:
    """Write the machine's lock layout (None: remove it) and make Noctalia
    take the layout from its config again: stop it, drop the copy in its state
    (and in the theme switcher's snapshot, which would bring the old one back
    on the next switch), start it. False when nothing was changed."""
    running = noctalia_running()
    if running:
        if session_locked():
            return False
        subprocess.run(["pkill", "-x", "noctalia"])
        for _ in range(50):
            if not noctalia_running():
                break
            time.sleep(0.1)
        else:
            print("hud-build: noctalia did not stop, lock layout not applied", file=sys.stderr)
            return False
    try:
        # Written in place: a temp file beside it would be one more *.toml
        # for Noctalia to merge, and Noctalia is down here anyway.
        if layout is None:
            LOCK_LOCAL.unlink(missing_ok=True)
        else:
            LOCK_LOCAL.parent.mkdir(parents=True, exist_ok=True)
            LOCK_LOCAL.write_text(layout)
        drop_lock_tables(STATE / "noctalia/settings.toml")
        drop_lock_tables(STATE / "dotfiles/noctalia-acid.toml")
    finally:
        if running:
            # Started by Hyprland, like the autostart one, so it does not die
            # with whatever ran this.
            started = subprocess.run(["hyprctl", "eval", 'hl.exec_cmd("noctalia")'], capture_output=True, text=True)
            if started.returncode != 0 or "error" in started.stdout:
                print(f"hud-build: could not restart noctalia, start it by hand: {started.stdout.strip()}",
                      file=sys.stderr)
    return True


def lock_sync(colors: dict[str, str]) -> None:
    """Bring the lock and the bar up to the monitors that are connected now:
    render the lock art of one LOCK_OUTPUTS does not list, add its widgets to
    the layout, and build the bar's device-resolution sets for a new scale.
    Also re-render the lock art when the wallpaper under it has changed."""
    try:
        acid = (STATE / "dotfiles/theme").read_text().strip() != "classic"
    except OSError:
        acid = True
    if not acid:
        return
    auto = load_lock_auto()
    new = {}
    for mon in connected_outputs():
        key = lock_key(mon)
        if key in LOCK_OUTPUTS:
            continue
        if key in new and new[key] != mon["geometry"]:
            # Two monitors of one model at different sizes share a key (and a
            # Noctalia selector): the first one keeps the layout.
            print(f"hud-build: {mon['name']} shares the lock key {key} with another monitor, left as is",
                  file=sys.stderr)
            continue
        if auto.get(key) != mon["geometry"] or not (OUT / "lock" / f"static-{key}.png").exists():
            new[key] = mon["geometry"]
    auto.update(new)
    layout = ("# GENERATED by `hud-build --lock-sync` for the monitors of this machine that\n"
              "# themes/acid.toml does not list; it replaces that file's lock layout.\n\n"
              + lock_layout_toml({**LOCK_OUTPUTS, **auto})) if auto else None
    try:
        current = LOCK_LOCAL.read_text()
    except OSError:
        current = None
    scales = [sc for sc in output_scales() if not (OUT / "bar/ws" / f"{sc:g}").is_dir()]
    backdrops = lock_backdrop_key()
    try:
        repaint = LOCK_BACKDROP_STAMP.read_text() != backdrops
    except OSError:
        repaint = True
    if not new and layout == current and not scales and not repaint:
        return
    if session_locked():
        # Restarting Noctalia would take the lock surface down with it; the
        # unlock hook runs this again.
        print("hud-build: session locked, lock sync left for the unlock")
        return
    for key, (w, h, scale) in new.items():
        render_lock_output(colors, key, w, h, scale)
        print(f"lock: art for {key} ({w}x{h} @{scale:g})")
    if repaint:
        # The wallpaper is baked into every scene, so all of them go again.
        for key, (w, h, scale) in lock_outputs().items():
            if key not in new:
                render_lock_output(colors, key, w, h, scale)
        render_lock_backdrop(colors, OUT / "lock" / "backdrop.png")
        LOCK_BACKDROP_STAMP.write_text(backdrops)
        print("lock: art rebuilt on the current wallpaper")
    if new or repaint:
        bump_overlay_version(colors)  # the overlay holds the old art (or none, for a new monitor)
        LOCK_AUTO.parent.mkdir(parents=True, exist_ok=True)
        with staged(LOCK_AUTO) as tmp:
            Path(tmp).write_text(json.dumps(auto, indent=2) + "\n")
    if layout != current and apply_lock_layout(layout):
        print(f"lock: layout for {', '.join({**LOCK_OUTPUTS, **auto})}")
    if scales:
        build_bar(colors)
        # The bar widgets pick their set when they load.
        if noctalia_running():
            subprocess.run(["noctalia", "msg", "config-reload"], capture_output=True)


def shown_wallpapers() -> dict[str, Path]:
    """What Noctalia shows right now on each connected output, by lock key.
    Asked from Noctalia itself rather than read from its state file, which is
    keyed by connector and may not be written yet when its wallpaper hook
    runs. Asked once per run."""
    global _shown_wallpapers
    if _shown_wallpapers is None:
        _shown_wallpapers = {}
        for mon in connected_outputs() if noctalia_running() else ():
            try:
                got = subprocess.run(["noctalia", "msg", "wallpaper-get", mon["name"]],
                                     capture_output=True, text=True, timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                continue
            if got.returncode == 0 and got.stdout.strip():
                _shown_wallpapers.setdefault(lock_key(mon), Path(got.stdout.strip()))
    return _shown_wallpapers


_shown_wallpapers: dict[str, Path] | None = None


def lock_backdrop_image(output: str) -> Path | None:
    """The picture Noctalia shows on `output` (a lock key; "" for no output in
    particular), when it is the user's own rather than a HUD render: the lock
    scene is then built on it, so the lock matches the desktop. None means the
    HUD world. An output that is not connected takes the picture of one that
    is, else the last one Noctalia's state file records."""
    shown = shown_wallpapers()
    path = shown.get(output) or next(iter(shown.values()), None)
    if path is None:
        state = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "noctalia/settings.toml"
        try:
            wallpaper = tomllib.loads(state.read_text()).get("wallpaper", {})
        except (OSError, tomllib.TOMLDecodeError):
            return None
        path = Path((wallpaper.get("last") or {}).get("path", "")).expanduser()
    if not path.is_file() or path.is_relative_to(WALLPAPERS):
        return None
    return path


# What the lock art on disk was built on, to tell when a wallpaper change has
# left it behind (`--lock-sync`, from Noctalia's wallpaper_changed hook).
LOCK_BACKDROP_STAMP = CACHE / "lock-backdrop.stamp"


def lock_backdrop_key() -> str:
    """The picture under each output's lock scene and under backdrop.png, with
    its mtime: a file replaced under the same name counts as a change."""
    def ident(image: Path | None) -> list | None:
        return [str(image), image.stat().st_mtime_ns] if image else None
    return json.dumps({name: ident(lock_backdrop_image(name)) for name in ("", *lock_outputs())}, sort_keys=True)


def lock_scene(colors: dict[str, str], w: int, h: int, image: Path | None = None) -> list[str]:
    """The backdrop under the lock UI, with scanlines and vignette (w, h in
    physical px): the user's wallpaper, cover-cropped and darkened, or the
    HUD world, horizon centred."""
    if image is not None:
        cmd = ["magick", str(image), "-resize", f"{w}x{h}^", "-gravity", "center",
               "-extent", f"{w}x{h}", "+repage", "-gravity", "NorthWest",
               # ~40 % darker, then a soft dark pool behind the clock and date
               # rows (LOCK_CLOCK..LOCK_DATE_Y): they must read over neon signs.
               "-fill", colors["surface"] + "66", "-draw", f"rectangle 0,0 {w},{h}"]
        cmd += glow(w, h, colors["surface"], w / 2, h * 300 / 800, w * 0.30, h * 0.17, 0.55)
    else:
        hy = round(h * LOCK_HORIZON / 800)
        cmd = scene_cmd(colors, w, h, hy, round(w / 2), CACHE / f"lock-floor-{w}x{h}.png")
        cmd += ["-fill", colors["surface"] + "4d", "-draw", f"rectangle 0,0 {w},{h}"]  # ~30 % darker
    cmd += scanlines(w, h, max(2, round(h / 400)), 0.22)
    cmd += ["(", "-size", f"{w}x{h}", "-define", "gradient:extent=farthest",
            "radial-gradient:rgba(0,0,0,0)-rgba(0,0,0,0.6)", ")", "-geometry", "+0+0", "-composite",
            # The canvas still carries the sky gradient's page geometry, which
            # would make -gravity center measure from the sky band's middle.
            "+repage"]
    return cmd


def render_lock_backdrop(colors: dict[str, str], dst: Path) -> None:
    """The scene alone at 16:9: shown during the lock transition and on outputs
    missing from LOCK_OUTPUTS (Noctalia cover-crops it)."""
    with staged(dst) as tmp:
        run(*lock_scene(colors, 3840, 2160, lock_backdrop_image("")), "-depth", "8", tmp)


# The light on a glass pane: the cool white of the desktop panes
# (quickshell/hud/GlassScene.qml) and of the hyprglass tints.
GLASS_LIGHT = "#dce6f0"


def glass_map(w: int, h: int, r: float, scale: float) -> tuple[Path, Path, float]:
    """Per-pixel maps for a w x h px rounded rectangle of radius r: the glass
    of the desktop's bottom panes, which hyprglass and shaders/pane.frag
    render live and the lock has to carry baked (hyprglass never touches a
    session lock surface). Cached by geometry.

    The first (PPM) is the lens, in R and G (50 % grey = none, full scale =
    the rim's width, which is returned with the two paths), as hyprglass
    bends the backdrop with preset acid_pane (hyprland/plugins.lua): the rim
    is a convex glass wall, a quarter ellipse 22 px wide and 14 px tall,
    upright at the edge and flat from its inner side on. An eye ray straight
    down refracts where it enters the wall (Snell's law, index 1.5) and runs
    on through the glass, so the rim shows what lies further in, squeezed
    towards the edge; past the rim nothing is bent.

    The second (PAM, with alpha) is the pane's light, laid over the body:
    pane.frag's formulas, in logical px (`scale` physical px each). The pane
    shows by its edge alone: a crisp line with a short tail, lit from the
    upper left (the top edge brightest towards the left corner, the bottom
    edge about half of it and towards the right one, the sides a fraction),
    and a faintly darker band just inside it that gives the edge thickness.
    Hyprglass adds a soft specular tail along the top edge (measured on the
    desktop: about a tenth of the light, fading over 5 px) and a trace of
    it all round."""
    CACHE.mkdir(parents=True, exist_ok=True)
    wall, tall, ior = 22 * scale, 14 * scale, 1.5
    gain = 2.6 / 0.6  # refraction_strength over the plugin's reference
    stem = f"pane-{w}x{h}-{r:g}-{scale:g}"
    lens, light = CACHE / f"{stem}-lens.ppm", CACHE / f"{stem}-light.pam"
    if lens.exists() and light.exists():
        return lens, light, wall
    rim, shade, sheen, fresnel = 0.55, 0.10, 0.08, 0.02
    lr, lg, lb = (int(GLASS_LIGHT[i:i + 2], 16) for i in (1, 3, 5))
    hw, hh = w / 2 - r, h / 2 - r
    cxp, cyp = w / 2 - 0.5, h / 2 - 0.5
    lens_data = bytearray(f"P6\n{w} {h}\n255\n".encode())
    light_data = bytearray(f"P7\nWIDTH {w}\nHEIGHT {h}\nDEPTH 4\nMAXVAL 255\n"
                           "TUPLTYPE RGB_ALPHA\nENDHDR\n".encode())
    for y in range(h):
        qy = abs(y - cyp) - hh
        for x in range(w):
            qx = abs(x - cxp) - hw
            if qx > 0 and qy > 0:  # corner: radial
                n = math.hypot(qx, qy)
                d = n - r
                nx, ny = qx / n, qy / n
            elif qx > qy:  # a side
                d, nx, ny = qx - r, 1.0, 0.0
            else:  # top or bottom
                d, nx, ny = qy - r, 0.0, 1.0
            inside = max(0.0, -d)  # px from the edge, inward
            f = 0.0
            if inside < wall:
                e = 1 - inside / wall  # 1 at the edge, 0 at the wall's inner side
                rise = math.sqrt(1 - e * e)
                # The wall's surface normal as (inward, up), and the ray
                # (0, -1) refracted into the glass there.
                ni, nu = -e / wall, rise / tall
                norm = math.hypot(ni, nu)
                ni, nu = ni / norm, nu / norm
                eta = 1 / ior
                refr = eta * nu - math.sqrt(1 - eta * eta * (1 - nu * nu))
                ray_in, ray_down = refr * ni, eta - refr * nu
                run = tall * rise * ray_in / max(ray_down, 1e-3)
                f = math.tanh(gain * run / wall)  # of the wall's width, inwards
            sx = -math.copysign(nx * f, x - cxp)
            sy = -math.copysign(ny * f, y - cyp)
            lens_data += bytes((round(128 + 127 * sx), round(128 + 127 * sy), 0))

            t = inside / scale
            up, down = (ny, 0.0) if y < cyp else (0.0, ny)
            across = (x + 0.5) / w
            caught = (0.20 + 0.80 * up ** 1.5 * (1 - 0.45 * across)
                      + 0.50 * down ** 1.5 * (0.45 + 0.55 * across))
            wide = math.exp(-t / 5)
            a = min(1.0, rim * caught * (math.exp(-t / 1.1) + 0.16 * wide)
                    + (sheen * up + fresnel) * wide)
            s = shade * math.exp(-((t - 6) / 3.5) ** 2)
            cover = min(1.0, max(0.0, 0.5 - d))
            alpha = a + s * (1 - a)  # the light over the (black) shade
            lit = a / alpha if alpha > 0 else 0.0
            light_data += bytes((round(lr * lit), round(lg * lit), round(lb * lit),
                                 round(255 * alpha * cover)))
    lens.write_bytes(lens_data)
    light.write_bytes(light_data)
    return lens, light, wall


def glass_pane(px0: int, py0: int, gw: int, gh: int, scale: float) -> list[str]:
    """ImageMagick arguments that turn the gw x gh px box at (px0, py0) of
    the canvas drawn so far into a liquid-glass pane, the same glass as the
    desktop's bottom panes (measured on them, over the same picture): what
    is behind is bent at the rim like a lens edge and softly blurred, the
    body keeps its brightness but for a breath of frost (nine tenths of the
    backdrop plus 5 % of the light: any more reads as milk), the corners
    are the toasts' 18 px, and the edge carries the light (glass_map)."""
    r = round(18 * scale)
    lens, light, reach = glass_map(gw, gh, r, scale)
    return [
        "-gravity", "NorthWest",
        "(", "+clone", "-crop", f"{gw}x{gh}+{px0}+{py0}", "+repage",
        "(", str(lens), ")",
        "-set", "option:compose:args", f"{reach:.1f}x{reach:.1f}", "-compose", "Displace", "-composite",
        "-blur", f"0x{2 * scale:.1f}",
        "-channel", "RGB", "-evaluate", "multiply", "0.94", "+channel",
        "-fill", GLASS_LIGHT, "-colorize", "5",
        "(", "-size", f"{gw}x{gh}", "xc:none", "-fill", "white", "-stroke", "none",
        "-draw", f"roundrectangle 0,0 {gw - 1},{gh - 1} {r},{r}", ")",
        "-compose", "DstIn", "-composite",
        "(", str(light), ")", "-compose", "Over", "-composite",
        ")", "-geometry", f"+{px0}+{py0}", "-compose", "Over", "-composite",
    ]


def fold_glass(colors: dict[str, str], pw: int, ph: int) -> list[str]:
    """The glass sheet the unlock fold parts, as it lights the lock scene
    before anything moves (quickshell/hud/shaders/fold.frag): two faint light
    bands leaning across the screen, at xs = x + 0.1 y (screen widths from
    the centre, y up) equal to +-0.23, as a light above and to one side would
    throw them. Baked into the lock art so the lock screen already is that
    sheet and the fold's first frame is the lock to the pixel; the shader
    draws no bands of its own, only the seam that then splits the sheet.
    Same formulas as the shader; the bands are far smoother than an 1/8
    map's sample spacing, so that is scaled up."""
    def rgb(c: str) -> tuple[float, float, float]:
        return tuple(int(c[i:i + 2], 16) / 255 for i in (1, 3, 5))

    def mix(a, b, t: float):
        return tuple(x + (y - x) * t for x, y in zip(a, b))

    white = (1.0, 1.0, 1.0)
    veil = mix(rgb(colors["on_surface_variant"]), rgb(colors["on_surface"]), 0.35)
    band_c = mix(white, veil, 0.5)
    core_c = mix(white, rgb(colors["tertiary"]), 0.3)
    CACHE.mkdir(parents=True, exist_ok=True)
    sw, sh = max(1, pw // 8), max(1, ph // 8)
    dst = CACHE / ("fold-bands-" + "-".join(
        [f"{pw}x{ph}"] + [colors[k][1:] for k in ("tertiary", "on_surface", "on_surface_variant")]) + ".ppm")
    if not dst.exists():
        # 16-bit: the bands are faint and smooth, 8 bits would band them.
        data = bytearray(f"P6\n{sw} {sh}\n65535\n".encode())
        for j in range(sh):
            y = (0.5 - (j + 0.5) / sh) * ph / pw
            for i in range(sw):
                xs = (i + 0.5) / sw - 0.5 + 0.1 * y
                d1, d2 = xs - 0.23, xs + 0.23
                band = math.exp(-d1 * d1 / 0.0020) + math.exp(-d2 * d2 / 0.0020)
                core = math.exp(-d1 * d1 / 0.00015) + math.exp(-d2 * d2 / 0.00015)
                for b, c in zip(band_c, core_c):
                    v = band * 0.07 * b + core * 0.05 * c
                    data += round(65535 * min(1.0, max(0.0, v))).to_bytes(2, "big")
        dst.write_bytes(data)
    return ["-gravity", "NorthWest",
            "(", str(dst), "-filter", "Catrom", "-resize", f"{pw}x{ph}!", ")",
            "-compose", "Plus", "-composite", "-compose", "Over"]


def render_lock_static(colors: dict[str, str], w: int, h: int, scale: float, dst: Path,
                       image: Path | None = None) -> None:
    """One output's opaque lock layer: scene plus every static part of the UI,
    at physical size so it lines up pixel for pixel with the live widgets."""
    pw, ph = round(w * scale), round(h * scale)
    k = h / 800 * scale  # physical px per design unit
    half = w / 2 / (h / 800)  # half the output width, in u
    m = LOCK_FRAME
    xl, xr, yt, yb = -half + m, half - m, m, 800 - m

    def cx(x: float) -> float:
        return pw / 2 + x * k

    def cy(y: float) -> float:
        return y * k

    def put(element: str, role: str, width: float, x: float, y: float, opacity: float,
            flop: bool = False, flip: bool = False) -> list[str]:
        # Centred on (x, y); gravity center measures offsets from the canvas centre.
        return ["(", str(OUT / "elements" / f"{element}.png"), "-resize", f"{round(width * k)}x",
                *(["-flop"] if flop else []), *(["-flip"] if flip else []),
                "-fill", colors[role], "-colorize", "100",
                "-channel", "A", "-evaluate", "multiply", str(opacity), "+channel", ")",
                "-gravity", "center", "-geometry", f"{round(x * k):+d}{round(y * k - ph / 2):+d}",
                "-composite"]

    def text(s: str, font: str, size: float, role: str, x: float, y: float,
             spacing: float = 0) -> list[str]:
        # Centred on (x, y).
        return ["-gravity", "center", "-font", font, "-pointsize", f"{size * k:.1f}",
                "-kerning", f"{spacing * k:.1f}", "-fill", colors[role], "-stroke", "none",
                "-annotate", f"{round(x * k):+d}{round(y * k - ph / 2):+d}", s]

    def ltext(s: str, size: float, role: str, x: float, y: float, spacing: float = 0,
              right: bool = False, rotate: int = 0) -> list[str]:
        # Baseline text starting at x (or ending there when right=True).
        if right:
            x -= text_width(s, MONO_FONT, round(size * k)) / k + spacing * (len(s) - 1)
        angle = f"{rotate}x{rotate}" if rotate else ""
        return ["+gravity", "-font", MONO_FONT, "-pointsize", f"{size * k:.1f}",
                "-kerning", f"{spacing * k:.1f}", "-fill", colors[role], "-stroke", "none",
                "-annotate", f"{angle}+{round(cx(x))}+{round(cy(y))}", s]

    def stroke(role: str, width: float = 1.0) -> list[str]:
        return ["-gravity", "NorthWest", "-fill", "none", "-stroke", colors[role],
                "-strokewidth", f"{max(1.0, width * k):.2f}"]

    def line(points: list[tuple[float, float]], role: str, width: float = 1.0) -> list[str]:
        pts = " ".join(f"{cx(x):.1f},{cy(y):.1f}" for x, y in points)
        return stroke(role, width) + ["-draw", f"polyline {pts}"]

    def rect(x0: float, y0: float, x1: float, y1: float, color: str) -> list[str]:
        return ["-gravity", "NorthWest", "-stroke", "none", "-fill", color,
                "-draw", f"rectangle {cx(min(x0, x1)):.1f},{cy(min(y0, y1)):.1f} "
                         f"{cx(max(x0, x1)):.1f},{cy(max(y0, y1)):.1f}"]

    def poly(points: list[tuple[float, float]], fill: str, edge: str | None = None) -> list[str]:
        pts = " ".join(f"{cx(x):.1f},{cy(y):.1f}" for x, y in points)
        return ["-gravity", "NorthWest", "-fill", fill,
                *(["-stroke", colors[edge], "-strokewidth", f"{max(1.0, k):.2f}"] if edge
                  else ["-stroke", "none"]),
                "-draw", f"polygon {pts}"]

    def corners(x0: float, y0: float, x1: float, y1: float, arm: float, t: float,
                color: str) -> list[str]:
        out = []
        for qx, qy, dx, dy in ((x0, y0, 1, 1), (x1, y0, -1, 1), (x0, y1, 1, -1), (x1, y1, -1, -1)):
            out += rect(qx, qy, qx + dx * arm, qy + dy * t, color)
            out += rect(qx, qy, qx + dx * t, qy + dy * arm, color)
        return out

    def glass(x0: float, y0: float, x1: float, y1: float) -> list[str]:
        px0, py0 = round(cx(x0)), round(cy(y0))
        return glass_pane(px0, py0, round(cx(x1)) - px0, round(cy(y1)) - py0, scale)

    acid = colors["primary"]
    cmd = lock_scene(colors, pw, ph, image)

    # Frame: hairline inset with acid corner ticks, as on the wallpaper.
    cmd += stroke("outline") + ["-draw", f"rectangle {cx(xl):.1f},{cy(yt):.1f} {cx(xr):.1f},{cy(yb):.1f}"]
    cmd += corners(xl, yt, xr, yb, 24, 2, acid)
    # Header, mirroring the wallpaper's.
    cmd += ltext(f"SYS://{USER_TAG}-HUD  ·  NODE 0x2100", 10, "on_surface_variant", xl + 20, yt + 27)
    cmd += ltext("SESSION LOCKED  //  AUTH PENDING", 10, "outline", xl + 20, yt + 43)
    cmd += ltext(f"{USER_TAG}//HUD", 10, "primary", xr - 20, yt + 27, right=True)
    cmd += ltext("LINK SEALED", 10, "outline", xr - 20, yt + 43, right=True)
    # Altimeter rulers on both frame edges down to the horizon. (No read-outs
    # beside them: the user had the HZN/ALT labels of the wide outputs removed.)
    ticks = []
    for i, y in enumerate(range(yt + 75, LOCK_HORIZON - 25, 8)):
        n = 8 if i % 5 == 0 else 3.5
        ticks += [f"line {cx(xl):.1f},{cy(y):.1f} {cx(xl + n):.1f},{cy(y):.1f}",
                  f"line {cx(xr):.1f},{cy(y):.1f} {cx(xr - n):.1f},{cy(y):.1f}"]
    cmd += stroke("outline") + ["-draw", " ".join(ticks)]
    cmd += ltext("ACID//HUD  -  SECURE NODE 0x2100  -  SESSION SEALED", 7.3, "outline",
                 xr - 16, yt + 90, rotate=90)

    # Hero: acid plate and reticle, the clock (live), tick rail and date line.
    ty = LOCK_TAG_Y
    cmd += poly([(-104, ty - 10), (14, ty - 10), (6, ty + 10), (-112, ty + 10)], acid)
    cmd += text("SYS//LOCKED", MONO_FONT, 10, "on_primary", -49, ty, 1.5)
    cmd += poly([(22, ty - 10), (112, ty - 10), (104, ty + 10), (14, ty + 10)], "none", "outline")
    cmd += text("ID 0x2100", MONO_FONT, 8, "on_surface_variant", 63, ty, 1.5)
    ry, rx = LOCK_RULER_Y, 250
    rule = []
    for i in range(-25, 26):
        n = 8 if i % 5 == 0 else 3.5
        rule.append(f"line {cx(i * 10):.1f},{cy(ry):.1f} {cx(i * 10):.1f},{cy(ry - n):.1f}")
    cmd += stroke("outline") + ["-draw", f"line {cx(-rx):.1f},{cy(ry):.1f} {cx(rx):.1f},{cy(ry):.1f}",
                                "-draw", " ".join(rule)]
    cmd += rect(-40, ry - 1, 40, ry + 1, acid)
    cmd += poly([(-5, ry + 4), (5, ry + 4), (0, ry + 10)], acid)
    # Separator between the live date and week widgets (LOCK_DATE_X).
    cmd += rect(-2, LOCK_DATE_Y - 2, 2, LOCK_DATE_Y + 2, acid)
    cmd += text("NODE 0x2100", MONO_FONT, 8, "outline", -185, LOCK_DATE_Y, 1.5)
    cmd += text("GRID 21-00", MONO_FONT, 8, "outline", 185, LOCK_DATE_Y, 1.5)

    # Telemetry banks: glass cards, each holding one live graph.
    for idx, side, caption, _stat, _stat2, x0, y0, x1, y1 in lock_cards():
        cmd += glass(x0, y0, x1, y1)
        tx = x0 + 12
        cmd += poly([(tx + 4, y0 + 8), (tx + 30, y0 + 8), (tx + 26, y0 + 21), (tx, y0 + 21)], acid)
        cmd += text(f"{idx:02d}", MONO_FONT, 8, "on_primary", tx + 15, y0 + 14.5)
        cmd += ltext(caption, 9, "on_surface", tx + 38, y0 + 18, spacing=1.5)
        cmd += put("slashes-3", "primary", 16, x1 - 22, y0 + 14.5, 0.9)
        cmd += line([(x0 + 10, y0 + 28), (x1 - 10, y0 + 28)], "outline")
    # Connectors from the middle cards to the rail, with acid nodes by the
    # cards: clear of the glass, whose edge is its light and carries nothing
    # (a bar or a node on it reads as a sticker on the pane).
    cw, ch, gap = LOCK_CARD
    my = LOCK_BANK_Y + ch * 1.5 + gap
    for side in (-1, 1):
        near = side * (LOCK_BANK_X - cw / 2 - 8)
        cmd += line([(near, my), (side * 290, my), (side * 290, ry), (side * (rx + 8), ry)], "outline")
        cmd += rect(near - 3, my - 3, near + 3, my + 3, acid)

    # Auth strip: glass pane under noctalia's (transparent) login box, caption
    # with chevron gauges, acid brackets around it.
    lx, ly, lw, lh = LOCK_LOGIN
    cmd += glass(lx - lw / 2, ly - lh / 2, lx + lw / 2, ly + lh / 2)
    cmd += text("AUTHENTICATION REQUIRED", MONO_FONT, 10, "on_surface_variant", 0, ly - lh / 2 - 22, 3)
    cmd += put("chevron-progress", "primary", 70, -(lw / 2 - 60), ly - lh / 2 - 22, 0.9)
    cmd += put("chevron-progress", "primary", 70, lw / 2 - 60, ly - lh / 2 - 22, 0.9, flop=True)
    cmd += corners(lx - lw / 2 - 8, ly - lh / 2 - 8, lx + lw / 2 + 8, ly + lh / 2 + 8, 16, 2, acid)

    # The unlock's glass sheet: its light bands over the whole UI, as the
    # fold draws them (the live widgets sit above it).
    cmd += fold_glass(colors, pw, ph)

    with staged(dst) as tmp:
        run(*cmd, "-depth", "8", tmp)


def lock_layout_toml(outputs: dict[str, tuple[int, int, float]] = LOCK_OUTPUTS) -> str:
    """The live lockscreen widgets for every output in `outputs`, as TOML."""
    lock = OUT / "lock"
    out = ["[lockscreen_widgets]", "enabled = true",
           "schema_version = 2 # current layout schema; without it noctalia migrates the table into state"]
    order: list[str] = []
    tables: list[str] = []

    def q(v) -> str:
        if isinstance(v, bool):
            return "true" if v else "false"
        if isinstance(v, (int, float)):
            return repr(float(v))  # exact: 0.92 must not become 0.9
        return '"' + str(v) + '"'

    for name, (w, h, scale) in outputs.items():
        u = h / 800
        tag = name.lower().replace("-", "")

        def widget(wid: str, wtype: str, x: float, y: float, bw: float, bh: float, settings: dict,
                   absolute: bool = False, digits: int = 1) -> None:
            key = wid if wid.startswith("lockscreen-") else f"hud_{wid}_{tag}"
            order.append(key)
            kq = f'"{key}"' if "@" in key else key
            cxp = x if absolute else w / 2 + x * u
            cyp = y if absolute else y * u
            lines = [f"[lockscreen_widgets.widget.{kq}]", f'output = "{name}"', f'type = "{wtype}"',
                     f"cx = {cxp:.{digits}f}", f"cy = {cyp:.{digits}f}",
                     f"box_width = {bw if absolute else bw * u:.{digits}f}",
                     f"box_height = {bh if absolute else bh * u:.{digits}f}",
                     f"[lockscreen_widgets.widget.{kq}.settings]"]
            lines += [f"{k} = {q(v)}" for k, v in settings.items()]
            tables.append("\n".join(lines))

        widget("static", "sticker", w / 2, h / 2, w, h,
               {"image_path": str(lock / f"static-{name}.png"), "background": False}, absolute=True)
        # The reticle (reticle_box), the hero clock (LOCK_CLOCK), the seconds
        # (LOCK_SECONDS), the date and the week (LOCK_DATE_*) and the graphs
        # in the telemetry cards (lock_cards: below the header rule at
        # y0 + 28 down to an 8 u margin, 10 u in from the sides) are live
        # readouts the HUD draws itself, above the lock surface and in its
        # closing doors (quickshell/hud/LockWidgets.qml, which repeats this
        # spec), so they are not Noctalia widgets: those only appear once
        # the lock surface is up, graphs empty.
        lx, ly, lw, lh = LOCK_LOGIN
        # The box itself is clear: the static art carries a glass pane under it,
        # and the password field is a faint tint on that glass. Noctalia's
        # session chips are opaque surface-filled buttons with no translucent
        # variant, so they stay off the lock (the session panel has them); the
        # compact layout is the field alone and allows a strip narrower than
        # the regular layout's 720 minimum. No reveal (eye) button either: the
        # field is the only thing in the row, so it fills it and sits centred.
        widget(f"lockscreen-login-box@{name}", "login_box", lx, ly, lw, lh,
               {"layout": "compact", "show_media": False, "show_weather": False,
                "show_session_buttons": False, "background_color": "surface",
                "background_opacity": 0.0, "background_radius": 18.0, "input_opacity": 0.35,
                "input_radius": 12.0, "show_login_button": False, "show_password_reveal": False,
                "center_password_text": True, "show_unlock_hint": False})

    out.append("widget_order = [\n" + "".join(f'  "{k}",\n' for k in order) + "]")
    return "\n".join(out) + "\n\n" + "\n\n".join(tables) + "\n"


# Readout icons (mael/hud:msg, vol, lum) in the battery cell's idiom: a thin
# neutral outline with the live part in acid. Original art on an 18 px logical
# canvas (the coordinates in bar_icon), 8x supersampled and finished at device
# resolution per output scale, like the workspace tiles.
# name -> (outline role, accent role, shape)
ICON_PX = 18
BAR_ICONS = {
    "vol": ("on_surface_variant", "primary", "speaker"),
    "silent": ("on_surface_variant", None, "speaker"),      # 0 %: no waves
    "mute": ("on_surface_variant", "error", "speaker-x"),
    "lum": ("on_surface_variant", "primary", "sun"),
    "bell": ("on_surface_variant", "primary", "bell"),
    "bell-off": ("outline", "outline", "bell"),            # DND: dimmed
}


def bar_icon(shape: str, outline: str, accent: str | None, sc: float, dst: Path) -> None:
    ss = 8
    m = sc * ss  # logical px -> drawing px
    px = round(ICON_PX * sc)

    def p(*xy: float) -> str:
        return " ".join(f"{x * m:.1f},{y * m:.1f}" for x, y in zip(xy[::2], xy[1::2]))

    line = ["-stroke", outline, "-strokewidth", f"{m:.1f}", "-fill", "none"]
    acid = ["-stroke", accent or "none", "-strokewidth", f"{1.25 * m:.1f}", "-fill", "none"]
    cap = "stroke-linecap round "  # a draw-primitive setting, not a CLI option
    draw: list[str] = []
    if shape.startswith("speaker"):
        # Box and cone outlined; two sound waves (or a mute cross) in acid.
        draw += [*line, "-draw", f"polygon {p(2, 6.5, 6, 6.5, 10.5, 3, 10.5, 15, 6, 11.5, 2, 11.5)}"]
        if accent and shape == "speaker":
            draw += [*acid, "-draw", f"{cap}ellipse {p(10.5, 9)} {p(3, 3)} -45,45",
                     "-draw", f"{cap}ellipse {p(10.5, 9)} {p(5.5, 5.5)} -40,40"]
        elif accent:
            draw += [*acid, "-draw", f"{cap}line {p(12.5, 6.5, 16.5, 11.5)}",
                     "-draw", f"{cap}line {p(16.5, 6.5, 12.5, 11.5)}"]
    elif shape == "sun":
        # Outlined disc, eight acid rays.
        draw += [*line, "-draw", f"circle {p(9, 9)} {p(9, 5.5)}"]
        if accent:
            draw += acid
            for k in range(8):
                a = math.radians(k * 45)
                draw += ["-draw", f"{cap}line {p(9 + 5.5 * math.cos(a), 9 + 5.5 * math.sin(a), 9 + 7.5 * math.cos(a), 9 + 7.5 * math.sin(a))}"]
    elif shape == "bell":
        # Outlined bell, acid clapper bar.
        draw += [*line, "-draw", f"path 'M {p(4, 11.5)} L {p(4, 8)} A {p(5, 5)} 0 0 1 {p(14, 8)} L {p(14, 11.5)} "
                                 f"L {p(15.5, 13.5)} L {p(2.5, 13.5)} Z'"]
        if accent:
            draw += ["-stroke", "none", "-fill", accent, "-draw", f"rectangle {p(7, 15, 11, 16.5)}"]
    run("magick", "-size", f"{px * ss}x{px * ss}", "xc:none", *draw,
        "-filter", "lanczos", "-resize", f"{px}x{px}!", dst)


# Workspace tiles: logical size of one slanted tile (the focused one is wider,
# to carry its stripes) and the supersample the body is drawn at before it is
# finished at each output's device resolution (ws_tiles).
WS_W, WS_ACTIVE_W, WS_H, WS_SKEW, WS_SCALE, WS_MAX = 26, 38, 20, 6, 4, 10


def output_scales() -> list[float]:
    """Device scales of the connected outputs (always with 1x), for assets that
    are drawn at device resolution."""
    scales = {1.0}
    try:
        for mon in json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True,
                                             text=True, check=True).stdout):
            scales.add(round(float(mon.get("scale", 1)), 3))
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError, ValueError):
        pass
    return sorted(scales)


def ws_tiles(colors: dict[str, str], out: Path, sc: float) -> int:
    """Slanted workspace tiles with the number baked in, one PNG per state, for
    outputs at scale `sc` (into out/<sc>, which the widget picks by its output's
    scale). The tiles are finished at device resolution: the body is drawn 4x
    and downscaled for clean slants, then the digit is set 1:1 in Departure
    Mono, whose pixel grid is 11 px per em, so it is as crisp as the bar's own
    text. Noctalia scales images bilinearly, which smeared the digit of a tile
    rendered at 4x."""
    out = out / f"{sc:g}"
    out.mkdir(parents=True, exist_ok=True)
    s = round(WS_SCALE * sc)  # draw at this multiple of the logical size ...

    def dev(v: float) -> int:  # ... and finish at the device size
        return round(v * sc)

    w, aw, h, k = WS_W * s, WS_ACTIVE_W * s, WS_H * s, WS_SKEW * s
    i = s // 2  # inset so the stroke stays inside the canvas

    def left_x(y: float) -> float:
        return k * (1 - y / (h - 1))

    body = f"polygon {k + i},{i} {w - 1 - i},{i} {w - 1 - k - i},{h - 1 - i} {i},{h - 1 - i}"
    # The focused tile gets a cut corner (bottom left) for a machined look.
    c = 6 * s
    chamfer = (f"polygon {k},0 {aw - 1},0 {aw - 1 - k},{h - 1} {c + left_x(h - 1)},{h - 1} "
               f"{left_x(h - 1 - c)},{h - 1 - c}")
    stripes = []
    for j in range(3):  # "///" etched into the focused tile's right end
        x0 = aw - 1 - k - 4 * s - j * 4 * s
        stripes += ["-draw", f"polygon {x0},{h - 3 * s} {x0 + 2 * s},{h - 3 * s} "
                             f"{x0 + 2 * s + k * 0.7:.0f},{3 * s} {x0 + k * 0.7:.0f},{3 * s}"]
    # Occupied tick in the top-right corner, clear of the number.
    marker = f"rectangle {w - 1 - 9 * s},{3 * s} {w - 1 - 6 * s},{6 * s}"

    def tile(state: str, n: int, dst: Path) -> None:
        # Departure Mono at the bar readouts' 12 px, so tile numbers match the
        # values in the panels.
        text, digit_font = colors["on_surface"], MONO_FONT
        draw: list[str] = []
        if state == "empty":
            draw = ["-fill", "none", "-stroke", colors["outline"], "-strokewidth", str(s),
                    "-draw", body]
            text = colors["outline"]
        elif state == "occupied":
            draw = ["-fill", colors["on_surface"] + "1f", "-stroke", colors["on_surface_variant"],
                    "-strokewidth", str(s), "-draw", body,
                    "-stroke", "none", "-fill", colors["primary"], "-draw", marker]
        elif state == "visible":  # focused on another monitor
            draw = ["-fill", "none", "-stroke", colors["primary"], "-strokewidth", str(s),
                    "-draw", body]
            text = colors["primary"]
        elif state == "urgent":
            draw = ["-fill", colors["error"] + "55", "-stroke", colors["error"],
                    "-strokewidth", str(s), "-draw", body]
        elif state == "active":
            draw = ["-fill", colors["primary"], "-draw", chamfer]
            text = colors["on_primary"]
        # The focused number sits in the left part, clear of the stripes.
        tw, tw_logical = (aw, WS_ACTIVE_W) if state == "active" else (w, WS_W)
        if state == "active":
            # Two-digit numbers need the room: keep only the outermost stripe.
            draw += ["-fill", colors["on_primary"] + "80", *(stripes if n < 10 else stripes[:2])]
            anchor, dx = "west", WS_SKEW + 2
        else:
            anchor, dx = "center", -1  # the slant's optical middle
        run("magick", "-size", f"{tw}x{h}", "xc:none", *draw,
            "-filter", "lanczos", "-resize", f"{dev(tw_logical)}x{dev(WS_H)}!",
            "-stroke", "none", "-fill", text, "-font", digit_font, "-pointsize", f"{11 * sc:g}",
            "-gravity", anchor, "-annotate", f"{dev(dx):+d}+0", str(n), dst)

    count = 0
    for n in range(1, WS_MAX + 1):
        for state in ("empty", "occupied", "visible", "urgent", "active"):
            tile(state, n, out / f"{state}-{n}.png")
            count += 1
        act = out / f"active-{n}.png"
        # Two glitch frames shown when a workspace takes focus: a torn scanline
        # band, then a red/white channel split.
        daw, dh = dev(WS_ACTIVE_W), dev(WS_H)
        band_y, band_h = dev(7), dev(5)
        run("magick", act, "(", "+clone", "-crop", f"{daw}x{band_h}+0+{band_y}", "+repage",
            "-roll", f"+{dev(3)}+0", ")", "-geometry", f"+0+{band_y}", "-compose", "Copy",
            "-composite", out / f"glitch0-{n}.png")
        run("magick", "-size", f"{daw}x{dh}", "xc:none",
            "(", act, "-fill", colors["error"], "-colorize", "100", ")",
            "-geometry", f"-{dev(2)}+0", "-composite",
            "(", act, "-fill", colors["on_surface"], "-colorize", "100", ")",
            "-geometry", f"+{dev(2)}+0", "-composite", act, "-geometry", "+0+0", "-composite",
            out / f"glitch1-{n}.png")
        count += 2
    # Slanted acid brackets that close the row.
    cw = (WS_SKEW + 6) * s
    run("magick", "-size", f"{cw}x{h}", "xc:none", "-stroke", colors["primary"],
        "-strokewidth", str(s), "-fill", "none",
        "-draw", f"polyline {k + 5 * s},{i} {k + i},{i} {i},{h - 1 - i} {5 * s},{h - 1 - i}",
        "-filter", "lanczos", "-resize", f"{dev(WS_SKEW + 6)}x{dev(WS_H)}!",
        out / "cap-l.png")
    run("magick", out / "cap-l.png", "-rotate", "180", out / "cap-r.png")
    return count + 2


def build_bar(colors: dict[str, str]) -> None:
    """Frames for the mael/hud Noctalia bar plugin (it can swap images, not rotate them)."""
    bar = OUT / "bar"
    # Frames are rendered into .new dirs and swapped in at the end, so the bar
    # never sees a half-rendered set. The swap is two renames, so a directory is
    # briefly missing; the widgets check for files and skip that tick.
    staging = {sub: bar / f".{sub}.new" for sub in ("spinner", "hazard", "ws", "icons")}
    for d in staging.values():
        shutil.rmtree(d, ignore_errors=True)
        d.mkdir(parents=True)
    tint(OUT / "elements" / "tri-blade.png", colors["primary"], 64, bar / "emblem.png")
    # Control-centre button: four corner brackets round a centre cross, drawn for
    # the 16 px Noctalia shows its custom_image at (the bracket-cross element has
    # far finer strokes than 16 px can carry). 32 px square, 8x supersampled, so
    # Noctalia's bilinear scale is a clean 2:1 at 1x.
    m = 2 * 8

    def q(*xy: float) -> str:
        return " ".join(f"{x * m:.1f},{y * m:.1f}" for x, y in zip(xy[::2], xy[1::2]))

    draw = ["-stroke", colors["primary"], "-strokewidth", f"{1.5 * m:.1f}", "-fill", "none"]
    for sx, sy in ((1, 1), (-1, 1), (1, -1), (-1, -1)):
        cx, cy = 8 - sx * 5.75, 8 - sy * 5.75
        draw += ["-draw", f"polyline {q(cx + sx * 4, cy, cx, cy, cx, cy + sy * 4)}"]
    draw += ["-draw", f"line {q(5.5, 8, 10.5, 8)}", "-draw", f"line {q(8, 5.5, 8, 10.5)}"]
    with staged(bar / "control-center.png") as tmp:
        run("magick", "-size", f"{16 * m}x{16 * m}", "xc:none", *draw,
            "-filter", "lanczos", "-resize", "32x32!", tmp)
    # Procedural barcode on a module grid at 6x the widget's 46x12 logical px:
    # 6 px modules land on whole pixels at both 1.5x (4 px) and 1x (6 px), so the
    # bars stay crisp where a downscaled bitmap blurs into grey.
    mod, cols, bar_h = 6, 46, 72
    rng = random.Random(2100)  # fixed pattern across rebuilds
    bars, x, ink = [], 0, True
    while x < cols:
        span = min(cols - x, rng.choice((1, 1, 2, 3) if ink else (1, 1, 2)))
        if ink:
            bars += ["-draw", f"rectangle {x * mod},0 {(x + span) * mod - 1},{bar_h - 1}"]
        x, ink = x + span, not ink
    with staged(bar / "barcode.png") as tmp:
        run("magick", "-size", f"{cols * mod}x{bar_h}", "xc:none",
            "-fill", colors["on_surface_variant"], *bars, tmp)

    # Spinner: a procedural segmented ring (six 36-degree arcs round a thin
    # inner circle) in 36 rotation frames, drawn 8x and finished at device
    # resolution per output scale (bar/spinner/<scale>). The ring element it
    # replaced carried far more detail than 18 px can hold, and Noctalia's
    # bilinear downscale of its 72 px frames made a smudge of it.
    spin_frames, spin_px, ss = 36, 18, 8
    for sc in output_scales():
        sub = staging["spinner"] / f"{sc:g}"
        sub.mkdir()
        px = round(spin_px * sc)
        big = px * ss
        c = big / 2
        arcs = [a for seg in range(6)
                for a in ("-draw", f"ellipse {c},{c} {7.25 * sc * ss},{7.25 * sc * ss} "
                                   f"{seg * 60 + 12},{seg * 60 + 48}")]
        base = sub / "_base.png"
        run("magick", "-size", f"{big}x{big}", "xc:none", "-fill", "none",
            "-stroke", colors["primary"], "-strokewidth", str(2 * sc * ss), *arcs,
            "-strokewidth", str(sc * ss), "-draw", f"circle {c},{c} {c},{c - 4.5 * sc * ss}",
            base)
        for i in range(spin_frames):
            run("magick", base, "-distort", "SRT", f"{i * 360 / spin_frames:.2f}",
                "-filter", "lanczos", "-resize", f"{px}x{px}!", sub / f"{i:02d}.png")
        base.unlink()

    # Procedural hazard tape at 4x the widget's default 56x10, one stripe period
    # split into 8 shifts so the frames loop seamlessly.
    w, h, period, frames = 224, 40, 40, 8
    for i in range(frames):
        off = i * period // frames
        polys = []
        for x in range(-period * 2, w + period, period):
            x0 = x + off
            polys += ["-draw", f"polygon {x0},{h} {x0 + h // 2},0 {x0 + h // 2 + period // 2},0 "
                               f"{x0 + period // 2},{h}"]
        # Clip to a parallelogram whose ends follow the stripe slant, so the
        # stripes crawling in and out are cut cleanly instead of leaving slivers.
        run("magick", "-size", f"{w}x{h}", "xc:none", "-fill", colors["primary"], *polys,
            "(", "-size", f"{w}x{h}", "xc:none", "-fill", "white",
            "-draw", f"polygon {h // 2},0 {w},0 {w - h // 2},{h} 0,{h}", ")",
            "-compose", "DstIn", "-composite", staging["hazard"] / f"{i:02d}.png")
    for sc in output_scales():
        sub = staging["icons"] / f"{sc:g}"
        sub.mkdir()
        for name, (outline, accent, shape) in BAR_ICONS.items():
            bar_icon(shape, colors[outline], colors[accent] if accent else None, sc, sub / f"{name}.png")
    tiles = sum(ws_tiles(colors, staging["ws"], sc) for sc in output_scales())

    for sub, new in staging.items():
        old = bar / f".{sub}.old"
        shutil.rmtree(old, ignore_errors=True)
        if (bar / sub).exists():
            (bar / sub).rename(old)
        new.rename(bar / sub)
        shutil.rmtree(old, ignore_errors=True)
    print(f"bar: emblem, barcode, {spin_frames} spinner + {frames} hazard frames, "
          f"{len(BAR_ICONS)} icons, {tiles} workspace tiles")


def build_extras(colors: dict[str, str]) -> None:
    tint(OUT / "elements" / "tri-blade.png", colors["primary"], 512, OUT / "fastfetch-logo.png")
    # Neovim's dashboard header: the compact one fits a laptop-height window
    # next to the key list, the large one is for tall windows.
    blade = OUT / "elements" / "tri-blade.png"
    (OUT / "nvim-header.txt").write_text(octant_art(blade, 20) + "\n")
    (OUT / "nvim-header-large.txt").write_text(octant_art(blade, 32) + "\n")
    print("extras: fastfetch-logo.png, nvim-header.txt, nvim-header-large.txt")


PLYMOUTH_HEIGHTS = (1080, 1200, 1440, 2160)  # screen heights the splash is drawn for
PLYMOUTH_FRAMES = 60                          # emblem steps across its 120-degree symmetry
PLYMOUTH_CELLS = 24                           # segments of the loading bar
PLYMOUTH_LABELS = {"boot": "SYS//BOOT", "shutdown": "SYS//HALT", "reboot": "SYS//REBOOT"}


def alpha_centroid(src: Path) -> tuple[float, float, float]:
    """Centre of mass of an image's alpha and the farthest opaque pixel from
    it, in source px. For a rotationally symmetric mark this is the point it
    turns about."""
    w = 256
    # -strip: a comment in the source would add a line to the PGM header.
    pgm = subprocess.run(["magick", str(src), "-alpha", "extract", "-strip", "-resize", f"{w}x",
                          "-depth", "8", "pgm:-"], capture_output=True, check=True).stdout
    _, dims, _, data = pgm.split(b"\n", 3)
    w, h = map(int, dims.split())
    total = sx = sy = 0
    for y in range(h):
        for x, v in enumerate(data[y * w:(y + 1) * w]):
            total, sx, sy = total + v, sx + v * x, sy + v * y
    cx, cy = (sx / total + 0.5, sy / total + 0.5) if total else (0, 0)
    reach = max((math.hypot(x + 0.5 - cx, y + 0.5 - cy)
                 for y in range(h) for x in range(w) if data[y * w + x] > 127), default=0)
    if not reach:
        raise RuntimeError(f"{src} has no opaque pixels")
    k = int(subprocess.run(["magick", "identify", "-format", "%w", str(src)],
                           capture_output=True, text=True, check=True).stdout) / w
    return cx * k, cy * k, reach * k


def build_plymouth(colors: dict[str, str]) -> None:
    """The Plymouth theme `acid-hud` in OUT/plymouth, for hud-boot to install.

    Plymouth's script plugin can only place, swap and fade images, so every
    moving part is pre-rendered: the emblem in PLYMOUTH_FRAMES rotation steps
    (three blades repeat every 120 degrees, so the frames cover just that), one
    lit segment and one head segment for the loading bar, and the readout's
    digits. Each screen height gets its own set drawn at device resolution
    (the script picks the nearest); the connected monitors are added to the
    list.
    """
    src = SRC / "plymouth"
    blade = OUT / "elements" / "tri-blade.png"
    if not blade.exists():
        raise RuntimeError(f"{blade} missing: run hud-build first")
    out = OUT / "plymouth" / "acid-hud"
    staging = out.with_name(".acid-hud.new")
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(parents=True)

    # Plymouth runs before any compositor: it sees each panel's own mode.
    heights = sorted(set(PLYMOUTH_HEIGHTS) | {o["native"][1] for o in connected_outputs()})

    # Emblem: on a square canvas centred on the point it turns about, with
    # room for its bloom, at twice the largest size it is needed in. One magick
    # run per angle rotates that and writes the frame for every height. The
    # mark is one flat colour, so the bloom only has to blur the alpha.
    cx, cy, reach = alpha_centroid(blade)
    emblem_r, canvas_r = 100, 140  # blade tip and canvas edge from the centre, at 1200 px
    half = math.ceil(reach * canvas_r / emblem_r)
    work = min(2 * half, 4 * round(canvas_r * heights[-1] / 1200))
    flat = ["-fill", colors["primary"], "-colorize", "100"]
    base = staging / "_emblem.png"
    run("magick", blade, "-background", "none", "-gravity", "NorthWest",
        "-extent", f"{2 * half}x{2 * half}{round(cx) - half:+d}{round(cy) - half:+d}",
        "-filter", "lanczos", "-resize", f"{work}x{work}!", base)

    def frame(i: int) -> None:
        # One thread each: the frames already run in parallel.
        cmd = ["magick", "-limit", "thread", "1", base, "-virtual-pixel", "transparent",
               "-distort", "SRT", f"{i * 120 / PLYMOUTH_FRAMES:.2f}", "-write", "mpr:turned", "+delete"]
        for h in heights:
            u = h / 1200
            size = 2 * round(canvas_r * u)
            cmd += ["(", "mpr:turned", "-filter", "lanczos", "-resize", f"{size}x{size}!", *flat,
                    "(", "+clone", "-channel", "A", "-blur", f"0x{14 * u:.1f}",
                    "-evaluate", "multiply", "0.55", "+channel", ")",
                    "-compose", "DstOver", "-composite", "-write", staging / f"emblem-{i}-{h}.png", ")",
                    "+delete"]
        run(*cmd[:-1], "null:")

    with ThreadPoolExecutor(max(1, (os.cpu_count() or 2) // 2)) as pool:
        list(pool.map(frame, range(PLYMOUTH_FRAMES)))
    base.unlink()

    ss = 4
    pitches = []
    for h in heights:
        u = h / 1200
        # Loading bar: slanted segments on a whole-pixel pitch, so the lit
        # segments the script lays over the track land exactly on its cells.
        pitch = round(14 * u)
        pitches.append(pitch)
        cell_w, cell_h, slant = 9 * u, 11 * u, 3.5 * u
        bar_w = PLYMOUTH_CELLS * pitch

        def cell(x: float, cy_: float, k: int = ss) -> str:
            x0, y0, y1 = x + (pitch - cell_w) / 2, cy_ - cell_h / 2, cy_ + cell_h / 2
            pts = ((x0 + slant, y0), (x0 + cell_w, y0), (x0 + cell_w - slant, y1), (x0, y1))
            return "polygon " + " ".join(f"{px * k:.1f},{py * k:.1f}" for px, py in pts)

        # Track: the unlit segments between four corner brackets, and the node
        # caption under them (set after the downscale: the readout face is a
        # pixel font and smears when resized).
        pad_x, half_h = round(30 * u), round(52 * u)
        w, hh = bar_w + 2 * pad_x, 2 * half_h
        draw = ["-fill", colors["outline"] + "73", "-stroke", "none"]
        for n in range(PLYMOUTH_CELLS):
            draw += ["-draw", cell(pad_x + n * pitch, half_h)]
        draw += ["-fill", "none", "-stroke", colors["primary"], "-strokewidth", f"{1.5 * u * ss:.1f}"]
        box_x, box_y, arm = 14 * u, 15 * u, 7 * u
        for sx in (1, -1):
            for sy in (1, -1):
                bx, by = w / 2 - sx * (bar_w / 2 + box_x), half_h - sy * box_y
                pts = ((bx + sx * arm, by), (bx, by), (bx, by + sy * arm))
                draw += ["-draw", "polyline " + " ".join(f"{px * ss:.1f},{py * ss:.1f}" for px, py in pts)]
        run("magick", "-size", f"{w * ss}x{hh * ss}", "xc:none", *draw,
            "-filter", "lanczos", "-resize", f"{w}x{hh}!",
            "-gravity", "center", "-font", MONO_FONT, "-pointsize", str(round(12 * u)),
            "-kerning", f"{2 * u:.1f}", "-fill", colors["outline"], "-stroke", "none",
            "-annotate", f"+0+{round(38 * u)}", "ACID//HUD  ·  NODE 0x2100",
            staging / f"track-{h}.png")
        # One lit segment and the head segment, each with its own bloom.
        pad = round(14 * u)
        w, hh = pitch + 2 * pad, 2 * round(22 * u)
        for name, role, bloom in (("cell", "primary", 0.7), ("head", "tertiary", 0.9)):
            run("magick", "-size", f"{w * ss}x{hh * ss}", "xc:none", "-fill", colors[role],
                "-draw", cell(pad, hh / 2), "-filter", "lanczos", "-resize", f"{w}x{hh}!",
                "(", "+clone", "-channel", "RGBA", "-blur", f"0x{4.5 * u:.1f}",
                "-channel", "A", "-evaluate", "multiply", str(bloom), "+channel", ")",
                "-compose", "DstOver", "-composite", staging / f"{name}-{h}.png")
        # Readout: the mode label and fixed-width digits (dim for leading zeros).
        size, kern = round(15 * u), 2 * u
        text = ["-background", "none", "-font", MONO_FONT, "-pointsize", str(size), "-kerning", f"{kern:.1f}"]
        for mode, label in PLYMOUTH_LABELS.items():
            run("magick", *text, "-fill", colors["on_surface_variant"], f"label:{label}",
                staging / f"label-{mode}-{h}.png")
        advance = text_width("0", MONO_FONT, size) + round(kern)
        line = round(size * 1.4)
        glyphs = [(f"digit-{d}", str(d), "on_surface") for d in range(10)]
        glyphs += [("zero", "0", "outline"), ("percent", "%", "on_surface_variant")]
        for name, char, role in glyphs:
            run("magick", "-size", f"{advance}x{line}", *text, "-gravity", "center",
                "-fill", colors[role], f"label:{char.replace('%', '%%')}", staging / f"{name}-{h}.png")

    def rgb(role: str) -> str:
        v = colors[role].lstrip("#")
        return ", ".join(f"{int(v[i:i + 2], 16) / 255:.3f}" for i in (0, 2, 4))

    sizes = "".join(f"sizes[{i}] = {h};\npitches[{i}] = {p};\n"
                    for i, (h, p) in enumerate(zip(heights, pitches))) + f"size_count = {len(heights)};"
    script = (src / "acid-hud.script").read_text()
    for key, value in (("@BG@", rgb("surface")), ("@FG@", rgb("on_surface")), ("@SIZES@", sizes),
                       ("@FRAMES@", str(PLYMOUTH_FRAMES)), ("@CELLS@", str(PLYMOUTH_CELLS))):
        script = script.replace(key, value)
    (staging / "acid-hud.script").write_text(script)
    shutil.copy(src / "acid-hud.plymouth", staging / "acid-hud.plymouth")
    shutil.rmtree(out, ignore_errors=True)
    staging.rename(out)
    print(f"plymouth: {len(heights)} sizes x {PLYMOUTH_FRAMES} emblem frames in {out}")


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--tint-only", action="store_true", help="skip cropping; recolour outputs only")
    ap.add_argument("--force", action="store_true", help="re-crop all elements")
    ap.add_argument("--if-changed", action="store_true",
                    help="do nothing when the palette and this script match the last build "
                         "(for Noctalia's palette hook, which also fires on every start)")
    ap.add_argument("--lock-layout", action="store_true",
                    help="print the [lockscreen_widgets] TOML for noctalia's themes/acid.toml and exit")
    ap.add_argument("--lock-sync", action="store_true",
                    help="set the lock and the bar up for a connected monitor that is new to the theme, "
                         "and rebuild the lock art after a wallpaper change")
    ap.add_argument("--shaders", action="store_true", help="compile the overlay shaders and exit")
    ap.add_argument("--plymouth", action="store_true",
                    help="render the boot splash theme and exit (hud-boot installs it)")
    args = ap.parse_args()
    if args.lock_layout:
        print(lock_layout_toml(), end="")
        return
    if args.shaders:
        build_shaders()
        return
    if args.plymouth:
        if shutil.which("magick") is None:
            sys.exit("hud-build: missing tools: magick (pacman -S imagemagick)")
        build_plymouth(load_colors())
        return

    require_tools()
    if not (SRC / "elements.toml").exists():
        sys.exit(f"hud-build: {SRC}/elements.toml missing (stow the hud package)")
    if not PACKS.is_dir():
        sys.exit(f"hud-build: asset packs not found at {PACKS}")

    # Palette hooks can fire twice in quick succession; serialise the runs.
    CACHE.mkdir(parents=True, exist_ok=True)
    lock = open(CACHE / "build.lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)

    colors = load_colors()
    if args.lock_sync:
        lock_sync(colors)
        return
    # The stamp covers the palette and this script, so editing the renderers
    # also invalidates it; a crop run (no --tint-only) always builds.
    stamp = CACHE / "build.stamp"
    key = json.dumps(colors, sort_keys=True) + f"\n{Path(__file__).stat().st_mtime_ns}\n"
    # (The bar icons are per output scale; the 1x set is always built.)
    outputs_present = (OUT / "bar/icons/1/vol.png").exists() and (OUT / "overlay").is_dir()
    if args.if_changed and outputs_present and stamp.exists() and stamp.read_text() == key:
        print("hud-build: palette unchanged, nothing to do")
        return
    stamp.unlink(missing_ok=True)
    if not args.tint_only:
        build_elements(load_manifest(), args.force)
    build_tinted(colors)
    build_overlay(colors)
    build_shaders()
    build_lock(colors)
    build_bar(colors)
    build_wallpapers(colors)
    build_extras(colors)
    reload_wallpapers()
    stamp.write_text(key)


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, FileNotFoundError) as e:
        sys.exit(f"hud-build: {e}")
