#!/usr/bin/env bash
# Build and install the ACID//HUD GRUB theme: the boot menu in the palette and
# the HUD's font, instead of GRUB's white-on-black (or starfield).
#
#   hud-grub            build, install to /boot/grub/themes, regenerate grub.cfg
#   hud-grub --build    build only, into ~/.local/share/hud/grub (no sudo)
#
# Everything is generated: the colours come from ~/.config/hud/colors.json
# (rendered by Noctalia from templates/hud-colors.json), the fonts are
# Departure Mono converted with grub-mkfont. Calls sudo itself. Run it again
# after a palette change to recolour the menu.
set -euo pipefail

readonly THEME=acid-hud
readonly SRC="${XDG_DATA_HOME:-$HOME/.local/share}/hud/grub/$THEME"
readonly DEST="/boot/grub/themes/$THEME"
readonly COLORS="${XDG_CONFIG_HOME:-$HOME/.config}/hud/colors.json"
readonly FONT_FILE="/usr/share/fonts/OTF/DepartureMono-Regular.otf"
readonly GRUB_D="/etc/default/grub.d/theme.cfg"

die() { echo "hud-grub: $*" >&2; exit 1; }

(( EUID != 0 )) || die "run as your user, it calls sudo itself"
for tool in grub-mkfont magick jq; do
  command -v "$tool" &>/dev/null || die "$tool is not installed"
done
[[ -f "$COLORS" ]] || die "$COLORS missing; run: noctalia msg templates-apply"
[[ -f "$FONT_FILE" ]] || die "$FONT_FILE missing (otf-departure-mono)"

color() { jq -er --arg k "$1" '.[$k]' "$COLORS"; }

build() {
  local primary surface raised text dim outline tertiary
  primary=$(color primary) surface=$(color surface) raised=$(color surface_variant)
  text=$(color on_surface) dim=$(color on_surface_variant) outline=$(color outline)
  tertiary=$(color tertiary)

  rm -rf "$SRC"
  mkdir -p "$SRC"

  # GRUB only draws bitmap fonts of its own format, one file per size. The
  # name a theme refers to is "<family> <style> <size>".
  local size
  for size in 16 20 36; do
    grub-mkfont --size="$size" --output="$SRC/departure-$size.pf2" "$FONT_FILE"
  done

  # The selected entry: a filled bar with an accent edge on its left. GRUB
  # stretches the centre slice and tiles the west one down the bar's height.
  magick -size 8x8 "xc:$raised" "$SRC/select_c.png"
  magick -size 4x8 "xc:$primary" "$SRC/select_w.png"
  # The rule under the title, stretched to the menu's width.
  magick -size 8x2 "xc:$outline" "$SRC/rule.png"

  cat >"$SRC/theme.txt" <<EOF
# ACID//HUD GRUB theme. Generated by hud-grub from the palette; do not edit.
title-text: ""
desktop-color: "$surface"
terminal-font: "Departure Mono Regular 16"
terminal-left: "12%"
terminal-top: "12%"
terminal-width: "76%"
terminal-height: "76%"
terminal-border: "0"

+ label {
  left = 12%
  top = 16%
  width = 76%
  text = "ACID//HUD"
  font = "Departure Mono Regular 36"
  color = "$primary"
}

+ label {
  left = 12%
  top = 16%+48
  width = 76%
  text = "SELECT BOOT TARGET"
  font = "Departure Mono Regular 16"
  color = "$dim"
}

+ image {
  left = 12%
  top = 16%+80
  width = 76%
  height = 2
  file = "rule.png"
}

+ boot_menu {
  left = 12%
  top = 16%+104
  width = 76%
  height = 50%
  item_font = "Departure Mono Regular 20"
  item_color = "$dim"
  selected_item_color = "$text"
  item_height = 40
  item_padding = 16
  item_spacing = 8
  icon_width = 0
  icon_height = 0
  item_icon_space = 0
  selected_item_pixmap_style = "select_*.png"
  scrollbar = false
}

+ label {
  id = "__timeout__"
  left = 12%
  top = 86%
  width = 76%
  text = "AUTO BOOT IN %d S"
  font = "Departure Mono Regular 16"
  color = "$tertiary"
}

+ label {
  left = 12%
  top = 86%+28
  width = 76%
  text = "ENTER BOOT   E EDIT   C CONSOLE"
  font = "Departure Mono Regular 16"
  color = "$outline"
}
EOF
  echo "Built $SRC"
}

install_theme() {
  [[ -d /boot/grub ]] || die "no /boot/grub: this machine does not boot with GRUB"
  sudo rm -rf "$DEST"
  sudo install -d "$DEST"
  sudo install -m644 "$SRC"/* "$DEST"/
  # GRUB_THEME only works in the graphical terminal, which is GRUB's default
  # unless GRUB_TERMINAL_OUTPUT=console is set in /etc/default/grub.
  printf '%s\n' "# Written by hud-grub: the ACID//HUD boot menu theme." \
    "GRUB_THEME=\"$DEST/theme.txt\"" | sudo tee "$GRUB_D" >/dev/null
  grep -qs '^GRUB_TERMINAL_OUTPUT=.*console' /etc/default/grub \
    && echo "  ⚠ /etc/default/grub sets GRUB_TERMINAL_OUTPUT=console: the theme will not show until that line is removed"
  sudo grub-mkconfig -o /boot/grub/grub.cfg
  echo "GRUB theme installed; it shows on the next boot (hold Esc if the menu is hidden)."
}

case "${1:-}" in
  "") build; install_theme ;;
  --build) build ;;
  -h | --help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown option: $1" ;;
esac
