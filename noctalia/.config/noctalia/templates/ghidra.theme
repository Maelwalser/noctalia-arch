name = Noctalia
lookAndFeel = Flat Dark
useDarkDefaults = true
// Generated by Noctalia from templates/ghidra.theme. Do not edit the output.
// Ghidra's Flat Dark theme with the palette laid over it. Pick it once under
// Edit > Theme > Switch...; after that a palette change shows on the next start.
//
// The system.color ids are the look and feel's own colours (panels, views,
// selections); every Swing widget hangs off one of them.
[color]system.color.bg.control = {{colors.surface_container_low.default.hex}}
[color]system.color.bg.view = {{colors.surface.default.hex}}
[color]system.color.bg.tooltip = {{colors.surface_container_high.default.hex}}
[color]system.color.bg.selected.view = {{colors.primary.default.hex | set_lightness 27}}
[color]system.color.bg.border = {{colors.surface_container_low.default.hex}}
[color]system.color.fg.control = {{colors.on_surface.default.hex}}
[color]system.color.fg.view = {{colors.on_surface.default.hex}}
[color]system.color.fg.tooltip = {{colors.on_surface.default.hex}}
[color]system.color.fg.selected.view = {{colors.on_surface.default.hex}}
[color]system.color.fg.disabled = {{colors.outline.default.hex}}
// Flat Dark paints its panels with what Ghidra calls the border colour, hence
// the panel colour on that id above. What Ghidra groups under none of the ids
// keeps Flat Dark's grey unless it is named here.
[color]laf.color.MenuBar.background = {{colors.surface_container_low.default.hex}}
[color]laf.color.ToolBar.background = {{colors.surface_container_low.default.hex}}
[color]laf.color.PopupMenu.background = {{colors.surface_container_high.default.hex}}
[color]laf.color.MenuItem.selectionBackground = {{colors.primary.default.hex | set_lightness 27}}
[color]laf.color.Menu.selectionBackground = {{colors.primary.default.hex | set_lightness 27}}
[color]laf.color.MenuBar.hoverBackground = {{colors.surface_variant.default.hex}}
[color]laf.color.Button.background = {{colors.surface_variant.default.hex}}
[color]laf.color.Button.hoverBackground = {{colors.surface_container_highest.default.hex}}
[color]laf.color.Button.borderColor = {{colors.outline_variant.default.hex}}
[color]laf.color.Component.borderColor = {{colors.outline_variant.default.hex}}
[color]laf.color.Component.focusedBorderColor = {{colors.primary.default.hex}}
[color]laf.color.Component.focusColor = {{colors.primary.default.hex | set_lightness 32}}
[color]laf.color.Separator.foreground = {{colors.outline_variant.default.hex}}
[color]laf.color.TableHeader.background = {{colors.surface_variant.default.hex}}
[color]laf.color.TableHeader.separatorColor = {{colors.outline_variant.default.hex}}
[color]laf.color.ScrollBar.track = {{colors.surface.default.hex}}
[color]laf.color.ScrollBar.thumb = {{colors.outline_variant.default.hex}}
[color]laf.color.ScrollBar.hoverThumbColor = {{colors.outline.default.hex}}
[color]laf.color.ProgressBar.foreground = {{colors.primary.default.hex}}
[color]laf.color.ProgressBar.background = {{colors.surface_variant.default.hex}}
[color]laf.color.TabbedPane.underlineColor = {{colors.primary.default.hex}}
[color]laf.color.TabbedPane.focusColor = {{colors.surface_variant.default.hex}}
[color]laf.color.TabbedPane.hoverColor = {{colors.surface_variant.default.hex}}
[color]laf.color.ComboBox.buttonBackground = {{colors.surface_variant.default.hex}}
[color]laf.color.CheckBox.icon.checkmarkColor = {{colors.primary.default.hex}}
[color]laf.color.CheckBox.icon.borderColor = {{colors.outline.default.hex}}
[color]laf.color.CheckBox.icon.background = {{colors.surface.default.hex}}
color.bg.widget.tabs.selected.active = {{colors.primary.default.hex | set_lightness 27}}
color.bg.widget.tabs.selected.inactive = {{colors.surface_variant.default.hex}}
color.bg.widget.tabs.unselected = {{colors.surface_container_low.default.hex}}
// Ghidra's own colours are named after web colours and nearly everything in
// the listing, the decompiler and the graphs points at one of these names. In
// a dark theme the "light" names are backgrounds, so they stay dark here.
color.palette.black = {{colors.on_surface_variant.default.hex}}
color.palette.darkgray = {{colors.outline.default.hex}}
color.palette.gray = {{colors.outline.default.hex}}
color.palette.lightgray = {{colors.outline_variant.default.hex}}
color.palette.silver = {{colors.surface_variant.default.hex}}
color.palette.aliceblue = {{colors.surface_container_low.default.hex}}
color.palette.hint = {{colors.outline.default.hex}}
color.palette.error = {{colors.error.default.hex}}
color.palette.red = {{colors.error.default.hex}}
color.palette.crimson = {{colors.terminal_bright_red.default.hex}}
color.palette.maroon = {{colors.terminal_bright_red.default.hex}}
color.palette.darkred = {{colors.terminal_normal_red.default.hex}}
color.palette.orange = {{colors.tertiary.default.hex}}
color.palette.darkorange = {{colors.tertiary.default.hex}}
color.palette.yellow = {{colors.terminal_bright_yellow.default.hex}}
color.palette.green = {{colors.terminal_normal_green.default.hex}}
color.palette.darkgreen = {{colors.terminal_normal_green.default.hex}}
color.palette.lime = {{colors.terminal_bright_green.default.hex}}
color.palette.teal = {{colors.terminal_normal_cyan.default.hex}}
color.palette.cyan = {{colors.terminal_bright_cyan.default.hex}}
color.palette.blue = {{colors.terminal_bright_blue.default.hex}}
color.palette.navy = {{colors.terminal_bright_blue.default.hex}}
color.palette.purple = {{colors.secondary.default.hex}}
color.palette.blueviolet = {{colors.secondary.default.hex}}
color.palette.indigo = {{colors.secondary.default.hex}}
color.palette.magenta = {{colors.primary.default.hex}}
color.palette.fuchsia = {{colors.primary.default.hex}}
color.palette.pink = {{colors.secondary.default.hex}}
color.palette.cornflowerblue = {{colors.primary.default.hex | set_lightness 32}}
color.palette.lightcornflowerblue = {{colors.primary.default.hex | set_lightness 40}}
color.palette.lightsteelblue = {{colors.primary.default.hex | set_lightness 18}}
color.palette.lightskyblue = {{colors.terminal_normal_blue.default.hex | set_lightness 22}}
color.palette.palegreen = {{colors.primary.default.hex | set_lightness 22}}
color.palette.lightgreen = {{colors.terminal_normal_green.default.hex | set_lightness 18}}
color.palette.lightcoral = {{colors.error.default.hex | set_lightness 22}}
color.palette.lavender = {{colors.secondary.default.hex | set_lightness 24}}
// Where the caret and the current line are.
color.cursor.focused = {{colors.primary.default.hex}}
color.cursor.unfocused = {{colors.outline.default.hex}}
color.bg.currentline = {{colors.surface_variant.default.hex}}
color.bg.highlight = {{colors.tertiary.default.hex | set_lightness 20}}
color.bg.find.highlight = {{colors.tertiary.default.hex | set_lightness 26}}
color.bg.find.highlight.active = {{colors.tertiary.default.hex | set_lightness 38}}
color.bg.filterfield = {{colors.tertiary.default.hex | set_lightness 20}}
color.fg.filterfield = {{colors.on_surface.default.hex}}
color.fg.header.inactive = {{colors.on_surface_variant.default.hex}}
color.bg.header.inactive = {{colors.surface_variant.default.hex}}
