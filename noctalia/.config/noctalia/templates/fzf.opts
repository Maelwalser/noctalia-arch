# Generated by Noctalia from templates/fzf.opts. Do not edit the output.
# zsh sets FZF_DEFAULT_OPTS_FILE to this file; fzf reads it on every run.
--color=fg:{{colors.on_surface_variant.default.hex}},fg+:{{colors.on_surface.default.hex}},bg:-1,bg+:{{colors.primary.default.hex | set_lightness 24}},gutter:-1
--color=hl:{{colors.tertiary.default.hex}},hl+:{{colors.tertiary.default.hex}},query:{{colors.on_surface.default.hex}}
--color=prompt:{{colors.primary.default.hex}},pointer:{{colors.primary.default.hex}},marker:{{colors.primary.default.hex}},spinner:{{colors.primary.default.hex}}
--color=border:{{colors.terminal_normal_blue.default.hex}},separator:{{colors.outline.default.hex}},scrollbar:{{colors.outline.default.hex}},label:{{colors.terminal_normal_blue.default.hex}}
--color=info:{{colors.terminal_bright_black.default.hex}},header:{{colors.terminal_normal_blue.default.hex}}
