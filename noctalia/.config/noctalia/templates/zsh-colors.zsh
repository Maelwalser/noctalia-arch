# Generated by Noctalia from templates/zsh-colors.zsh. Do not edit the output.
# ~/.zshrc sources this after oh-my-zsh. It puts the palette on the parts of
# the shell that would otherwise keep oh-my-zsh's and zsh's defaults:
#   - LS_COLORS, for GNU ls (`command ls`), tree, fd and the completion list
#   - the completion menu: selected entry, group headings, "no matches"
#   - zsh-syntax-highlighting, the colours of the command line as it is typed
#   - the 16 colours of the Linux console (a TTY outside Hyprland)

() {
  # Noctalia hands colours over as "r, g, b"; SGR sequences want "r;g;b".
  local -A c=(
    fg        "{{colors.on_surface.default.rgb_csv}}"
    dim       "{{colors.on_surface_variant.default.rgb_csv}}"
    faint     "{{colors.terminal_bright_black.default.rgb_csv}}"
    primary   "{{colors.primary.default.rgb_csv}}"
    secondary "{{colors.secondary.default.rgb_csv}}"
    tertiary  "{{colors.tertiary.default.rgb_csv}}"
    red       "{{colors.terminal_normal_red.default.rgb_csv}}"
    green     "{{colors.terminal_normal_green.default.rgb_csv}}"
    yellow    "{{colors.terminal_bright_yellow.default.rgb_csv}}"
    blue      "{{colors.terminal_bright_blue.default.rgb_csv}}"
    cyan      "{{colors.terminal_bright_cyan.default.rgb_csv}}"
    select    "{{colors.primary.default.rgb_csv | set_lightness 24}}"
  )
  local k
  for k in ${(k)c}; do c[$k]="38;2;${${c[$k]// /}//,/;}"; done
  local select_bg="48${c[select]#38}"

  # ── LS_COLORS ─────────────────────────────────────────────────────────────
  # File kinds as in the eza theme: directories in the primary, links cyan,
  # executables in the tertiary. Then the extensions worth telling apart at a
  # glance: archives, pictures and video, audio, and what can be ignored.
  local -a ls=(
    "rs=0" "no=0" "fi=0"
    "di=1;${c[primary]}" "ln=${c[cyan]}" "mh=0" "ex=1;${c[tertiary]}"
    "pi=${c[yellow]}" "so=1;${c[secondary]}" "do=1;${c[secondary]}"
    "bd=1;${c[tertiary]}" "cd=1;${c[tertiary]}"
    "or=${c[red]}" "mi=${c[red]}"
    "su=1;${c[red]}" "sg=1;${c[yellow]}" "ca=${c[red]}"
    "tw=1;4;${c[primary]}" "ow=4;${c[primary]}" "st=1;${c[blue]}"
  )
  local ext
  for ext in tar tgz gz bz2 xz zst zip 7z rar deb rpm jar iso img; do ls+=("*.$ext=${c[red]}"); done
  for ext in png jpg jpeg gif webp svg bmp ico tiff avif heic mp4 mkv webm mov avi; do ls+=("*.$ext=${c[secondary]}"); done
  for ext in mp3 flac ogg opus wav m4a aac; do ls+=("*.$ext=${c[green]}"); done
  for ext in bak tmp swp orig log lock pyc o; do ls+=("*.$ext=${c[faint]}"); done
  ls+=("*~=${c[faint]}")
  export LS_COLORS="${(j.:.)ls}"

  # ── Completion menu ───────────────────────────────────────────────────────
  # oh-my-zsh expanded the old LS_COLORS into this style when it loaded, so it
  # is set again. `ma` is the entry under the cursor in the menu.
  zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" "ma=1;${select_bg};${c[fg]}"
  zstyle ':completion:*' group-name ''
  zstyle ':completion:*:descriptions' format $'\e['"${c[primary]}"$'m── %d ──\e[0m'
  zstyle ':completion:*:messages' format $'\e['"${c[dim]}"$'m%d\e[0m'
  zstyle ':completion:*:warnings' format $'\e['"${c[red]}"$'mno matches: %d\e[0m'
}

# ── Command line (zsh-syntax-highlighting) ──────────────────────────────────
# What runs is in the primary, what would fail is red, what is quoted is cyan,
# paths are underlined so a typo in one shows before Enter does.
if (( ${+ZSH_HIGHLIGHT_STYLES} )); then
  () {
    local primary="fg={{colors.primary.default.hex}}" secondary="fg={{colors.secondary.default.hex}}"
    local tertiary="fg={{colors.tertiary.default.hex}}" dim="fg={{colors.on_surface_variant.default.hex}}"
    local faint="fg={{colors.terminal_bright_black.default.hex}}" error="fg={{colors.error.default.hex}}"
    local cyan="fg={{colors.terminal_bright_cyan.default.hex}}" blue="fg={{colors.terminal_bright_blue.default.hex}}"
    local yellow="fg={{colors.terminal_bright_yellow.default.hex}}"
    local k
    for k in command builtin alias global-alias function hashed-command arg0; do
      ZSH_HIGHLIGHT_STYLES[$k]=$primary
    done
    ZSH_HIGHLIGHT_STYLES[suffix-alias]="$primary,underline"
    ZSH_HIGHLIGHT_STYLES[autodirectory]="$primary,underline"
    ZSH_HIGHLIGHT_STYLES[precommand]="$secondary,bold"
    ZSH_HIGHLIGHT_STYLES[reserved-word]=$secondary
    ZSH_HIGHLIGHT_STYLES[unknown-token]=$error
    ZSH_HIGHLIGHT_STYLES[path]=underline
    ZSH_HIGHLIGHT_STYLES[path_prefix]=underline
    ZSH_HIGHLIGHT_STYLES[globbing]=$tertiary
    ZSH_HIGHLIGHT_STYLES[history-expansion]=$tertiary
    ZSH_HIGHLIGHT_STYLES[redirection]=$tertiary
    ZSH_HIGHLIGHT_STYLES[commandseparator]=$dim
    ZSH_HIGHLIGHT_STYLES[single-hyphen-option]=$dim
    ZSH_HIGHLIGHT_STYLES[double-hyphen-option]=$dim
    for k in single-quoted-argument double-quoted-argument dollar-quoted-argument; do
      ZSH_HIGHLIGHT_STYLES[$k]=$cyan
    done
    for k in single-quoted-argument-unclosed double-quoted-argument-unclosed \
      dollar-quoted-argument-unclosed back-quoted-argument-unclosed; do
      ZSH_HIGHLIGHT_STYLES[$k]="$error"
    done
    for k in dollar-double-quoted-argument back-double-quoted-argument back-dollar-quoted-argument; do
      ZSH_HIGHLIGHT_STYLES[$k]=$yellow
    done
    for k in command-substitution-delimiter process-substitution-delimiter \
      arithmetic-expansion back-quoted-argument-delimiter; do
      ZSH_HIGHLIGHT_STYLES[$k]=$tertiary
    done
    ZSH_HIGHLIGHT_STYLES[assign]=$blue
    ZSH_HIGHLIGHT_STYLES[named-fd]=$blue
    ZSH_HIGHLIGHT_STYLES[numeric-fd]=$blue
    ZSH_HIGHLIGHT_STYLES[comment]=$faint
  }
fi

# ── Linux console ────────────────────────────────────────────────────────────
# A TTY has 16 colours and no theme of its own. Slot 0 is also what the console
# paints its background with, so it takes the terminal background, not black.
if [[ $TERM == linux ]]; then
  printf '\e]P%s' \
    0{{colors.terminal_background.default.hex_stripped}} 1{{colors.terminal_normal_red.default.hex_stripped}} \
    2{{colors.terminal_normal_green.default.hex_stripped}} 3{{colors.terminal_normal_yellow.default.hex_stripped}} \
    4{{colors.terminal_normal_blue.default.hex_stripped}} 5{{colors.terminal_normal_magenta.default.hex_stripped}} \
    6{{colors.terminal_normal_cyan.default.hex_stripped}} 7{{colors.terminal_foreground.default.hex_stripped}} \
    8{{colors.terminal_bright_black.default.hex_stripped}} 9{{colors.terminal_bright_red.default.hex_stripped}} \
    A{{colors.terminal_bright_green.default.hex_stripped}} B{{colors.terminal_bright_yellow.default.hex_stripped}} \
    C{{colors.terminal_bright_blue.default.hex_stripped}} D{{colors.terminal_bright_magenta.default.hex_stripped}} \
    E{{colors.terminal_bright_cyan.default.hex_stripped}} F{{colors.terminal_bright_white.default.hex_stripped}}
fi
