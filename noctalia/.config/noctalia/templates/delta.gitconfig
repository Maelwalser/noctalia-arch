# Generated by Noctalia from templates/delta.gitconfig. Do not edit the output.
# ~/.gitconfig includes this file and selects the feature.
[delta "noctalia"]
	dark = true
	# The terminal's own 16 colours, which Noctalia already sets from the palette.
	syntax-theme = ansi
	file-style = "{{colors.primary.default.hex}}" bold
	file-decoration-style = "{{colors.outline.default.hex}}" ul
	hunk-header-style = syntax
	hunk-header-file-style = "{{colors.on_surface_variant.default.hex}}"
	hunk-header-line-number-style = "{{colors.tertiary.default.hex}}"
	hunk-header-decoration-style = "{{colors.terminal_normal_blue.default.hex}}" box
	line-numbers-left-style = "{{colors.outline.default.hex}}"
	line-numbers-right-style = "{{colors.outline.default.hex}}"
	line-numbers-zero-style = "{{colors.terminal_bright_black.default.hex}}"
	line-numbers-minus-style = "{{colors.error.default.hex}}"
	line-numbers-plus-style = "{{colors.terminal_normal_green.default.hex}}"
	minus-style = syntax "{{colors.error.default.hex | set_lightness 11}}"
	minus-emph-style = syntax "{{colors.error.default.hex | set_lightness 24}}"
	plus-style = syntax "{{colors.terminal_normal_green.default.hex | set_lightness 11}}"
	plus-emph-style = syntax "{{colors.terminal_normal_green.default.hex | set_lightness 22}}"
	blame-palette = "{{colors.surface.default.hex}}" "{{colors.surface_variant.default.hex}}"
