*.bak*
omarchy/.config/omarchy/themes/happy-time/backgrounds

# Claude Code: per-directory instructions and local settings
CLAUDE.md
.claude/

# Editor swap/backup files
*.swp
*.swo
*~
.*.un~
Session.vim

# OS / tooling junk
.DS_Store
*.log
__pycache__/
*.pyc
node_modules/

# Secrets and runtime state that must never be committed
.env
.env.*
*.pem
*.key
gnupg/.gnupg/
.gnupg/
*.gpg
.zsh_history
.zcompdump*

# Generated by Noctalia's colour templates. On a fresh install stow links these
# whole directories into the repo, so the generated files would land here.
hyprland/.config/hypr/noctalia.lua
ghostty/.config/ghostty/themes/
gtk/.config/gtk-3.0/noctalia.css
gtk/.config/gtk-4.0/noctalia.css
qt6ct/.config/qt6ct/colors/
btop/.config/btop/themes/

# Active-theme links made by `dotfiles-theme` (theme/.local/bin): they point at
# the committed variants and differ per machine. Folded stow dirs put some of
# them inside this repo.
noctalia/.config/noctalia/theme.toml
ghostty/.config/ghostty/theme.conf
tmux/.config/tmux/theme.conf
tmux/.config/tmux/noctalia.conf
sioyek/.config/sioyek/prefs_user.config
eza/.config/eza/theme.yml
vivaldi/theme.css

# Claude Code: keybindings, the ACID//HUD theme and the status line are stowed
# from the claude package. Only those are tracked: everything else in ~/.claude
# is runtime state or secrets.
!claude/.claude/
claude/.claude/*
!claude/.claude/keybindings.json
!claude/.claude/statusline-command.sh
!claude/.claude/themes/

# ACID//HUD: everything `hud-build` renders is derived from licensed stock art
# (~/Pictures/ricing) and must stay out of this public repo. Allowlist only the
# source file types, so no export format (png, svg, gif, jpg, pdf, ...) can slip in,
# even if stow folds ~/.local/share into the package.
hud/**
!hud/**/
!hud/.local/bin/hud-*
hud/.local/bin/*.*
!hud/.local/share/hud-src/elements.toml
!hud/.local/share/hud-src/noctalia-plugins/**/*.luau
!hud/.local/share/hud-src/noctalia-plugins/**/plugin.toml
!hud/.local/share/hud-src/noctalia-plugins/**/translations/*.json
quickshell/**
!quickshell/**/
!quickshell/**/*.qml
!quickshell/**/*.frag
!quickshell/**/qmldir
