[user]
	email = maelwalser04@gmail.com
	name = mael
[safe]
	directory = /usr/share/exploitdb
	directory = /usr/share/exploitdb-papers
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	features = noctalia
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
# Colours for delta, rendered by Noctalia (templates/delta.gitconfig).
[include]
	path = ~/.config/git/noctalia-delta.gitconfig
